{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "url": [
        "http://localhost/",
        "http://localhost/fees/",
        "http://localhost/contact/",
        "http://localhost/zh-hant/",
        "http://localhost/ja/",
        "http://localhost/ko/fees/",
        "http://localhost/en/treatments/ivf/",
        "http://localhost/de/guides/travel-checklist/"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 150 }],
        "speed-index": ["warn", { "maxNumericValue": 3400 }],
        "resource-summary:font:size": ["warn", { "maxNumericValue": 175000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 650000 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./reports/lighthouse" }
  }
}
