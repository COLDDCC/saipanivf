---
import HomeDecisions from "../components/HomeDecisions.astro";
import HomeBirthLink from "../components/HomeBirthLink.astro";
import HomeClientCount from "../components/HomeClientCount.astro";
import { team as people } from "../data/team";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroCarousel from "../components/HeroCarousel.astro";
import { faqs } from "../data/faq";
const asset=(name)=>`/images/stock/${name}.webp`;
const projects=[
 {title:'试管婴儿 IVF / ICSI',label:'辅助生殖',text:'从初诊评估、促排取卵到胚胎培养，了解治疗环节与受精方式。',href:'/treatments/ivf/',image:'microscope-white',alt:'实验室显微镜'},
 {title:'冻卵与生育力保存',label:'生育力保存',text:'分清取卵冷冻、保存续费和未来使用，提前整理咨询问题。',href:'/treatments/egg-freezing/',image:'ultrasound-probe',alt:'超声探头'},
 {title:'冻胚移植 FET',label:'冷冻胚胎移植',text:'已有冷冻胚胎时，了解移植前准备、解冻、用药与复查。',href:'/treatments/frozen-embryo-transfer/',image:'parent-hands',alt:'双手捧着童鞋'}
];
const guides=[
 {slug:'first-visit',title:'首次咨询，要准备哪些资料？',text:'已有报告怎么整理，没有检查报告如何开始。',image:'notebook-wood',tag:'初诊准备'},
 {slug:'ivf-steps',title:'一个IVF周期，有哪些环节？',text:'检查、促排、取卵、培养和移植，按阶段了解。',image:'microscope-focus',tag:'治疗流程'},
 {slug:'quotation',title:'怎么看懂一份IVF报价？',text:'基础价包含什么，哪些操作和生活支出要另算。',image:'budget-documents',tag:'费用说明'},
 {slug:'egg-freezing',title:'冻卵初诊，要准备什么？',text:'整理已有报告、可就诊时间与保存事项。',image:'fern-light',tag:'生育力保存'},
 {slug:'travel-checklist',title:'跨境就诊，如何安排行程？',text:'预约确认、交通住宿和返程随访的准备清单。',image:'wing-clouds',tag:'就诊安排'},
 {slug:'family-planning',title:'家庭生育计划，先问哪些问题？',text:'医疗条件、可用资源、费用与文件逐项确认。',image:'baby-shoes',tag:'家庭计划'}
];
---
<SiteLayout title="塞班试管婴儿、冻卵与辅助生殖咨询" description="了解塞班IVF、ICSI、生育力保存、医疗团队、费用预算和就诊流程。按项目查资料，准备首次咨询。" home={true}>
<section class="hero"><HeroCarousel /></section>
<HomeDecisions/>

<section class="section wrap home-budget"><div class="budget-photo"><ResponsiveImage src={asset('calculator-open')} alt="计算器、笔记本与钢笔" width="640" height="480" loading="lazy"/></div><div><h2>IVF费用，逐项了解</h2><p>取卵与培养、药物、麻醉、ICSI、冷冻与移植可能分别计费。使用预算工具，再向院方核对包含项目和书面报价。</p><a class="button" href="/fees/">查看费用与预算工具</a><a class="inline-link budget-guide" href="/guides/quotation/">先读报价核对指南</a></div></section>
<section class="section wrap home-section"><div class="section-head"><div><h2>治疗项目</h2><p class="section-intro">了解项目，再与医生讨论适合自己的方案。</p></div><a class="inline-link" href="/treatments/">全部治疗项目</a></div><div class="photo-cards">{projects.map(item=><a class="photo-card" href={item.href}><div class="image-frame"><ResponsiveImage src={asset(item.image)} alt={item.alt} width="640" height="420" loading="lazy"/></div><div class="card-copy"><h3>{item.title}</h3><p>{item.text}</p><span class="read-more">了解项目</span></div></a>)}</div></section>
<section class="home-center soft"><div class="section wrap"><div class="center-layout"><figure class="center-photo"><ResponsiveImage src="/images/official/center.webp" alt="院方官网展示的Bank of Guam楼宇外观" width="870" height="550" loading="lazy"/><figcaption>院方官网公开图片 · Bank of Guam楼宇外观</figcaption></figure><div class="center-copy"><h2>在塞班，了解接诊机构</h2><p>院方公开地址位于塞班Garapan的Bank of Guam楼宇三层。预约前，确认具体接诊地点、主诊医生与到院时间。</p><dl class="address-facts"><div><dt>地址</dt><dd>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</dd></div><div><dt>咨询</dt><dd><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></dd></div></dl><a class="button" href="/about/">了解塞班生殖中心</a></div></div></div></section>
<section class="section wrap home-section"><div class="section-head"><div><h2>医疗与护理团队</h2><p class="section-intro">照片与职务参考院方公开介绍，实际接诊与排班以预约确认为准。</p></div><a class="inline-link" href="/team/">查看团队与实验室</a></div><div class="people-grid">{people.map(person=><a class="person-card" href={`/team/#${person.id}`}><div class="portrait"><ResponsiveImage src={`/images/official/${person.image}.webp`} alt={person.name+'，院方公开团队照片'} width={person.image==='gary'?480:250} height={person.image==='gary'?720:347} loading="lazy"/></div><div class="person-copy"><span class="category">{person.role}</span><h3>{person.name}</h3><p>{person.summary}</p><span class="read-more">查看团队介绍</span></div></a>)}</div><p class="photo-source">团队与楼宇图片来源：<a href="https://www.saipan-ivf.com/Resources/" target="_blank" rel="noopener">接诊机构官网</a>。</p></section>

<HomeClientCount/>
<section class="visit-finder wrap" aria-label="查找就诊信息"><h2>你想先了解什么？</h2><form action="/treatments/" id="visit-finder"><label for="visit-topic">选择关注的方向</label><select id="visit-topic" name="topic"><option value="/treatments/">试管婴儿与ICSI</option><option value="/guides/egg-freezing/">冻卵与生育力保存</option><option value="/fees/">治疗费用与预算</option><option value="/process/">就诊流程与时间</option><option value="/birth-planning/">塞班分娩与子女身份</option></select><button class="button" type="submit">查看相关资料</button></form><noscript><a href="/guides/">查看全部就诊指南</a></noscript></section>
<section class="journey-panel"><div class="section wrap"><div class="section-head"><div><h2>IVF就诊安排</h2></div><a class="inline-link" href="/process/">完整IVF流程</a></div><div class="visit-grid"><a href="/guides/first-visit/" class="visit-card"><ResponsiveImage src={asset('stethoscope-white')} alt="听诊器" width="640" height="420" loading="lazy"/><div><span>咨询与评估</span><h3>先整理报告，确认初诊</h3><p>询问初诊方式、医生需要的资料与咨询费用。</p></div></a><a href="/guides/travel-checklist/" class="visit-card"><ResponsiveImage src={asset('luggage-packed')} alt="旅行前整理好的行李箱" width="640" height="420" loading="lazy"/><div><span>行程与住宿</span><h3>按医生日程预订行程</h3><p>结合到院时间安排交通、住宿、陪同与退改。</p></div></a><a href="/process/" class="visit-card"><ResponsiveImage src={asset('calendar-open')} alt="日程本与钢笔" width="640" height="420" loading="lazy"/><div><span>治疗与随访</span><h3>确认复查与返程安排</h3><p>离院前核对用药、复查日期和联系渠道。</p></div></a></div></div></section>
<section class="soft"><div class="section wrap home-section"><div class="section-head"><div><h2>就诊指南</h2></div><a class="inline-link" href="/guides/">全部就诊指南</a></div><div class="guide-grid">{guides.map(guide=><a class="guide-card" href={`/guides/${guide.slug}/`}><ResponsiveImage src={asset(guide.image)} alt={{'notebook-wood':'木桌上的笔记本','microscope-focus':'实验室显微镜近景','budget-documents':'费用记录与文件','fern-light':'自然光下的蕨类植物','wing-clouds':'飞机舷窗外的机翼与云层','baby-shoes':'婴儿鞋'}[guide.image]} width="640" height="400" loading="lazy"/><div class="guide-copy"><h3>{guide.title}</h3><p>{guide.text}</p><span class="read-more">阅读全文</span></div></a>)}</div></div></section>
<section class="section wrap home-faq"><div class="section-head"><div><h2>常见问题</h2><p class="section-intro">费用、治疗时间与初诊准备，先看你最关心的问题。</p></div><a class="inline-link" href="/faq/">全部问题与资料来源</a></div><div class="faq">{[6,8,10,11].map(index=><details><summary>{faqs[index].question}</summary><p><strong>{faqs[index].answer}</strong></p><a class="inline-link" href={`/faq/#${faqs[index].id}`}>查看依据与完整说明</a></details>)}</div></section>
<HomeBirthLink/>
<script>
const finder=document.querySelector<HTMLFormElement>('#visit-finder');finder?.addEventListener('submit',event=>{event.preventDefault();const select=document.querySelector<HTMLSelectElement>('#visit-topic');if(select)window.location.assign(select.value)});
</script></SiteLayout>
