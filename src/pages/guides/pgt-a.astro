---
import SiteLayout from "../../layouts/SiteLayout.astro";
import SourceNote from "../../components/SourceNote.astro";
import {pricing} from "../../data/pricing";
import RatingGrid from "../../components/guide/RatingGrid.astro";
import RangeBars from "../../components/guide/RangeBars.astro";
import StepFlow from "../../components/guide/StepFlow.astro";
import Illustration from "../../components/guide/Illustration.astro";
const p=(id:string)=>pricing.find(x=>x.id===id)!;
const pgt=p('pgt'),freeze=p('freeze'),storage=p('storage'),fet=p('fet');
const num=(n:number)=>n.toLocaleString('en-US');
const range=(x:{min:number,max:number})=>x.min===x.max?num(x.min):num(x.min)+'–'+num(x.max);
const linkedLow=pgt.min+freeze.min+storage.min+fet.min,linkedHigh=pgt.max+freeze.max+storage.max+fet.max;
const checked="2026-10-29";
const title="PGT-A 要不要做？三代试管胚胎筛查的证据与费用";
const description="PGT-A 不是每个人都需要的检查。看懂它能做到什么、做不到什么，哪些情况值得和医生讨论，以及在塞班做 PGT-A 带来的额外费用和往返安排。";
const asrm="https://www.asrm.org/practice-guidance/practice-committee-documents/the-use-of-preimplantation-genetic-testing-for-aneuploidy-a-committee-opinion-2024/";
const hfea="https://www.hfea.gov.uk/treatments/treatment-add-ons/pre-implantation-genetic-testing-for-aneuploidy-pgt-a/";
const hfeaM="https://www.hfea.gov.uk/treatments/embryo-testing-and-treatments-for-disease/pre-implantation-genetic-testing-for-monogenic-disorders-pgt-m-and-pre-implantation-genetic-testing-for-chromosomal-structural-rearrangements-pgt-sr/";
const eshre="https://doi.org/10.1093/humrep/dead184";
const acog="https://www.acog.org/clinical/clinical-guidance/committee-opinion/articles/2020/03/preimplantation-genetic-testing";
const types=[
 ["PGT-A","胚胎染色体数目是否异常（非整倍体）","没有已知遗传病风险、希望在移植前筛选胚胎的人","ASRM、ESHRE 均不推荐作为所有 IVF 患者的常规检查"],
 ["PGT-M","某一种已知的单基因遗传病","家族中有明确的严重遗传病，且致病基因已知","用于避免把特定疾病遗传给孩子"],
 ["PGT-SR","染色体结构重排（如易位、倒位）","夫妻一方已确诊染色体结构重排","用于提高健康妊娠的机会"]
];
const ratings=[
 {outcome:"活产机会",group:"大多数患者 · HFEA",rating:"red",verdict:"未显示有效",note:"没有证据表明能提高生下宝宝的机会，而且常常让可移植的胚胎变少。"},
 {outcome:"流产风险",group:"大多数患者 · HFEA",rating:"green",verdict:"有高质量证据",note:"可以降低流产风险，但不能消除。"},
 {outcome:"活产与流产",group:"年龄较大的女性 · HFEA",rating:"grey",verdict:"证据不足",note:"现有中高质量证据不足以下结论。"},
 {outcome:"反复流产",group:"有多次流产史 · ASRM 2024",rating:"grey",verdict:"缺乏明确获益证据",note:"回顾性数据中活产率较高，但证据不足以证明获益。"}
] as const;
const costBars=[
 {label:"PGT-A 检测",min:pgt.min,max:pgt.max,emphasis:true,note:"按胚胎数或周期计费需确认"},
 {label:"胚胎冷冻操作",min:freeze.min},
 {label:"首年冷冻保存",min:storage.min},
 {label:"冻胚移植 FET",min:fet.min,note:"移植用药另计"},
 {label:"再次往返机票（1 人）",min:450,max:1000,note:"冻卵费用指南 2026-10-26 比价区间"}
];
const steps=[
 {icon:"outline-microscope",title:"取卵与培养",text:"胚胎需培养到囊胚阶段才能活检，并非每个胚胎都能走到这一步。"},
 {icon:"outline-test-tubes",title:"活检并冷冻",text:"取出少量滋养层细胞送检，胚胎冷冻保存。"},
 {icon:"outline-dna",title:"等待结果",text:"出结果的时间由检测实验室决定，签约前问清。"},
 {icon:"outline-lab-search",title:"解读报告",text:"和医生或遗传咨询师确认哪些胚胎可以移植。"},
 {icon:"outline-small-plane",title:"冻胚移植",text:"另约移植周期，可能需要再次来塞班。"}
];
const situations=[
 ["年龄较轻，预计囊胚不多","检测是否会让本来就少的可移植胚胎更少，是否值得为此付费。","HFEA 指出 PGT-A 常减少可供移植的胚胎。"],
 ["年龄较大，囊胚数量较多","能否减少流产、缩短达到妊娠所需的移植次数。","ASRM 认为可能有益，尤其卵巢储备较好时，但尚未在按意向治疗分析的试验中证实。"],
 ["有过多次流产","PGT-A 在你的整体评估中起什么作用，还需要哪些其他检查。","ASRM：目前缺乏明确获益的证据。"],
 ["家族有遗传病，或已知染色体结构异常","应讨论 PGT-M 或 PGT-SR，而不是只做 PGT-A。","两者检测目标不同，需要事先确认致病变异或重排类型。"],
 ["跨境就诊，希望减少往返","做 PGT-A 意味着先冷冻、等结果，再另约冻胚移植，可能多一次行程。","ASRM：多数检测正常的囊胚是在冷冻周期中移植。"]
];
const results=[
 ["整倍体（未见数目异常）","通常优先考虑移植，但不代表一定怀孕，也不能保证孩子健康。"],
 ["非整倍体（数目异常）","通常不移植。签约前问清这类胚胎的保存、处置流程，以及你的决定权。"],
 ["嵌合（正常与异常细胞并存）","着床机会可能较低，但已有健康活产的报道；各诊所的报告与移植做法不同。"],
 ["无结果","文献报告约 0.86%–3.8% 的活检会出现无法判读的结果；再次检测需要复苏、再活检和再冷冻。"]
];
const faq=[
 ["三代试管就是 PGT-A 吗？","中文里“三代试管”常泛指胚胎植入前遗传学检测，包括 PGT-A、PGT-M 和 PGT-SR。三者目的不同，报价和知情同意书上应写明具体做哪一种。"],
 ["35 岁以上一定要做 PGT-A 吗？","没有这样的统一要求。ASRM 认为它对年龄较大、卵巢储备较好的人可能有帮助，但尚未得到充分证实；HFEA 认为这一人群的证据不足。是否做，应结合胚胎数量和既往经历与医生讨论。"],
 ["做了 PGT-A 还会流产吗？","会。HFEA 认为 PGT-A 能降低大多数人的流产风险，但不能完全消除。"],
 ["检测正常的胚胎一定能怀上吗？","不能。PGT-A 只看染色体数目，着床和继续妊娠还受年龄、子宫环境等多种因素影响，检测本身也可能出现误判。"],
 ["活检会伤害胚胎吗？","HFEA 说明，PGT-A 对接受治疗的人没有已知的额外风险，但对胚胎存在一定风险。ASRM 指出，囊胚期滋养层活检对胚胎活力的影响小于早期卵裂期活检。具体风险应向操作实验室确认。"],
 ["怀孕后还需要做唐筛或产前诊断吗？","需要照常讨论。ACOG 2020 年委员会意见建议，所有做过 PGT-A 的孕妇都应和其他孕妇一样，获得非整倍体筛查或产前诊断的选择。"]
];
---
<SiteLayout title={title} description={description} active="guides" zhOnlyAlternates={true}>
<article class="section wrap pgt-guide" aria-label="PGT-A 胚胎染色体筛查指南">
<p class="byline">撰写：Saipan IVF 网站内容团队 · 更新：2026-10-29 · <a href="/editorial-policy/">编辑与资料来源政策</a></p>
<div class="answer"><div class="meta">胚胎检测 · 医学资料核对：{checked}</div><h2>多数人不必把 <span class="nw">PGT-A</span> 当作必选项</h2><p><strong>PGT-A 可以降低流产风险，但没有证据表明它能提高大多数人最终生下宝宝的机会。</strong>美国生殖医学学会（ASRM）2024 年意见认为，它作为所有 IVF 患者的常规筛查，价值尚未得到证实；英国监管机构 HFEA 对“提高活产率”一项评为红色。年龄较大且囊胚较多、反复流产等情况可以和医生具体讨论，但获益同样没有定论。</p>
<ul class="facts"><li><b>US${range(pgt)}</b><span>PGT-A 规划预算（本站估算，非诊所报价）</span></li><li><b>先冷冻，后移植</b><span>等待结果期间胚胎需冷冻，之后通常另做冻胚移植</span></li><li><b>遗传病另有检测</b><span>已知遗传病或染色体结构异常，应讨论 PGT-M / PGT-SR</span></li></ul>
<small>适用于正在考虑 IVF 胚胎检测的人。本文提供一般信息，不能替代医生和遗传咨询师的个人评估。</small></div>
<nav class="toc" aria-label="文章导航"><a href="#types">三种 PGT</a><a href="#evidence">证据</a><a href="#situations">适用情况</a><a href="#cost">费用与行程</a><a href="#results">看懂报告</a><a href="#checklist">付款前清单</a><a href="#faq">常见问题</a></nav>

<section id="types"><h2><span class="nw">PGT-A</span>、<span class="nw">PGT-M</span>、<span class="nw">PGT-SR</span> 不是一回事</h2><p>三者都要在 IVF 中取出胚胎的少量细胞检测，但查的东西和适合的人完全不同。先确认自己讨论的是哪一种，再谈要不要做。</p><p class="swipe">在手机上可横向滑动表格。</p><div class="table-scroll" role="region" aria-label="三种胚胎植入前遗传学检测对照表" tabindex="0"><table><thead><tr><th scope="col">检测</th><th scope="col">查什么</th><th scope="col">适合讨论的人</th><th scope="col">用途与证据</th></tr></thead><tbody>{types.map(([name,what,who,status])=><tr><th scope="row">{name}</th><td>{what}</td><td>{who}</td><td>{status}</td></tr>)}</tbody></table></div><p class="source-inline">依据：<a href={hfeaM}>HFEA · PGT-M 与 PGT-SR 说明</a>；<a href={asrm}>ASRM 2024 委员会意见</a>；<a href={eshre}>ESHRE 2023 辅助生殖附加项目建议</a>。</p></section>

<section id="evidence"><h2><span class="nw">PGT-A</span> 能做到什么，做不到什么</h2><p>判断一项检查值不值得做，关键看它能否改善你真正在意的结果。按结果拆开看，结论并不相同：</p><RatingGrid title="按结果看 PGT-A 的证据" items={ratings} source="HFEA 评级（2025-10-19 复核）；反复流产一项来自 ASRM 2024" sourceHref={hfea}/>
<p><strong>两项随机试验的数字：</strong>在多中心 STAR 试验中，按意向治疗计算，20 周持续妊娠率为 41.8%（PGT-A 组）和 43.5%（常规选择组），两组相近。2021 年一项中国多中心试验中，PGT-A 组累计活产率为 77.2%，常规 IVF 组为 81.8%，未能证明 PGT-A 不劣于常规做法。两项试验的入组人群都有特定条件，结果不能直接套用到每个人。</p>
<p>欧洲人类生殖与胚胎学会（ESHRE）2023 年的附加项目建议同样认为，PGT-A 目前<strong>不推荐常规临床使用</strong>。</p>
<p class="source-inline">依据：<a href={hfea}>HFEA · PGT-A 评级（2025-10-19 复核）</a>；<a href={asrm}>ASRM · Fertility and Sterility 2024;122:421–34</a>；<a href={eshre}>ESHRE · Human Reproduction 2023</a>。试验数字转引自 ASRM 意见。</p></section>

<section id="situations"><h2>哪些情况值得和医生讨论？</h2><div class="situ-intro"><p>没有“一律做”或“一律不做”的答案。下面按常见情况列出值得问的问题，方便你在咨询时直接对照。把自己的年龄、预计囊胚数和既往经历带去，讨论会具体得多。</p><Illustration name="pgt-a-consult" maxWidth={200}/></div><div class="table-scroll" role="region" aria-label="PGT-A 讨论情境对照表" tabindex="0"><table><thead><tr><th scope="col">你的情况</th><th scope="col">和医生讨论什么</th><th scope="col">需要知道的限制</th></tr></thead><tbody>{situations.map(([who,ask,limit])=><tr><th scope="row">{who}</th><td>{ask}</td><td>{limit}</td></tr>)}</tbody></table></div><p class="notice">以上是咨询准备工具，不是治疗建议。是否检测、检测几枚胚胎，应由接诊医生结合你的年龄、胚胎数量、既往病史和遗传咨询结果决定。</p></section>

<section id="cost"><h2>在塞班做 <span class="nw">PGT-A</span>：钱和时间怎么算</h2><p>PGT-A 的费用不只是检测费。因为要等结果，胚胎需要冷冻，之后再安排一次冻胚移植；对跨境就诊者来说，这往往还意味着多一次往返。</p><RangeBars title="选择 PGT-A 后会发生的费用（规划预算 · USD）" prefix="US$" items={costBars} scaleMax={6000} caption="条形长度按同一比例绘制；数值为本站规划预算，不是诊所报价。"/><div class="table-scroll" role="region" aria-label="PGT-A 相关费用表" tabindex="0"><table><thead><tr><th scope="col">项目</th><th scope="col">规划价 · USD</th><th scope="col">说明</th></tr></thead><tbody>
<tr><th scope="row">PGT-A 检测</th><td class="num">{range(pgt)}</td><td>{pgt.note}</td></tr>
<tr><th scope="row">胚胎冷冻操作</th><td class="num">{range(freeze)}</td><td>等待结果期间需要冷冻；{freeze.note}</td></tr>
<tr><th scope="row">首年冷冻保存</th><td class="num">{range(storage)}</td><td>计费起点和续费规则以合同为准</td></tr>
<tr><th scope="row">冻胚移植 FET</th><td class="num">{range(fet)}</td><td>{fet.note}</td></tr>
<tr class="total-row"><th scope="row">相关医疗预算合计</th><td class="num">{num(linkedLow)}–{num(linkedHigh)}</td><td>不含移植用药和行程</td></tr>
<tr><th scope="row">再次往返机票（1 人）</th><td class="num">450–1,000</td><td>沿用<a href="/guides/egg-freezing-cost/#travel">冻卵费用指南</a> 2026-10-26 公开比价区间；住宿天数取决于移植方案</td></tr>
</tbody></table></div>
<StepFlow label="做 PGT-A 时的大致流程" steps={steps}/>
<p class="source-caption">费用为本站规划预算（{checked} 核对），不是诊所报价。不做 PGT-A 时，多余胚胎也可能冷冻保存，因此冷冻和移植费用并非全部由检测“额外”产生；表中列出的是选择 PGT-A 后基本一定会发生的项目。流程依据 ASRM 2024 意见。用<a href="/fees/">预算工具</a>组合其他项目，用<a href="/guides/quotation/">报价核对清单</a>逐项比对。</p></section>

<section id="results"><h2>报告上可能出现的四种结果</h2><div class="result-grid">{results.map(([name,text])=><article><h3>{name}</h3><p>{text}</p></article>)}</div>
<p class="notice"><strong>怀孕后仍要照常做产前检查。</strong>PGT-A 是筛查，不是诊断。ACOG 建议，做过 PGT-A 的孕妇仍应获得非整倍体筛查或产前诊断（如绒毛取样、羊水穿刺）的选择。</p>
<p class="source-inline">依据：<a href={hfea}>HFEA（嵌合胚胎）</a>；<a href={asrm}>ASRM 2024（无结果比例、再活检、处置政策）</a>；<a href={acog}>ACOG Committee Opinion No. 799（2020 年发布，页面未标注后续复核日期）</a>。</p></section>

<section id="checklist"><h2>付款前，问清这 8 个问题</h2><p>可以复制到手机备忘录，咨询时逐条确认，并请诊所书面答复。</p><ol class="checklist"><li><strong>检测类型：</strong>做的是 PGT-A、PGT-M 还是 PGT-SR？为什么建议我做？</li><li><strong>操作与实验室：</strong>活检由谁操作，样本送往哪家实验室？</li><li><strong>计费方式：</strong>按周期还是按胚胎数计费？活检、冷冻、样本运输和检测分别是否包含？</li><li><strong>嵌合与无结果：</strong>如何报告？是否可以移植？再次活检怎么收费？</li><li><strong>异常胚胎：</strong>保存、处置的书面政策是什么？由谁决定？</li><li><strong>时间安排：</strong>结果多久出来？最早何时移植？需要在塞班停留多久？</li><li><strong>遗传咨询：</strong>是否提供遗传咨询？报告能否提供中文解读？</li><li><strong>没有可移植胚胎时：</strong>后续方案和费用如何安排？</li></ol><p>ASRM 建议知情同意应涵盖检测的局限、嵌合及无结果的可能，并提供不检测的选项和遗传咨询渠道。还在比较整体方案，可以先看<a href="/guides/ivf-cost/">塞班试管婴儿费用</a>、<a href="/guides/amh-ovarian-reserve/">AMH 检查解读</a>和<a href="/guides/embryo-transfer-aftercare/">胚胎移植后注意事项</a>。</p></section>

<section id="faq"><h2>常见问题</h2>{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<div class="next"><h2>不确定要不要做？先带着胚胎情况来问</h2><p>咨询时可以提供年龄、AMH 或 B 超报告、既往 IVF 和流产经历。本站协助整理问题和报价清单，是否检测由实际接诊医生评估。</p><a class="button" href="/contact/">咨询 PGT-A 与治疗安排</a><a class="back" href="/guides/">返回全部指南</a></div>
<SourceNote checked={checked} sources={[{name:"ASRM · The use of preimplantation genetic testing for aneuploidy: a committee opinion (2024)",url:asrm},{name:"HFEA · Pre-implantation genetic testing for aneuploidy (PGT-A)",url:hfea},{name:"HFEA · PGT-M and PGT-SR",url:hfeaM},{name:"ESHRE · Good practice recommendations on add-ons in reproductive medicine (2023)",url:eshre},{name:"ACOG · Committee Opinion No. 799: Preimplantation Genetic Testing (2020)",url:acog}]}/>
</article></SiteLayout>
<style>
.byline{font-size:13px;color:#476478;margin:0 0 6px}.pgt-guide{max-width:1050px;padding-top:24px;padding-bottom:68px}.pgt-guide section{margin-top:44px;scroll-margin-top:26px}.pgt-guide h2{font-size:clamp(23px,2.8vw,31px);line-height:1.27}.pgt-guide p{line-height:1.75}
