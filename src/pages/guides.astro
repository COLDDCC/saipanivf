---
import SiteLayout from "../layouts/SiteLayout.astro";
const readingPaths = [
 {title:'第一次了解',text:'先整理问题，再确认初诊方式。',links:[['/guides/first-visit/','首次咨询准备'],['/team/','医疗团队'],['/contact/','开始咨询']]},
 {title:'比较治疗与费用',text:'把治疗选择和收费范围一起看。',links:[['/treatments/','比较治疗项目'],['/fees/','组合费用预算'],['/guides/quotation/','核对书面报价']]},
 {title:'准备预约与出行',text:'取得院方确认，再安排交通住宿。',links:[['/service-scope/','服务范围与付款文件'],['/process/','各阶段就诊安排'],['/guides/travel-checklist/','跨境就诊清单']]},
 {title:'准备返程与后续联系',text:'带走治疗资料，确认复查与保存事项。',links:[['/process/#follow-up','返程与随访事项'],['/treatments/frozen-embryo-transfer/','后续冻胚移植'],['/faq/#separate-visits','取卵与移植能否分次安排']]}
];
---
<SiteLayout title="辅助生殖就诊指南" description="按治疗、费用、初诊行程和家庭规划查找资料。" active="guides"><div class="section wrap"><section aria-labelledby="reading-paths-title"><h2 id="reading-paths-title">你现在进行到哪一步？</h2><p class="lead">从当前需要解决的问题开始，按阶段找到对应资料。</p><div class="reading-paths">{readingPaths.map(path=><article><div><h3>{path.title}</h3><p>{path.text}</p><ul>{path.links.map(([href,label])=><li><a href={href}>{label}</a></li>)}</ul></div></article>)}</div></section><h2 class="all-guides">按主题查找全部指南</h2><nav class="guide-categories" aria-label="指南分类"><a href="#group-0">治疗与生育力保存</a><a href="#group-1">费用与服务范围</a><a href="#group-2">初诊与跨境就诊</a><a href="#group-3">家庭与身份规划</a></nav><section class="guide-category" id="group-0"><h2>治疗与生育力保存</h2><div class="hub-grid"><a class="hub-card" href="/guides/iui-vs-ivf/"><h3>人工授精 IUI 与 IVF 的区别</h3><p>7项对比、治疗选择情境与首次咨询清单</p><span>阅读选择指南</span></a><a class="hub-card" href="/guides/egg-freezing-cost/"><h3>塞班冻卵费用 2026</h3><p>医疗费、机票住宿、在岛天数与多年保存费一次算清</p><span>查看预算指南</span></a><a class="hub-card" href="/guides/ivf-steps/"><h3>IVF主要阶段</h3><p>检查、促排、取卵、培养与移植</p><span>阅读全文</span></a><a class="hub-card" href="/guides/egg-freezing/"><h3>冻卵咨询</h3><p>评估、保存及未来使用</p><span>阅读全文</span></a></div></section><section class="guide-category" id="group-1"><h2>费用与服务范围</h2><div class="hub-grid"><a class="hub-card" href="/guides/ivf-cost/"><h3>塞班试管婴儿费用 2026</h3><p>IVF基础预算、药物与移植费用分开核算</p><span>阅读费用指南</span></a><a class="hub-card" href="/fees/"><h3>治疗费用预算工具</h3><p>选择项目，查看组合预算和未包含支出</p><span>查看费用</span></a><a class="hub-card" href="/service-scope/"><h3>预约与服务范围</h3><p>接诊方、收款方及付款前的文件清单</p><span>查看服务范围</span></a><a class="hub-card" href="/guides/quotation/"><h3>看懂IVF报价</h3><p>包含、另计、付款与取消</p><span>阅读全文</span></a></div></section><section class="guide-category" id="group-2"><h2>初诊与跨境就诊</h2><div class="hub-grid"><a class="hub-card" href="/guides/first-visit/"><h3>首次咨询资料</h3><p>没有报告也可以开始咨询</p><span>阅读全文</span></a><a class="hub-card" href="/guides/travel-checklist/"><h3>跨境就诊清单</h3><p>预约、行程、住宿与随访</p><span>阅读全文</span></a></div></section><section class="guide-category" id="group-3"><h2>家庭与身份规划</h2><div class="hub-grid"><a class="hub-card" href="/birth-planning/"><h3>塞班出生与美国公民身份</h3><p>国籍、签证、出生证明与护照分别核对</p><span>查看身份指南</span></a><a class="hub-card" href="/guides/family-planning/"><h3>第三方参与的咨询问题</h3><p>医疗条件、资源和文件要求</p><span>阅读全文</span></a></div></section><div class="related"><a class="inline-link" href="/treatments/">查看治疗项目详情</a> · <a class="inline-link" href="/birth-planning/">塞班分娩与子女身份</a> · <a class="inline-link" href="/faq/">常见问题</a></div></div></SiteLayout>
<style>.reading-paths{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.reading-paths article{padding:28px;background:var(--light)}.reading-paths h3{font-size:24px}.reading-paths p{margin:0 0 14px}.reading-paths ul{list-style:none;padding:0;margin:0}.reading-paths a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;text-decoration:underline;text-underline-offset:5px}.all-guides{margin-top:60px}.guide-category{scroll-margin-top:24px}@media(max-width:650px){.reading-paths{grid-template-columns:1fr;gap:18px}.reading-paths article{padding:24px}.reading-paths h3{font-size:22px}}</style>
