---
import TreatmentComparison from "../components/TreatmentComparison.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { treatments } from "../data/treatments";
import SiteLayout from "../layouts/SiteLayout.astro";

const goals = ["了解取卵、受精、培养与移植", "了解IVF中的受精方式", "保存卵子，规划未来使用", "已有冷冻胚胎，了解移植"];
---
<SiteLayout title="辅助生殖与生育力保存" description="试管婴儿、ICSI、冻卵、冻精、冻胚移植，以及捐赠与家庭生育计划咨询。" active="treatments"><section class="section wrap" id="services"><h2>先了解项目，再讨论个人方案。</h2><p class="lead">从生育目标与已有检查开始，了解可讨论的治疗选择。</p><TreatmentComparison/><details class="term-guide"><summary>看不懂缩写？查看六个常用术语</summary><div class="glossary"><div><b>IVF · 试管婴儿</b>卵子和精子在体外结合成胚胎，再移回子宫。</div><div><b>ICSI · 单精子注射</b>将单个精子注入卵子，适合部分男方因素。</div><div><b>冻卵 / 冻精</b>把卵子或精子冻起来，以后再用。</div><div><b>FET · 冻胚移植</b>把冻好的胚胎解冻，再移植。</div><div><b>PGT-A</b>查胚胎染色体数目，是否适用由医生评估。</div><div><b>AMH / AFC</b>看卵巢储备的两个指标。</div></div></details><div class="service-grid">
<article class="service service-text"><div class="body"><div class="number">想怀孕</div><h3>了解做试管婴儿（IVF）</h3><p>从检查、促排到取卵、移植，一步步来，费用分开算。</p><a href="/treatments/ivf/">了解IVF项目</a></div></article>
<article class="service"><ResponsiveImage src="/images/stock/stethoscope-blue.webp" loading="lazy" alt="蓝色背景上的听诊器"><div class="body"><div class="number">担心受精</div><h3>单精子注射（ICSI）</h3><p>适合部分男方因素，要不要做由医生判断，费用另计。</p><a href="/treatments/icsi/">了解ICSI项目</a></div></article>
<article class="service"><ResponsiveImage src="/images/stock/baby-socks.webp" loading="lazy" alt="家庭鞋履与婴儿袜"><div class="body"><div class="number">还不确定</div><h3>尚未确定治疗方向</h3><p>可先说明生育计划与既往检查，由医生评估适合的咨询方向。</p><a href="/contact/">联系咨询</a></div></article>
</div></section><section class="section wrap" id="real-services"><h2>生育力保存与捐赠项目</h2><p class="lead">生育力保存、捐赠卵子或精子与第三方参与方案，需要分别评估医疗条件、可用资源与文件要求。</p><div class="service-grid"><article class="service service-text"><div class="body"><div class="number">保存生育力</div><h3>冻卵与冻精</h3><p><strong>冻卵：</strong>治疗涉及评估、促排、取卵、冷冻和保存，各阶段费用分别确认。<strong>冻精：</strong>含精液评估、筛查和保存。</p><a href="https://www.saipan-ivf.com/FertilityPreservation/index.html" target="_blank" rel="noopener">了解生育力保存</a></div></article><article class="service service-text"><div class="body"><div class="number">供卵与供精</div><h3>使用捐赠卵子或精子</h3><p>院方公开介绍列有心理、遗传和传染病等供卵筛查。具体可用资源、筛查记录与接收条件需向院方核对；供精项目另行确认样本资料。</p><a href="https://www.saipan-ivf.com/EggDonation/" target="_blank" rel="noopener">了解捐卵项目</a></div></article><article class="service"><ResponsiveImage src="/images/stock/family-sunlight.webp" loading="lazy" alt="阳光下的双手与婴儿鞋"><div class="body"><div class="number">家庭计划</div><h3>第三方辅助生殖</h3><p>包括第三方妊娠，以及给 LGBTQ+ 家庭的捐精、捐卵和胚胎移植，手续按各自情况单独确认。</p><a href="https://www.saipan-ivf.com/Surrogate/" target="_blank" rel="noopener">了解第三方生育服务</a></div></article></div></section><section class="section wrap" id="family-options"><h2>不同的家庭，<br>各有各的计划。</h2><p class="lead">单身人士和 LGBTQ+ 家庭可以咨询捐精、捐卵和其他辅助生殖，接诊条件、亲子文件和跨境手续按各自情况确认。</p><div class="benefits"><article class="benefit"><h3>单身人士</h3><p>先问清适用的 IVF、捐精或捐卵方案，以及接诊条件、知情同意和亲子文件。</p></article><article class="benefit"><h3>使用捐赠卵子或精子</h3><p>涉及来源筛查、可用样本、保存和费用，不同项目等待时间不一样。</p></article><article class="benefit"><h3>LGBTQ+ 家庭</h3><p>按伴侣和家庭计划商量可行路径，说清需要哪些医疗、第三方参与和法律文件。</p></article></div><div class="gallery"><figure><ResponsiveImage src="/images/stock/leaves-backlit.webp" alt="逆光中的绿叶" loading="lazy"><figcaption>一起商量每一步</figcaption></figure></div></section><section class="soft" id="knowledge"><div class="section wrap split"><div><h2>ICSI 和普通 IVF，<br>有什么不一样？</h2><p>常规IVF受精是让精子与卵子在实验室中结合；ICSI 是将单个精子注入卵子。受精方式由医生结合检查结果、既往治疗和适应证选择。</p><p>年龄、不孕原因和以前的治疗都会影响结果，没有统一的成功率；初诊时医生会一起商量。</p><a class="inline-link" href="/faq/">阅读常见问题</a></div><div class="photo"><ResponsiveImage src="/images/stock/stethoscope-silver.webp" loading="lazy" alt="听诊器近景"></div></div></section></SiteLayout>
<style>.path-comparison{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin:32px 0}.path-comparison article{padding:30px;background:var(--light);min-width:0}.path-goal{font-size:14px;color:var(--blue);margin:0 0 12px}.path-comparison h3{font-size:26px}.path-comparison h3 a:hover{text-decoration:underline;text-underline-offset:5px}.path-price{font-size:18px;font-weight:600;margin-top:22px}.path-comparison .inline-link{font-size:15px}.term-guide{margin:32px 0 48px}.term-guide summary{font-size:17px;line-height:1.8;padding:14px 0}.term-guide .glossary{margin-top:18px}@media(max-width:650px){.path-comparison{grid-template-columns:1fr;gap:18px}.path-comparison article{padding:24px}.path-comparison h3{font-size:24px}}</style>
