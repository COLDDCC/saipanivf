---
import SiteLayout from "../layouts/SiteLayout.astro";
import { faqs } from "../data/faq";
---
<SiteLayout title="常见问题" description="关于塞班出生公民身份、IVF费用、治疗时间、ICSI和首次咨询，先看结论，再查依据。" active="faq"><section class="section wrap" id="faq"><h2>你关心的问题，逐项回答</h2><p class="lead">了解身份、费用、治疗时间与初诊准备，查看具体说明和资料来源。</p><details class="faq-directory"><summary>按问题快速查找 · {faqs.length}项</summary><nav class="faq-index" aria-label="问题目录">{faqs.map(item=><a href={`#${item.id}`}>{item.question}</a>)}</nav></details><div class="faq">{faqs.map((item,i)=><details id={item.id} open={i===0}><summary>{item.question}</summary><p class="faq-answer"><strong>{item.answer}</strong></p><p>{item.detail}</p><a class="inline-link" href={item.source} target={item.source.startsWith('https:')?'_blank':undefined} rel={item.source.startsWith('https:')?'noopener':undefined}>{item.sourceLabel}</a></details>)}</div><p class="caption">资料核对日期：2026年10月19日。历史规则、研究人群和机构预算各有适用范围；未来个案需核对届时规则与个人条件。</p></section><script>
function revealQuestion(id=window.location.hash.slice(1)){
 const question=document.getElementById(id);
 if(question instanceof HTMLDetailsElement){question.open=true;requestAnimationFrame(()=>question.scrollIntoView({block:'start'}));}
}
revealQuestion();window.addEventListener('hashchange',()=>revealQuestion());
document.querySelectorAll<HTMLAnchorElement>('.faq-index a').forEach(link=>link.addEventListener('click',()=>revealQuestion(link.hash.slice(1))));
</script></SiteLayout>
