import ResponsiveImage from "../components/ResponsiveImage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";

---
<SiteLayout title="IVF就诊流程" description="从首次咨询、报告整理到医生评估、治疗和返程随访，按阶段准备资料与时间。" active="process"><section class="section wrap" id="journey"><h2>从首次咨询到返程随访</h2><p class="lead">每个阶段分别列出你要准备的资料、需要协调的事项，以及应取得或确认的结果。</p><div class="stage-list"><article class="stage-detail"><h3>首次咨询</h3><dl><div><dt>你准备</dt><dd>关注项目、出发城市、预计时间、已有治疗经历</dd></div><div><dt>协调事项</dt><dd>确认咨询渠道、接诊方式与初诊收费</dd></div><div><dt>医疗团队</dt><dd>确定能否接诊，以及评估前需要哪些资料</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>初诊方式、咨询费用、资料清单</dd></div></dl></article><article class="stage-detail"><h3>报告与病史整理</h3><dl><div><dt>你准备</dt><dd>按日期整理报告、手术及治疗记录、当前用药和过敏史</dd></div><div><dt>协调事项</dt><dd>核对资料是否齐全，确认隐私说明和提交渠道</dd></div><div><dt>医疗团队</dt><dd>判断报告是否可用，列出需要补充的项目</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>报告接收确认、补充检查项目与有效期要求</dd></div></dl></article><article class="stage-detail"><h3>医生评估与方案</h3><dl><div><dt>你准备</dt><dd>准备希望解决的问题，说明时间与预算限制</dd></div><div><dt>协调事项</dt><dd>协调预约，整理需要院方答复的问题</dd></div><div><dt>医疗团队</dt><dd>讨论治疗选择、限制、风险和监测安排</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>个人方案、检查安排与待确认问题</dd></div></dl></article><article class="stage-detail"><h3>报价与出行确认</h3><dl><div><dt>你准备</dt><dd>核对证件、真实出行目的、预算与陪同需求</dd></div><div><dt>协调事项</dt><dd>对照到院日期安排交通住宿，核对退改条件</dd></div><div><dt>医疗团队</dt><dd>确认治疗日程和是否需要调整</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>书面费用范围、收款方、付款节点与预约信息</dd></div></dl></article><article class="stage-detail"><h3>到院与治疗</h3><dl><div><dt>你准备</dt><dd>带齐院方要求的报告、文件和个人物品</dd></div><div><dt>协调事项</dt><dd>确认到院指引、沟通渠道与行程变动的衔接</dd></div><div><dt>医疗团队</dt><dd>负责诊断、处方、监测、取卵、培养或移植</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>按实际治疗取得相应报告、处方与复诊安排</dd></div></dl></article><article class="stage-detail"><h3>返程与后续随访</h3><dl><div><dt>你准备</dt><dd>保存病历、处方、付款记录与保存授权文件</dd></div><div><dt>协调事项</dt><dd>确认回国后的沟通方式、资料补领与续存事项</dd></div><div><dt>医疗团队</dt><dd>明确用药、复查日期和就医指引</dd></div><div class="stage-result"><dt>本阶段应确认</dt><dd>治疗摘要、复查计划、联系方式与保存续费信息</dd></div></dl></article></div><a class="button" href="/contact/">准备初步咨询</a><h3 class="journey-sub">要去几次、每次住多久？</h3><p class="lead">治疗周期与实际到院时间分别规划。以下供初步安排参考，个人日程在医生评估后确认。</p><div class="duration"><article><h3>完整周期参考</h3><p>一般IVF周期约3–6周，包含的准备阶段依方案不同；不等于必须全程住在塞班。</p></article><article><h3>分阶段取卵与移植</h3><p>取卵和移植可以分阶段安排，分别确认监测地点、到院日期和返程条件。</p></article><article><h3>确定个人行程</h3><p>订票前取得接诊日期、预计复诊及返程安排，并单独核对允许停留时间。</p></article></div><div class="gallery"><figure><ResponsiveImage src="/images/stock/wing-new.webp" alt="飞行中的机翼" loading="lazy"><figcaption>确认医生日程后再预订行程</figcaption></figure><figure><ResponsiveImage src="/images/stock/travel-new.webp" alt="旅行准备物品" loading="lazy"><figcaption>预留行程退改空间</figcaption></figure></div><p class="caption">天数不含往返飞行与突发调整；建议选择可退改的机票与住宿。</p></section></SiteLayout>