---
import {usd} from '../../i18n/money';
import {frenchFaqSource,frenchPageSources,frenchTravelReferences} from '../../data/french-sources';
import {germanFaqSource,germanPageSources} from '../../data/german-sources';
import {spanishFaqSource,spanishPageSources} from '../../data/spanish-sources';
import QuotationContents from "../../components/QuotationContents.astro";
import TreatmentReference from "../../components/TreatmentReference.astro";
import QuotationChecklist from "../../components/QuotationChecklist.astro";
import EngagementNotice from "../../components/EngagementNotice.astro";
import ClinicArrival from "../../components/ClinicArrival.astro";
import ProviderPreservationScope from "../../components/ProviderPreservationScope.astro";
import OutcomeEvidence from "../../components/OutcomeEvidence.astro";
import TreatmentVisit from "../../components/TreatmentVisit.astro";
import ServiceResponsibilities from '../../components/ServiceResponsibilities.astro';
import CareJourney from '../../components/CareJourney.astro';
import TreatmentComparison from '../../components/TreatmentComparison.astro';
import LocalizedIllustrations from '../../components/LocalizedIllustrations.astro';
import LocalizedHome from '../../components/LocalizedHome.astro';
import LocalizedLayout from '../../layouts/LocalizedLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import LocalizedBudget from '../../components/LocalizedBudget.astro';
import LocalizedConsultation from '../../components/LocalizedConsultation.astro';
import { dictionaries,routeKeys,pageInfo,pageHref,treatmentSlugs } from '../../i18n';
import { treatments } from '../../data/treatments';
import { faqs } from '../../data/faq';
export function getStaticPaths(){return (['en','ja','ko','es','de','fr'] as const).flatMap(locale=>routeKeys.map(key=>({params:{locale,path:key||undefined},props:{locale,key}})))}
const {locale,key}=Astro.props;const d=dictionaries[locale],page=pageInfo(locale,key);const href=(route='')=>pageHref(locale,route);const isHome=key==='';const treatmentIndex=treatmentSlugs.indexOf(key.replace('treatments/',''));const treatment=key.startsWith('treatments/')&&treatmentIndex>=0?d.treatments[treatmentIndex]:null;const original=treatment?treatments[treatmentIndex]:null;
const guidePaths: Record<string,string[]>={'guides/first-visit':['treatments','team','process'],'guides/ivf-steps':['treatments/ivf','fees','process'],'guides/quotation':['fees','process','service-scope'],'guides/egg-freezing':['treatments/egg-freezing','fees','process'],'guides/travel-checklist':['process','guides/first-visit','service-scope'],'guides/family-planning':['treatments','fees','service-scope']};
const consultationTopic=key==='guides/egg-freezing'?'egg-freezing':key==='guides/ivf-steps'?'ivf':'';
const links=guidePaths[key]??(key==='guides'?['guides/first-visit','guides/ivf-steps','guides/quotation','guides/egg-freezing','guides/travel-checklist','guides/family-planning']:key==='process'?['guides/first-visit','fees','guides/travel-checklist','service-scope']:key==='birth-planning'?['faq','guides/family-planning','contact']:['treatments','fees','process','guides/first-visit']);
const source=key==='team'?'https://www.saipan-ivf.com/Resources/':key==='birth-planning'?'https://fam.state.gov/FAM/08FAM/08FAM030202.html':key==='guides/ivf-steps'||key==='process'?'https://www.nhs.uk/tests-and-treatments/ivf/':key==='guides/egg-freezing'?'https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/':'https://www.saipan-ivf.com/';
const faqReferences=faqs.map((item,i)=>({...item,source:['ja','ko'].includes(locale)&&i===3?'https://travel.state.gov/content/travel/en/us-visas/tourism-visit/visa-waiver-program.html':locale==='fr'?frenchFaqSource(i,item.source):locale==='de'?germanFaqSource(i,item.source):locale==='es'?spanishFaqSource(i,item.source):item.source,additionalSources:locale==='fr'&&i===3?frenchTravelReferences:['es','de','ja','ko'].includes(locale)&&i===3?item.additionalSources?.slice(1):item.additionalSources}));
const localizedPageSources=locale==='fr'?frenchPageSources:locale==='de'?germanPageSources:spanishPageSources;
const profileIds=['gary-ramsey','irena-lalic','rose-wang'];
---
<LocalizedLayout locale={locale} key={key} title={page.title} description={page.description} home={isHome}>
{isHome?<LocalizedHome locale={locale}/>:key==='contact'?<LocalizedConsultation locale={locale}/>:key==='process'?<div class="section wrap"><CareJourney locale={locale}/></div>:key==='service-scope'?<div class="section wrap"><ServiceResponsibilities locale={locale}/></div>:<div class="section wrap localized-content">
{key==='guides/travel-checklist'&&<ClinicArrival locale={locale}/>}
{key==='fees'&&<><LocalizedBudget locale={locale}/><TreatmentComparison locale={locale} mode="fees"/></>}
{key==='treatments'&&<TreatmentComparison locale={locale}/>}
{treatment&&<div class="treatment-detail"><div class="treatment-main"><nav class="quick-links" aria-label={d.related}><a href="#decision">{d.nav[1]}</a><a href="#costs">{d.nav[4]}</a><a href="#steps">{d.steps}</a><a href="#prepare">{d.prepare}</a></nav><TreatmentVisit locale={locale} slug={treatmentSlugs[treatmentIndex]}/><ResponsiveImage class="treatment-photo" src={'/images/stock/'+original.image+'.webp'} alt={treatment.title} width="1000" height="650" fetchpriority="high"/><section id="decision"><h2>{treatment.title}</h2><p>{treatment.summary}</p><p>{treatment.suitable}</p><TreatmentReference locale={locale} slug={original.slug}/></section><section id="steps"><h2>{d.steps}</h2><ol>{treatment.stages.map(step=><li>{step}</li>)}</ol><a class="inline-link" href={href('process')}>{d.nav[3]}</a><TreatmentReference locale={locale} slug={original.slug}/></section>{treatmentSlugs[treatmentIndex]==='egg-freezing'&&<ProviderPreservationScope locale={locale}/>}<section id="costs"><h2>{d.nav[4]}</h2><p class="treatment-price">{usd([15000,1800,9000,4500][treatmentIndex],locale)}{!['es','de','fr'].includes(locale)&&' USD'}</p><dl class="service-scope"><div><dt>{d.included}</dt><dd>{treatment.included}</dd></div><div><dt>{d.excluded}</dt><dd>{treatment.excluded}</dd></div></dl><p>{d.budgetNote}</p><a class="inline-link" href={href('fees')}>{d.fees}</a><TreatmentReference locale={locale} slug={original.slug} kind="cost"/></section><section id="risks"><h2>{d.risk}</h2><p>{treatment.risk}</p><TreatmentReference locale={locale} slug={original.slug} kind="risk"/></section><section id="prepare"><h2>{d.questions}</h2><ul>{treatment.questions.map(q=><li>{q}</li>)}</ul><a class="inline-link" href={original.source} target="_blank" rel="noopener">HFEA · {d.source}</a></section><TreatmentReference locale={locale} slug={original.slug} kind="summary"/></div><aside class="treatment-aside"><h2>{d.prepare}</h2><p>{d.pages['guides/first-visit'].description}</p><a class="button" href={href('contact')+'?topic='+treatmentSlugs[treatmentIndex]}>{d.contact}</a><nav aria-label={d.related}><a href={href('fees')}>{d.fees}</a><a href={href('process')}>{d.nav[3]}</a><a href={href('treatments')}>{d.nav[1]}</a></nav></aside></div>}
{key==='faq'&&<><nav class="faq-index" aria-label={d.nav[8]}>{d.faq.map((item,i)=><a href={'#'+faqs[i].id}>{item[0]}</a>)}</nav><div class="faq">{d.faq.map((item,i)=><details id={faqs[i].id} open={i===0}><summary>{item[0]}</summary><p class="faq-answer"><strong>{item[1]}</strong></p><p>{item[2]}</p><a class="inline-link" href={faqReferences[i].source.startsWith('/')?'/'+locale+faqReferences[i].source:faqReferences[i].source} target={faqReferences[i].source.startsWith('/')?undefined:'_blank'} rel="noopener">{d.source}</a>{faqReferences[i].additionalSources?.map((source,j)=><p><a class="inline-link" href={source.url} target="_blank" rel="noopener">{d.source} · {locale==='fr'?source.label:locale==='de'?'Besuchervisum':locale==='es'?'Visado de visitante':locale==='ja'?'米国の訪問ビザ':locale==='ko'?'미국 방문 비자':j===0?'VWP / ESTA':'Visitor visa'}</a></p>)}</details>)}</div></>}
{key==='guides/quotation'&&<QuotationContents locale={locale}/>}
{page.sections.map(([title,text],i)=><><section class:list={['localized-section',{'split about-opening':key==='about'&&i===0}]} id={key==='team'&&i<3?profileIds[i]:key==='process'&&i===5?'follow-up':'section-'+i}><div><h2>{title}</h2><p>{text}</p></div>{key==='about'&&i===0&&<div class="photo"><ResponsiveImage src="/images/stock/leaves-lush.webp" alt={title} width="1000" height="650" loading="lazy"/></div>}</section>{key==='about'&&i===2&&<div class="gallery about-gallery">{['leaves-vibrant','leaves-pattern'].map((image,n)=><figure><ResponsiveImage src={'/images/stock/'+image+'.webp'} alt={d.pages.about.sections[n+1][0]} width="1000" height="650" loading="lazy"/><figcaption>{d.pages.about.sections[n+1][0]}</figcaption></figure>)}</div>}</>)}
{['fees','treatments','process','birth-planning'].includes(key)&&<LocalizedIllustrations locale={locale} page={key}/>}

{['es','de','fr'].includes(locale)&&localizedPageSources[key]&&<section class="localized-section"><h2>{locale==='fr'?'Sources officielles pour ces démarches':locale==='de'?'Behördliche Quellen und weiterführende Hinweise':'Fuentes oficiales para estos trámites'}</h2><ul>{localizedPageSources[key].map(item=><li><a class="inline-link" href={item.url} target="_blank" rel="noopener">{item.label}</a></li>)}</ul></section>}
{!treatment&&key!=='faq'&&<p class="source-link"><a class="inline-link" href={source} target="_blank" rel="noopener">{d.source}</a></p>}
{key==='treatments'&&<OutcomeEvidence locale={locale}/>}
{key==='guides/quotation'&&<QuotationChecklist locale={locale}/>}
{key==='privacy'&&<EngagementNotice locale={locale}/>}
<section class="localized-related"><h2>{d.related}</h2><div class="hub-grid">{links.map(route=><a class="hub-card" href={href(route)}><h3>{pageInfo(locale,route).title}</h3><p>{pageInfo(locale,route).description}</p></a>)}</div><a class="button" href={href('contact')+(consultationTopic?'?topic='+consultationTopic:'')}>{d.contact}</a></section><p class="caption">{d.checked}</p>
</div>}
<script>
function reveal(){const id=location.hash.slice(1);const el=document.getElementById(id);if(el instanceof HTMLDetailsElement){el.open=true;requestAnimationFrame(()=>el.scrollIntoView({block:'start'}))}}reveal();addEventListener('hashchange',reveal);document.querySelectorAll<HTMLAnchorElement>('.faq-index a').forEach(a=>a.addEventListener('click',()=>{const el=document.getElementById(a.hash.slice(1));if(el instanceof HTMLDetailsElement)el.open=true}));
</script>
</LocalizedLayout>
<style>.home-decisions{margin:60px 0}.localized-team,.localized-guides{margin:60px 0}.localized-team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.localized-team-grid img{width:100%;height:300px;object-fit:contain;background:var(--light)}.localized-team-grid h3{font-size:23px;margin-top:24px}.localized-team-grid p{font-size:15px}.localized-guides img{height:220px;width:100%;object-fit:cover;margin-bottom:22px}@media(max-width:650px){.localized-team-grid{grid-template-columns:1fr}.localized-team-grid img{max-height:300px}}.localized-content{max-width:1536px}.localized-section.about-opening{max-width:none}.about-gallery{margin:40px 0 70px}.localized-section{max-width:1050px;margin:0 0 45px;scroll-margin-top:24px}.localized-section h2{font-size:clamp(25px,2.5vw,34px)}.localized-section p,.treatment-main p{font-size:17px;line-height:1.95}.localized-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.localized-grid article{padding:30px;background:var(--light);min-width:0}.localized-grid h3{font-size:25px}.localized-compare{margin-bottom:65px}.localized-related{margin:55px 0}.localized-related .hub-card{min-width:0}.localized-related .hub-card h3{font-size:23px}.localized-related .hub-card p{font-size:16px}.quick-links{display:flex;flex-wrap:wrap;gap:12px 22px;margin-bottom:25px}.quick-links a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;text-decoration:underline;text-underline-offset:5px}.source-link{margin:25px 0 40px}.localized-content>figure{max-width:850px;margin:40px 0}.localized-content>figure img{max-height:450px;object-fit:cover}.faq details{scroll-margin-top:24px}@media(max-width:650px){.localized-grid{grid-template-columns:1fr}.localized-grid article{padding:24px}.localized-section p,.treatment-main p{font-size:16px}.localized-related .hub-grid{grid-template-columns:1fr;gap:20px}.localized-content .faq-index{grid-template-columns:1fr}}</style>
