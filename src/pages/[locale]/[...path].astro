---
import LocalizedLayout from '../../layouts/LocalizedLayout.astro';
import HeroCarousel from '../../components/HeroCarousel.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import LocalizedBudget from '../../components/LocalizedBudget.astro';
import LocalizedConsultation from '../../components/LocalizedConsultation.astro';
import { dictionaries,routeKeys,pageInfo,pageHref,treatmentSlugs } from '../../i18n';
import { hero } from '../../i18n/hero';
import { treatments } from '../../data/treatments';
import { faqs } from '../../data/faq';
export function getStaticPaths(){return (['en','ja'] as const).flatMap(locale=>routeKeys.map(key=>({params:{locale,path:key||undefined},props:{locale,key}})))}
const {locale,key}=Astro.props;const d=dictionaries[locale],page=pageInfo(locale,key);const href=(route='')=>pageHref(locale,route);const isHome=key==='';const treatmentIndex=treatmentSlugs.indexOf(key.replace('treatments/',''));const treatment=key.startsWith('treatments/')&&treatmentIndex>=0?d.treatments[treatmentIndex]:null;const original=treatment?treatments[treatmentIndex]:null;
const links=key==='guides'?['guides/first-visit','guides/ivf-steps','guides/quotation','guides/egg-freezing','guides/travel-checklist','guides/family-planning']:key==='process'?['guides/first-visit','fees','guides/travel-checklist','service-scope']:key==='birth-planning'?['faq','guides/family-planning','contact']:['treatments','fees','process','guides/first-visit'];
const source=key==='team'?'https://www.saipan-ivf.com/Resources/':key==='birth-planning'?'https://fam.state.gov/FAM/08FAM/08FAM030202.html':key==='guides/ivf-steps'||key==='process'?'https://www.nhs.uk/tests-and-treatments/ivf/':key==='guides/egg-freezing'?'https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/':'https://www.saipan-ivf.com/';
const profileIds=['gary-ramsey','irena-lalic','rose-wang'];
---
<LocalizedLayout locale={locale} key={key} title={page.title} description={page.description} home={isHome}>
{isHome&&<HeroCarousel {...hero(locale)}/>}
{key==='contact'?<LocalizedConsultation locale={locale}/>:<div class="section wrap localized-content">
{key==='fees'&&<LocalizedBudget locale={locale}/>}
{(isHome||key==='treatments')&&<section class="localized-compare"><h2>{d.nav[1]}</h2><div class="localized-grid">{d.treatments.map((item,i)=><article><h3><a href={href('treatments/'+treatmentSlugs[i])}>{item.title}</a></h3><p>{item.summary}</p><p class="treatment-price">${[15000,1800,9000,4500][i].toLocaleString('en-US')} USD</p><p class="caption">{d.budgetNote}</p><a class="inline-link" href={href('treatments/'+treatmentSlugs[i])+'#costs'}>{d.nav[4]}</a></article>)}</div></section>}
{treatment&&<div class="treatment-detail"><div class="treatment-main"><nav class="quick-links" aria-label={d.related}><a href="#decision">{d.nav[1]}</a><a href="#costs">{d.nav[4]}</a><a href="#steps">{d.steps}</a><a href="#prepare">{d.prepare}</a></nav><ResponsiveImage class="treatment-photo" src={'/images/stock/'+original.image+'.webp'} alt={treatment.title} width="1000" height="650" fetchpriority="high"/><section id="decision"><h2>{treatment.title}</h2><p>{treatment.summary}</p><p>{treatment.suitable}</p></section><section id="steps"><h2>{d.steps}</h2><ol>{treatment.stages.map(step=><li>{step}</li>)}</ol><a class="inline-link" href={href('process')}>{d.nav[3]}</a></section><section id="costs"><h2>{d.nav[4]}</h2><p class="treatment-price">${[15000,1800,9000,4500][treatmentIndex].toLocaleString('en-US')} USD</p><dl class="service-scope"><div><dt>{d.included}</dt><dd>{treatment.included}</dd></div><div><dt>{d.excluded}</dt><dd>{treatment.excluded}</dd></div></dl><p>{d.budgetNote}</p><a class="inline-link" href={href('fees')}>{d.fees}</a></section><section id="risks"><h2>{d.risk}</h2><p>{treatment.risk}</p></section><section id="prepare"><h2>{d.questions}</h2><ul>{treatment.questions.map(q=><li>{q}</li>)}</ul><a class="inline-link" href={original.source} target="_blank" rel="noopener">HFEA · {d.source}</a></section></div><aside class="treatment-aside"><h2>{d.prepare}</h2><p>{d.pages['guides/first-visit'].description}</p><a class="button" href={href('contact')+'?topic='+treatmentSlugs[treatmentIndex]}>{d.contact}</a><nav aria-label={d.related}><a href={href('fees')}>{d.fees}</a><a href={href('process')}>{d.nav[3]}</a><a href={href('treatments')}>{d.nav[1]}</a></nav></aside></div>}
{key==='faq'&&<><nav class="faq-index" aria-label={d.nav[8]}>{d.faq.map((item,i)=><a href={'#'+faqs[i].id}>{item[0]}</a>)}</nav><div class="faq">{d.faq.map((item,i)=><details id={faqs[i].id} open={i===0}><summary>{item[0]}</summary><p class="faq-answer"><strong>{item[1]}</strong></p><p>{item[2]}</p><a class="inline-link" href={faqs[i].source.startsWith('/')?'/'+locale+faqs[i].source:faqs[i].source} target={faqs[i].source.startsWith('/')?undefined:'_blank'} rel="noopener">{d.source}</a></details>)}</div></>}
{page.sections.map(([title,text],i)=><section class="localized-section" id={key==='team'&&i<3?profileIds[i]:key==='process'&&i===5?'follow-up':'section-'+i}><h2>{title}</h2><p>{text}</p>{isHome&&<a class="inline-link" href={href(['treatments','team','process','faq'][i])}>{d.read}</a>}</section>)}
{isHome&&<section class="localized-team"><h2>{d.nav[2]}</h2><div class="localized-team-grid">{['gary','irena','rose'].map((image,i)=><a href={href('team')+'#'+profileIds[i]}><ResponsiveImage src={'/images/official/'+image+'.webp'} alt={['Gary G. Ramsey, M.D.','Irena Lalic','Rose Wang'][i]} width={i===0?480:250} height={i===0?720:347} loading="lazy"/><h3>{['Gary G. Ramsey, M.D.','Irena Lalic','Rose Wang'][i]}</h3><p>{d.pages.team.sections[i][1]}</p></a>)}</div><p class="caption"><a href="https://www.saipan-ivf.com/Resources/" target="_blank" rel="noopener">{d.source} · Saipan IVF Center</a></p></section>}
{isHome&&<section class="localized-guides"><h2>{d.nav[5]}</h2><div class="hub-grid">{['first-visit','ivf-steps','quotation','egg-freezing','travel-checklist','family-planning'].map((slug,i)=><a class="hub-card" href={href('guides/'+slug)}><ResponsiveImage src={'/images/stock/'+['notebook-wood','microscope-focus','budget-documents','fern-light','wing-clouds','baby-shoes'][i]+'.webp'} alt={pageInfo(locale,'guides/'+slug).title} width="640" height="400" loading="lazy"/><h3>{pageInfo(locale,'guides/'+slug).title}</h3><p>{pageInfo(locale,'guides/'+slug).description}</p></a>)}</div></section>}
{key==='about'&&<figure><ResponsiveImage src="/images/official/center.webp" alt={d.pages.about.title} width="900" height="600" loading="lazy"/><figcaption>{d.source} · <a href="https://www.saipan-ivf.com/">Saipan IVF Center</a></figcaption></figure>}
{!treatment&&key!=='faq'&&<p class="source-link"><a class="inline-link" href={source} target="_blank" rel="noopener">{d.source}</a></p>}
<section class="localized-related"><h2>{d.related}</h2><div class="hub-grid">{links.map(route=><a class="hub-card" href={href(route)}><h3>{pageInfo(locale,route).title}</h3><p>{pageInfo(locale,route).description}</p></a>)}</div><a class="button" href={href('contact')}>{d.contact}</a></section><p class="caption">{d.checked}</p>
</div>}
<script>
function reveal(){const id=location.hash.slice(1);const el=document.getElementById(id);if(el instanceof HTMLDetailsElement){el.open=true;requestAnimationFrame(()=>el.scrollIntoView({block:'start'}))}}reveal();addEventListener('hashchange',reveal);document.querySelectorAll<HTMLAnchorElement>('.faq-index a').forEach(a=>a.addEventListener('click',()=>{const el=document.getElementById(a.hash.slice(1));if(el instanceof HTMLDetailsElement)el.open=true}));
</script>
</LocalizedLayout>
<style>.localized-team,.localized-guides{margin:60px 0}.localized-team-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px}.localized-team-grid img{width:100%;height:300px;object-fit:contain;background:var(--light)}.localized-team-grid h3{font-size:23px;margin-top:24px}.localized-team-grid p{font-size:15px}.localized-guides img{height:220px;width:100%;object-fit:cover;margin-bottom:22px}@media(max-width:650px){.localized-team-grid{grid-template-columns:1fr}.localized-team-grid img{max-height:300px}}.localized-content{max-width:1536px}.localized-section{max-width:1050px;margin:0 0 45px;scroll-margin-top:24px}.localized-section h2{font-size:clamp(25px,2.5vw,34px)}.localized-section p,.treatment-main p{font-size:17px;line-height:1.95}.localized-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.localized-grid article{padding:30px;background:var(--light);min-width:0}.localized-grid h3{font-size:25px}.localized-compare{margin-bottom:65px}.localized-related{margin:55px 0}.localized-related .hub-card{min-width:0}.localized-related .hub-card h3{font-size:23px}.localized-related .hub-card p{font-size:16px}.quick-links{display:flex;flex-wrap:wrap;gap:12px 22px;margin-bottom:25px}.quick-links a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;text-decoration:underline;text-underline-offset:5px}.source-link{margin:25px 0 40px}.localized-content>figure{max-width:850px;margin:40px 0}.localized-content>figure img{max-height:450px;object-fit:cover}.faq details{scroll-margin-top:24px}@media(max-width:650px){.localized-grid{grid-template-columns:1fr}.localized-grid article{padding:24px}.localized-section p,.treatment-main p{font-size:16px}.localized-related .hub-grid{grid-template-columns:1fr;gap:20px}.localized-content .faq-index{grid-template-columns:1fr}}</style>
