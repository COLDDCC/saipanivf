---
import ResponsiveImage from "../components/ResponsiveImage.astro";
import '../styles/site.css';
import { site } from '../data/site';
const {title,description,active='',home=false,plainHead=false,noindex=false}=Astro.props;
const nav=[["about", "关于中心"], ["treatments", "治疗项目"], ["team", "医疗团队"], ["process", "IVF流程"], ["fees", "费用预算"], ["guides", "就诊指南"], ["birth-planning", "赴美生育"], ["contact", "联系咨询"]];
const heads={"about": ["/images/stock/leaves-oak.webp", "阳光下的绿叶"], "team": ["/images/stock/medical-hands.webp", "手持听诊器的近景"], "treatments": ["/images/stock/lab-tubes.webp", "实验室试管"], "process": ["/images/stock/planner-white.webp", "白色计划本"], "fees": ["/images/stock/calculator-glasses.webp", "计算器与记录本"], "guides": ["/images/stock/weekly-planner.webp", "每周计划本"], "contact": ["/images/stock/notebook-pen.webp", "书写咨询记录"], "birth-planning": ["/images/stock/father-hands.webp", "双手捧着婴儿鞋"], "faq": ["/images/stock/planner-desk.webp", "桌上的笔记本与信封"], "guides/first-visit": ["/images/stock/planner-calendar.webp", "笔记本与钢笔"], "guides/ivf-steps": ["/images/stock/microscope-stage.webp", "显微镜近景"], "guides/quotation": ["/images/stock/planner-light.webp", "自然光下的记录本"], "guides/egg-freezing": ["/images/stock/leaves-green.webp", "阳光下的植物"], "guides/travel-checklist": ["/images/stock/luggage-cabin.webp", "机舱中的行李"], "guides/family-planning": ["/images/stock/graph-notebook.webp", "用于规划的方格记录本"]};
const pageKey=Astro.url.pathname.replace(/^\/|\/$/g,'');
const headImage=heads[pageKey]||heads[active]||heads.guides;
const canonical=new URL(Astro.url.pathname,site.origin);
const shareImage=new URL('/images/share-card.png',site.origin).href;
const section=pageKey.startsWith('guides/')?{name:'就诊指南',path:'/guides/'}:pageKey.startsWith('treatments/')?{name:'治疗项目',path:'/treatments/'}:null;
const crumbs=[{name:'首页',path:'/'},...(section?[section]:[]),...(!home?[{name:title,path:Astro.url.pathname}]:[])];
const structuredData={
 '@context':'https://schema.org','@graph':[
 {'@type':'WebSite','@id':site.origin+'/#website',url:site.origin+'/',name:site.name,inLanguage:'zh-CN'},
 {'@type':'WebPage','@id':canonical.href+'#webpage',url:canonical.href,name:title,description,inLanguage:'zh-CN',isPartOf:{'@id':site.origin+'/#website'}},
 ...(!home?[{'@type':'BreadcrumbList',itemListElement:crumbs.map((crumb,i)=>({'@type':'ListItem',position:i+1,name:crumb.name,item:new URL(crumb.path,site.origin).href}))}]:[])
 ]
};
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · 塞班生殖中心</title><meta name="description" content={description}/>{noindex&&<meta name="robots" content="noindex,follow"/>}<link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48"/><meta name="theme-color" content="#174e5b"/><meta property="og:type" content="website"/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical.href}/><meta property="og:image" content={shareImage}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Saipan IVF · 试管婴儿、冻卵与中文就诊指南"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={shareImage}/><script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/><noscript><style>@media(max-width:900px){.nav{display:flex!important;position:static!important;flex-wrap:wrap}.menu-button{display:none!important}.header{flex-wrap:wrap}}</style></noscript></head><body><a class="skip-link" href="#main-content">跳到正文</a>
<header class="header"><a class="brand" href="/" aria-label="塞班生殖中心首页">Saipan IVF<small>塞班生殖中心</small></a><button class="menu-button" aria-controls="main-nav" aria-expanded="false" id="menu-btn">菜单</button><nav class="nav" id="main-nav" aria-label="主要导航"><a href="/about/" aria-current={active==='about'?'page':undefined}>关于中心</a><a href="/treatments/" aria-current={active==='treatments'?'page':undefined}>治疗项目</a><a href="/team/" aria-current={active==='team'?'page':undefined}>医疗团队</a><details class="nav-group"><summary>就诊须知</summary><div><a href="/process/">IVF流程</a><a href="/fees/">费用预算</a><a href="/birth-planning/">赴美生育</a><a href="/guides/">就诊指南</a><a href="/faq/">常见问题</a><a href="/service-scope/">预约与服务范围</a></div></details><a class="nav-contact" href="/contact/" aria-current={active==='contact'?'page':undefined}>联系咨询</a></nav></header>
{!home&&<div class:list={["page-head",{"page-head-plain":plainHead}]}><div class="page-head-copy"><nav class="breadcrumbs" aria-label="面包屑"><a href="/">首页</a><span> / </span>{section&&<><a href={section.path}>{section.name}</a><span> / </span></>}<span aria-current="page">{title}</span></nav><h1>{title}</h1><p>{description}</p></div>{!plainHead&&<ResponsiveImage src={headImage[0]} alt={headImage[1]} width="900" height="600"  fetchpriority="high"/>}</div>}
<main id="main-content" tabindex="-1"><slot/></main>
<footer class="footer"><div class="footer-top"><div><h2>从一次咨询开始，<br/>规划你的生育计划。</h2><a class="button light" href="/contact/">提交初步咨询表单</a></div><div class="footer-contact"><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a><p>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</p><a href="https://www.saipan-ivf.com/" target="_blank" rel="noopener">接诊机构官网</a></div></div><nav class="footer-nav" aria-label="页脚导航">{nav.map(([slug,label])=><a href={`/${slug}/`}>{label}</a>)}<a href="/faq/">常见问题</a><a href="/service-scope/">预约与服务范围</a><a href="/editorial-policy/">内容与资料来源</a><a href="/privacy/">隐私与使用说明</a></nav><div class="footer-wordmark" aria-hidden="true">Saipan IVF</div><div class="footer-bottom">© 2026 Saipan IVF · 生育咨询与就诊协调。医疗方案及费用以个人评估和书面报价为准。<a href="/editorial-policy/">资料与图片来源</a></div></footer>{!home&&active!=='contact'&&<a class="floating" href="/contact/">联系咨询</a>}<script>
const menu=document.getElementById("menu-btn"),nav=document.getElementById("main-nav");menu.addEventListener("click",()=>{let open=nav.classList.toggle("open");menu.setAttribute("aria-expanded",String(open))});nav.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{nav.classList.remove("open");menu.setAttribute("aria-expanded","false")}));
document.addEventListener("keydown",event=>{if(event.key==="Escape"&&nav.classList.contains("open")){nav.classList.remove("open");menu.setAttribute("aria-expanded","false");menu.focus()}});
document.addEventListener('click',event=>{if(nav.classList.contains('open')&&!nav.contains(event.target as Node)&&!menu.contains(event.target as Node)){nav.classList.remove('open');menu.setAttribute('aria-expanded','false')}});
const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
if(!reduced.matches&&'IntersectionObserver' in window){
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){const node=entry.target as HTMLElement;node.animate([{opacity:.55,transform:'translateY(22px)'},{opacity:1,transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.2,.7,.2,1)'});observer.unobserve(node)}}},{threshold:.08});
 document.querySelectorAll('main .section-head,main .image-frame,main .center-photo,main .person-card,main .visit-card,main .budget-photo,main .guide-card,main .birth-banner,main .service,main .benefit').forEach(el=>observer.observe(el));
}
document.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach(group=>{document.addEventListener('click',e=>{if(!group.contains(e.target as Node))group.open=false});group.addEventListener('keydown',e=>{if(e.key==='Escape'){group.open=false;group.querySelector('summary')?.focus()}})});
</script></body></html>
