---
import '../styles/site.css';
const {title,description,active='',home=false}=Astro.props;
const nav=[["about", "关于中心"], ["treatments", "治疗项目"], ["team", "医疗团队"], ["process", "IVF流程"], ["fees", "费用预算"], ["guides", "就诊指南"], ["birth-planning", "赴美生育"], ["contact", "联系咨询"]];
const heads={about:['/images/official/center.webp','塞班Garapan的Bank of Guam楼宇'],team:['/images/official/gary.webp','Gary G. Ramsey'],treatments:['/images/scenes/laboratory-care.webp','辅助生殖实验室'],process:['/images/scenes/care-consultation.webp','就诊沟通'],fees:['/images/scenes/couple-editorial.webp','生育计划沟通'],guides:['/images/scenes/quiet-botanical.webp','植物与自然光'],contact:['/images/scenes/care-consultation.webp','医疗咨询'],'birth-planning':['/images/scenes/family-moment.webp','家庭生活']};
const headImage=heads[active]||heads.guides;
const canonical=new URL(Astro.url.pathname,'https://saipanivf.pages.dev');
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · 塞班生殖中心</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/></head><body>
<header class="header"><a class="brand" href="/" aria-label="塞班生殖中心首页">Saipan IVF<small>塞班生殖中心</small></a><button class="menu-button" aria-controls="main-nav" aria-expanded="false" id="menu-btn">菜单</button><nav class="nav" id="main-nav" aria-label="主要导航"><a href="/about/" aria-current={active==='about'?'page':undefined}>关于中心</a><a href="/treatments/" aria-current={active==='treatments'?'page':undefined}>治疗项目</a><a href="/team/" aria-current={active==='team'?'page':undefined}>医疗团队</a><details class="nav-group"><summary>就诊须知</summary><div><a href="/process/">IVF流程</a><a href="/fees/">费用预算</a><a href="/birth-planning/">赴美生育</a><a href="/guides/">就诊指南</a><a href="/faq/">常见问题</a></div></details><a class="nav-contact" href="/contact/" aria-current={active==='contact'?'page':undefined}>联系咨询</a></nav></header>
{!home&&<div class="page-head"><div class="page-head-copy"><div class="breadcrumbs"><a href="/">首页</a><span> / </span>{title}</div><h1>{title}</h1><p>{description}</p></div><img src={headImage[0]} alt={headImage[1]} width="900" height="600" class:list={{'is-portrait':active==='team'}} fetchpriority="high"/></div>}
<main><slot/></main>
<footer class="footer"><div class="footer-top"><div><h2>从一次咨询开始，<br/>规划你的生育计划。</h2><a class="button light" href="/contact/">提交初步咨询表单</a></div><div class="footer-contact"><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a><p>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</p><a href="https://www.saipan-ivf.com/" target="_blank" rel="noopener">接诊机构官网</a></div></div><nav class="footer-nav" aria-label="页脚导航">{nav.map(([slug,label])=><a href={`/${slug}/`}>{label}</a>)}</nav><div class="footer-wordmark" aria-hidden="true">Saipan IVF</div><div class="footer-bottom">© 2026 Saipan IVF · 本站提供项目介绍与就诊协调。医疗方案由接诊医生制定，费用以院方书面报价为准；不承诺治疗结果、入境许可或公民身份。图片与团队资料来源见接诊机构官网。</div></footer><a class="floating" href="/contact/">联系咨询</a><script>
const menu=document.getElementById("menu-btn"),nav=document.getElementById("main-nav");menu.addEventListener("click",()=>{let open=nav.classList.toggle("open");menu.setAttribute("aria-expanded",String(open))});nav.querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{nav.classList.remove("open");menu.setAttribute("aria-expanded","false")}));
document.addEventListener("keydown",event=>{if(event.key==="Escape"&&nav.classList.contains("open")){nav.classList.remove("open");menu.setAttribute("aria-expanded","false");menu.focus()}});
const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
if(!reduced.matches&&'IntersectionObserver' in window){
 const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){const node=entry.target as HTMLElement;node.animate([{opacity:.55,transform:'translateY(22px)'},{opacity:1,transform:'translateY(0)'}],{duration:650,easing:'cubic-bezier(.2,.7,.2,1)'});observer.unobserve(node)}}},{threshold:.08});
 document.querySelectorAll('main .section-head,main .image-frame,main .center-photo,main .person-card,main .visit-card,main .budget-photo,main .guide-card,main .birth-banner,main .service,main .benefit').forEach(el=>observer.observe(el));
}
document.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach(group=>{document.addEventListener('click',e=>{if(!group.contains(e.target as Node))group.open=false});group.addEventListener('keydown',e=>{if(e.key==='Escape'){group.open=false;group.querySelector('summary')?.focus()}})});
</script></body></html>
