---
import { websiteSchema, shareLocales } from "../data/website-schema";
import { searchMetadata } from "../data/search-metadata";
import '../styles/site.css';
import '../styles/refinement.css';
import MainNavigation from '../components/MainNavigation.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { dictionaries,pageHref } from '../i18n';
const {locale,key,title,description,home=false}=Astro.props;
const search=searchMetadata(locale,key);
const searchTitle=search?.[0]??title,searchDescription=search?.[1]??description;
const d=dictionaries[locale];const href=(route='')=>pageHref(locale,route);
const origin='https://saipanivf.pages.dev';const route=href(key);const canonical=origin+route;
const paths=['about','treatments','team','process','fees','guides','birth-planning','contact','faq','service-scope','editorial-policy','privacy'];
const images={about:['leaves-oak','Sunlit leaves'],team:['medical-hands','A hand holding a stethoscope'],treatments:['lab-tubes','Laboratory tubes'],process:['planner-white','An appointment notebook'],fees:['calculator-glasses','A calculator and notes'],guides:['weekly-planner','A weekly planner'],contact:['notebook-pen','Writing consultation questions'],'birth-planning':['father-hands','Hands holding baby shoes'],faq:['planner-desk','A notebook and envelopes'],'guides/first-visit':['planner-calendar','A notebook and pen'],'guides/ivf-steps':['microscope-stage','A laboratory microscope'],'guides/quotation':['planner-light','A planning notebook'],'guides/egg-freezing':['leaves-green','Green leaves'],'guides/travel-checklist':['luggage-cabin','Luggage in an aircraft cabin'],'guides/family-planning':['graph-notebook','A squared notebook']};
const image=images[key];
const section=key.startsWith('guides/')?{name:d.pages.guides.title,path:'guides'}:key.startsWith('treatments/')?{name:d.pages.treatments.title,path:'treatments'}:null;
const crumbs=[{name:d.home,path:''},...(section?[section]:[]),...(!home?[{name:title,path:key}]:[])];
const shareLocale=locale==='de'?'de_DE':locale==='es'?'es_ES':locale==='ja'?'ja_JP':locale==='ko'?'ko_KR':'en_US';
const schema={'@context':'https://schema.org','@graph':[websiteSchema,{'@type':'WebPage',url:canonical,'@id':canonical+'#webpage',name:searchTitle,description:searchDescription,inLanguage:locale,isPartOf:{'@id':websiteSchema['@id']}},...(!home?[{'@type':'BreadcrumbList',itemListElement:crumbs.map((crumb,i)=>({'@type':'ListItem',position:i+1,name:crumb.name,item:origin+href(crumb.path)}))}]:[])]};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{searchTitle} · {d.name}</title><meta name="description" content={searchDescription}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"/><link rel="canonical" href={canonical}/>{[['zh-CN',''],['zh-TW','/zh-hant'],['en','/en'],['ja','/ja'],['ko','/ko'],['es','/es'],['de','/de'],['x-default','']].map(([lang,prefix])=><link rel="alternate" hreflang={lang} href={origin+prefix+'/'+(key?key+'/':'')}/>)}<link rel="icon" href="/favicon.svg?v=baby-2" type="image/svg+xml"/><link rel="icon" href="/favicon-48.png?v=baby-2" type="image/png" sizes="48x48"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/><meta name="theme-color" content="#1767a6"/><meta property="og:type" content="website"/><meta property="og:locale" content={shareLocale}/>{shareLocales.filter(code=>code!==shareLocale).map(code=><meta property="og:locale:alternate" content={code}/>)}<meta property="og:site_name" content={websiteSchema.name}/><meta property="og:title" content={searchTitle}/><meta property="og:description" content={searchDescription}/><meta property="og:url" content={canonical}/><meta property="og:image" content={origin+'/images/share-card.png'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={searchTitle}/><meta name="twitter:description" content={searchDescription}/><meta name="twitter:image" content={origin+'/images/share-card.png'}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/><noscript><style>@media(max-width:800px){.nav{display:flex!important;position:static!important;flex-wrap:wrap}.menu-button{display:none!important}.header{flex-wrap:wrap}}</style></noscript><script is:inline src="/engagement.js" defer></script>
</head><body><a class="skip-link" href="#main-content">{d.skip}</a><header class="header"><a class="brand" href={href()} aria-label={d.home}><img class="brand-symbol" src="/logo-baby.svg" width="48" height="48" alt="" aria-hidden="true"/><span class="brand-wordmark">Saipan IVF<small>{d.subtitle}</small></span></a><LanguageSwitcher/><button class="menu-button" id="menu-btn" aria-controls="main-nav" aria-expanded="false">{d.menu}</button><MainNavigation locale={locale} current={key}/></header>
{!home&&<div class:list={['page-head',{'page-head-plain':!image}]}><div class="page-head-copy"><nav class="breadcrumbs" aria-label={locale==='de'?'Brotkrümelnavigation':locale==='es'?'Ruta de navegación':locale==='ja'?'パンくず':locale==='ko'?'현재 위치':'Breadcrumb'}><a href={href()}>{d.home}</a><span> / </span>{section&&<><a href={href(section.path)}>{section.name}</a><span> / </span></>}<span aria-current="page">{title}</span></nav><h1>{title}</h1><p>{description}</p></div>{image&&<ResponsiveImage src={'/images/stock/'+image[0]+'.webp'} alt={locale==='ja'||locale==='ko'||locale==='es'||locale==='de'?title:image[1]} width="900" height="600" fetchpriority="high"/>}</div>}
<main id="main-content" tabindex="-1"><slot/></main><footer class="footer"><div class="footer-top"><div><h2>{d.footerTitle}</h2><p>{d.footerText}</p><a class="button light" href={href('contact')}>{d.contact}</a></div><div class="footer-contact"><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a><p>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</p><a href="https://www.saipan-ivf.com/" target="_blank" rel="noopener">{d.clinic}</a></div></div><nav class="footer-nav" aria-label={locale==='de'?'Fußnavigation':locale==='es'?'Navegación del pie de página':locale==='ja'?'フッターナビゲーション':locale==='ko'?'하단 메뉴':'Footer navigation'}>{paths.map((path,i)=><a href={href(path)}>{d.nav[i]}</a>)}</nav><div class="footer-wordmark" aria-hidden="true">Saipan IVF</div><div class="footer-bottom">© 2026 Saipan IVF · {d.footerNote}</div></footer><script>
const menu=document.getElementById('menu-btn'),nav=document.getElementById('main-nav');function close(){nav.classList.remove('open');menu.setAttribute('aria-expanded','false')}
menu.addEventListener('click',()=>{menu.setAttribute('aria-expanded',String(nav.classList.toggle('open')))});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&nav.classList.contains('open')){close();menu.focus()}});document.addEventListener('click',e=>{if(!nav.contains(e.target as Node)&&!menu.contains(e.target as Node))close()});
</script></body></html>
<style>.nav{gap:18px;font-size:14px}.header{gap:18px}.footer-top>div>p{color:#d5e6e9;max-width:38em}.brand small{font-size:12px}@media(min-width:801px) and (max-width:1200px){.nav{gap:12px;font-size:12px}.brand{font-size:24px}.header{padding-inline:25px;gap:12px}}@media(max-width:800px){.nav.open>a{min-height:44px;display:flex;align-items:center}}@media(max-width:420px){.brand{font-size:23px}.brand small{font-size:10px}.header{gap:8px}}</style>
