---
import '../styles/site.css';
import '../styles/refinement.css';
import MainNavigation from '../components/MainNavigation.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { dictionaries,pageHref } from '../i18n';
const {locale,key,title,description,home=false}=Astro.props;
const d=dictionaries[locale];const href=(route='')=>pageHref(locale,route);
const origin='https://saipanivf.pages.dev';const route=href(key);const canonical=origin+route;
const paths=['about','treatments','team','process','fees','guides','birth-planning','contact','faq','service-scope','editorial-policy','privacy'];
const images={about:['leaves-oak','Sunlit leaves'],team:['medical-hands','A hand holding a stethoscope'],treatments:['lab-tubes','Laboratory tubes'],process:['planner-white','An appointment notebook'],fees:['calculator-glasses','A calculator and notes'],guides:['weekly-planner','A weekly planner'],contact:['notebook-pen','Writing consultation questions'],'birth-planning':['father-hands','Hands holding baby shoes'],faq:['planner-desk','A notebook and envelopes'],'guides/first-visit':['planner-calendar','A notebook and pen'],'guides/ivf-steps':['microscope-stage','A laboratory microscope'],'guides/quotation':['planner-light','A planning notebook'],'guides/egg-freezing':['leaves-green','Green leaves'],'guides/travel-checklist':['luggage-cabin','Luggage in an aircraft cabin'],'guides/family-planning':['graph-notebook','A squared notebook']};
const image=images[key];
const schema={'@context':'https://schema.org','@graph':[{'@type':'WebSite','@id':origin+'/'+locale+'/#website',url:origin+'/'+locale+'/',name:d.name,inLanguage:locale},{'@type':'WebPage',url:canonical,'@id':canonical+'#webpage',name:title,description,inLanguage:locale,isPartOf:{'@id':origin+'/'+locale+'/#website'}},...(!home?[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:d.home,item:origin+href()},{'@type':'ListItem',position:2,name:title,item:canonical}]}]:[])]};
---
<!doctype html><html lang={locale}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · {d.name}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{[['zh-CN',''],['zh-TW','/zh-hant'],['en','/en'],['ja','/ja'],['ko','/ko'],['x-default','']].map(([lang,prefix])=><link rel="alternate" hreflang={lang} href={origin+prefix+'/'+(key?key+'/':'')}/>)}<link rel="icon" href="/favicon.svg?v=baby-2" type="image/svg+xml"/><link rel="icon" href="/favicon-48.png?v=baby-2" type="image/png" sizes="48x48"/><link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180"/><meta name="theme-color" content="#1767a6"/><meta property="og:type" content="website"/><meta property="og:locale" content={locale==='ja'?'ja_JP':locale==='ko'?'ko_KR':'en_US'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={origin+'/images/share-card.png'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={origin+'/images/share-card.png'}/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\\u003c')}/><noscript><style>@media(max-width:800px){.nav{display:flex!important;position:static!important;flex-wrap:wrap}.menu-button{display:none!important}.header{flex-wrap:wrap}}</style></noscript></head><body><a class="skip-link" href="#main-content">{d.skip}</a><header class="header"><a class="brand" href={href()} aria-label={d.home}><img class="brand-symbol" src="/logo-baby.svg" width="48" height="48" alt="" aria-hidden="true"/><span class="brand-wordmark">Saipan IVF<small>{d.subtitle}</small></span></a><LanguageSwitcher/><button class="menu-button" id="menu-btn" aria-controls="main-nav" aria-expanded="false">{d.menu}</button><MainNavigation locale={locale} current={key}/></header>
{!home&&<div class:list={['page-head',{'page-head-plain':!image}]}><div class="page-head-copy"><nav class="breadcrumbs" aria-label={locale==='ja'?'パンくず':locale==='ko'?'현재 위치':'Breadcrumb'}><a href={href()}>{d.home}</a><span> / </span><span aria-current="page">{title}</span></nav><h1>{title}</h1><p>{description}</p></div>{image&&<ResponsiveImage src={'/images/stock/'+image[0]+'.webp'} alt={locale==='ja'||locale==='ko'?title:image[1]} width="900" height="600" fetchpriority="high"/>}</div>}
<main id="main-content" tabindex="-1"><slot/></main><footer class="footer"><div class="footer-top"><div><h2>{d.footerTitle}</h2><p>{d.footerText}</p><a class="button light" href={href('contact')}>{d.contact}</a></div><div class="footer-contact"><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a><p>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</p><a href="https://www.saipan-ivf.com/" target="_blank" rel="noopener">{d.clinic}</a></div></div><nav class="footer-nav" aria-label={locale==='ja'?'フッターナビゲーション':locale==='ko'?'하단 메뉴':'Footer navigation'}>{paths.map((path,i)=><a href={href(path)}>{d.nav[i]}</a>)}</nav><div class="footer-wordmark" aria-hidden="true">Saipan IVF</div><div class="footer-bottom">© 2026 Saipan IVF · {d.footerNote}</div></footer><script>
const menu=document.getElementById('menu-btn'),nav=document.getElementById('main-nav');function close(){nav.classList.remove('open');menu.setAttribute('aria-expanded','false')}
menu.addEventListener('click',()=>{menu.setAttribute('aria-expanded',String(nav.classList.toggle('open')))});nav.querySelectorAll('a').forEach(a=>a.addEventListener('click',close));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&nav.classList.contains('open')){close();menu.focus()}});document.addEventListener('click',e=>{if(!nav.contains(e.target as Node)&&!menu.contains(e.target as Node))close()});
</script></body></html>
<style>.nav{gap:18px;font-size:14px}.header{gap:18px}.footer-top>div>p{color:#d5e6e9;max-width:38em}.brand small{font-size:12px}@media(min-width:801px) and (max-width:1200px){.nav{gap:12px;font-size:12px}.brand{font-size:24px}.header{padding-inline:25px;gap:12px}}@media(max-width:800px){.nav.open>a{min-height:44px;display:flex;align-items:center}}@media(max-width:420px){.brand{font-size:23px}.brand small{font-size:10px}.header{gap:8px}}</style>
