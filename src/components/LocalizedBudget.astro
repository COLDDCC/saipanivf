---
import ItemizedBudget from './ItemizedBudget.astro';
import { usdRange } from '../i18n/money';
import { dictionaries } from '../i18n';
import { pricing } from '../data/pricing';
import { chineseBudget } from '../data/chinese-budget';
import { budgetEvidence } from '../i18n/budget-evidence';
const {locale='zh-CN'}=Astro.props;
const chinese=locale==='zh-CN';const d=chinese?null:dictionaries[locale];
const b=chinese?chineseBudget:d.budget;
const c=budgetEvidence[locale];
const note=chinese?'项目参考预算 · USD；按一次服务或周期计，保存费按年计。':d.budgetNote;
const ids=['medication','anesthesia','icsi','freeze','fet','pgt','storage'];
const entries=ids.map(id=>pricing.find(row=>row.id===id)!);
const ranges=entries.map(row=>[row.min,row.max]);
const base=Object.fromEntries(['ivf','egg','fet'].map(id=>[id,pricing.find(row=>row.id===id)!.min]));
const labelById={consult:b.consult,assessment:b.assessment,ivf:b.paths[0],egg:b.paths[1],...Object.fromEntries(ids.map((id,i)=>[id,b.labels[i]]))};
const rows=pricing.map(row=>({label:labelById[row.id],amount:usdRange(row.min,row.max,locale),...(chinese?{note:row.note}:{})}));
const initial=pricing.filter(row=>['ivf','medication','anesthesia','icsi','freeze','fet'].includes(row.id));
const initialDescription=[b.paths[0],...b.labels.slice(0,5)].join(' + ');
const initialMin=initial.reduce((sum,row)=>sum+row.min,0),initialMax=initial.reduce((sum,row)=>sum+row.max,0);

---
<section id="budget-planner" class="localized-budget" data-budget data-config={JSON.stringify({b,note,locale,ids,ranges,base})}><h2>{b.title}</h2><p>{c[4]}</p><div class="estimator"><div><label class="field">{b.path}<select id="budget-path">{['ivf','egg','fet'].map((id,i)=><option value={id}>{b.paths[i]}</option>)}</select></label><div class="budget-options">{ids.map((id,i)=><label data-option={id}><input type="checkbox" value={id} checked={i<5}/><span>{b.labels[i]}</span></label>)}</div></div><div class="budget-result"><output id="budget-total" aria-live="polite">{usdRange(initialMin,initialMax,locale)}</output><p id="budget-description">{initialDescription}</p><p>{b.excluded}</p><p>{b.warning}</p><button type="button" id="budget-copy" class="button">{b.copy}</button><p id="budget-status" role="status"></p></div></div><details class="itemized" id="itemized-costs"><summary>{b.table}</summary><ItemizedBudget rows={rows} columns={chinese?b.columns:b.columns.slice(0,2)} caption={note} label={b.table}/></details></section>
<script>
const root=document.querySelector<HTMLElement>('[data-budget]');if(root){const {b,note,locale,ids,ranges,base}=JSON.parse(root.dataset.config!);const path=root.querySelector<HTMLSelectElement>('#budget-path')!;const inputs=[...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];const total=root.querySelector('#budget-total')!,description=root.querySelector('#budget-description')!,status=root.querySelector('#budget-status')!;const format=(n:number)=>n.toLocaleString(locale==='fr'?'fr-FR':['de','es'].includes(locale)?'de-DE':'en-US');function update(){let min=base[path.value],max=min;const selected=[b.paths[['ivf','egg','fet'].indexOf(path.value)]];inputs.forEach((input,i)=>{const eligible=path.value==='ivf'||path.value==='egg'&&['medication','anesthesia','storage'].includes(ids[i])||path.value==='fet'&&ids[i]==='storage';input.disabled=!eligible;(input.closest('label') as HTMLElement).hidden=!eligible;if(eligible&&input.checked){min+=ranges[i][0];max+=ranges[i][1];selected.push(b.labels[i])}});total.textContent=(['es','de','fr'].includes(locale)?'':'$')+format(min)+(max===min?'':'–'+format(max))+(['es','de','fr'].includes(locale)?' USD':'');description.textContent=selected.join(' + ');status.textContent=''}path.addEventListener('change',update);inputs.forEach(i=>i.addEventListener('change',update));root.querySelector('#budget-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(note+'\n'+description.textContent+'\n'+total.textContent+'\n'+b.excluded);status.textContent=b.copied}catch{status.textContent=b.failed}});update()}
</script>
<style>.localized-budget{margin-bottom:55px}.estimator{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:35px;background:var(--deep);color:white;padding:35px;margin:30px 0}.estimator>*{min-width:0}.estimator .field{font-size:17px}.estimator select{min-height:52px;width:100%;font-size:16px;padding:14px;background:white;color:var(--ink);border:0}.budget-options{display:grid;gap:10px;margin-top:25px}.budget-options label{display:flex;gap:12px;align-items:flex-start;min-height:44px;line-height:1.7}.budget-options label[hidden]{display:none}.budget-options input{width:20px;height:20px;margin-top:4px;flex-shrink:0}.budget-result{background:var(--cream);color:var(--ink);padding:28px}.budget-result output{display:block;font-size:clamp(27px,3.3vw,46px);line-height:1.4;overflow-wrap:anywhere}.budget-result p{font-size:15px}.budget-result .button{width:100%}.itemized{background:var(--light);padding:25px}.itemized summary{font-size:20px;line-height:1.7}.table-scroll{overflow-x:auto;margin-top:20px}.table-scroll table{width:100%;min-width:420px;border-collapse:collapse}.table-scroll td,.table-scroll th{padding:16px;text-align:left;border-bottom:1px solid #c7d8d9;line-height:1.8}.table-scroll caption{text-align:left;font-size:14px;margin-bottom:15px}.table-scroll:focus-visible{outline:3px solid var(--blue);outline-offset:4px}@media(max-width:750px){.estimator{grid-template-columns:1fr;padding:24px;gap:24px}.budget-result{padding:23px;order:-1}}
</style>
