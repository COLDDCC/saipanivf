---
import { dictionaries } from '../i18n';
const {locale}=Astro.props;const d=dictionaries[locale],b=d.budget;
const ids=['medication','anesthesia','icsi','freeze','fet','pgt','storage'];
const ranges=[[3000,8000],[800,800],[1800,1800],[1000,1000],[4500,4500],[3000,6000],[800,800]];
const rows=[[b.consult,250,250],[b.assessment,800,1500],[b.paths[0],15000,15000],[b.paths[1],9000,9000],...b.labels.map((label,i)=>[label,...ranges[i]])];
const money=(n)=>'$'+n.toLocaleString('en-US');
---
<section id="budget-planner" class="localized-budget" data-budget data-config={JSON.stringify({b,note:d.budgetNote})}><h2>{b.title}</h2><p>{d.budgetNote}</p><div class="estimator"><div><label class="field">{b.path}<select id="budget-path">{['ivf','egg','fet'].map((id,i)=><option value={id}>{b.paths[i]}</option>)}</select></label><div class="budget-options">{ids.map((id,i)=><label data-option={id}><input type="checkbox" value={id} checked={i<5}/><span>{b.labels[i]}</span></label>)}</div></div><div class="budget-result"><output id="budget-total" aria-live="polite">$26,100–31,100</output><p id="budget-description"></p><p>{b.excluded}</p><p>{b.warning}</p><button type="button" id="budget-copy" class="button">{b.copy}</button><p id="budget-status" role="status"></p></div></div><details class="itemized"><summary>{b.table}</summary><div class="table-scroll" tabindex="0" role="region" aria-label={b.table}><table><caption>{d.budgetNote}</caption><thead><tr>{b.columns.slice(0,2).map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{rows.map(([label,min,max])=><tr><th scope="row">{label}</th><td>{money(min)}{max!==min?'–'+money(max):''}</td></tr>)}</tbody></table></div></details></section>
<script>
const root=document.querySelector<HTMLElement>('[data-budget]');if(root){const {b,note}=JSON.parse(root.dataset.config!);const path=root.querySelector<HTMLSelectElement>('#budget-path')!;const ids=['medication','anesthesia','icsi','freeze','fet','pgt','storage'];const ranges=[[3000,8000],[800,800],[1800,1800],[1000,1000],[4500,4500],[3000,6000],[800,800]];const inputs=[...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];const total=root.querySelector('#budget-total')!,description=root.querySelector('#budget-description')!,status=root.querySelector('#budget-status')!;const format=(n:number)=>n.toLocaleString('en-US');function update(){let min=path.value==='egg'?9000:path.value==='fet'?4500:15000,max=min;const selected=[b.paths[['ivf','egg','fet'].indexOf(path.value)]];inputs.forEach((input,i)=>{const eligible=path.value==='ivf'||path.value==='egg'&&['medication','anesthesia','storage'].includes(ids[i])||path.value==='fet'&&ids[i]==='storage';(input.closest('label') as HTMLElement).hidden=!eligible;if(eligible&&input.checked){min+=ranges[i][0];max+=ranges[i][1];selected.push(b.labels[i])}});total.textContent='$'+format(min)+(max===min?'':'–'+format(max));description.textContent=selected.join(' + ');status.textContent=''}path.addEventListener('change',update);inputs.forEach(i=>i.addEventListener('change',update));root.querySelector('#budget-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(note+'\n'+description.textContent+'\n'+total.textContent+'\n'+b.excluded);status.textContent=b.copied}catch{status.textContent=b.failed}});update()}
</script>
<style>.localized-budget{margin-bottom:55px}.estimator{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:35px;background:var(--deep);color:white;padding:35px;margin:30px 0}.estimator>*{min-width:0}.estimator .field{font-size:17px}.estimator select{min-height:52px;width:100%;font-size:16px;padding:14px;background:white;color:var(--ink);border:0}.budget-options{display:grid;gap:10px;margin-top:25px}.budget-options label{display:flex;gap:12px;align-items:flex-start;min-height:44px;line-height:1.7}.budget-options label[hidden]{display:none}.budget-options input{width:20px;height:20px;margin-top:4px;flex-shrink:0}.budget-result{background:var(--cream);color:var(--ink);padding:28px}.budget-result output{display:block;font-size:clamp(27px,3.3vw,46px);line-height:1.4;overflow-wrap:anywhere}.budget-result p{font-size:15px}.budget-result .button{width:100%}.itemized{background:var(--light);padding:25px}.itemized summary{font-size:20px;line-height:1.7}.table-scroll{overflow-x:auto;margin-top:20px}.table-scroll table{width:100%;min-width:420px;border-collapse:collapse}.table-scroll td,.table-scroll th{padding:16px;text-align:left;border-bottom:1px solid #c7d8d9;line-height:1.8}.table-scroll caption{text-align:left;font-size:14px;margin-bottom:15px}.table-scroll:focus-visible{outline:3px solid var(--blue);outline-offset:4px}@media(max-width:750px){.estimator{grid-template-columns:1fr;padding:24px;gap:24px}.budget-result{padding:23px}}
</style>
