---
// Client count supplied by the project owner; not independently audited.
// This describes clients served, not completed treatments, pregnancies or births.
const {locale='zh-CN'}=Astro.props;
const labels={'zh-CN':'服务客户',en:'Clients served',ja:'サービス利用者',ko:'서비스 이용 고객'};
---
<section class="client-count" aria-label={labels[locale]}><div class="wrap"><span>{labels[locale]}</span><strong>1000<span>+</span></strong></div></section>
<style>
.client-count{background:var(--deep);color:white}.client-count>div{display:flex;align-items:baseline;justify-content:center;gap:26px;padding-block:21px}.client-count>div>span{font-size:20px;letter-spacing:.04em}.client-count strong{font-size:clamp(42px,4vw,58px);font-weight:500;line-height:1.1;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.client-count strong span{font-size:.65em;vertical-align:top;margin-left:5px}@media(max-width:600px){.client-count>div{padding-block:18px;gap:20px}.client-count>div>span{font-size:18px}}
</style>
