---
// Client count supplied by the project owner; not independently audited.
// This describes clients served, not completed treatments, pregnancies or births.
const {locale='zh-CN'}=Astro.props;
const notes={"zh-CN": "项目方提供的累计服务人数；不代表治疗周期、妊娠或出生人数。", "en": "Cumulative clients reported by the project owner; not treatment cycles, pregnancies or births.", "ja": "運営側提供の累計利用者数。治療周期数・妊娠数・出生数ではありません。", "ko": "프로젝트 운영자가 제공한 누적 고객 수이며 치료 주기·임신·출생 수가 아닙니다.", "es": "Clientes acumulados comunicados por el responsable del proyecto; no equivale a ciclos, embarazos o nacimientos.", "de": "Vom Projektverantwortlichen angegebene kumulierte Kundenzahl; keine Zahl von Behandlungszyklen, Schwangerschaften oder Geburten.", "fr": "Nombre cumulé de clients communiqué par le responsable du projet ; il ne s’agit pas du nombre de cycles, de grossesses ou de naissances."};
const labels={fr:'Personnes accompagnées',de:'Betreute Kundinnen und Kunden',es:'Clientes atendidos','zh-CN':'累计服务客户',en:'Total clients served',ja:'累計サービス利用者数',ko:'누적 서비스 이용 고객'};
---
<section class="client-count" aria-label={labels[locale]}><div class="wrap"><strong>{locale==='fr'?'1 000':locale==='de'?'1.000':'1,000'}<span>+</span></strong><span>{labels[locale]}</span><small>{notes[locale]}</small></div></section>
<style>
.client-count{background:var(--deep);color:white}.client-count>div{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding-block:22px}.client-count>div>span{font-size:20px;letter-spacing:.04em}.client-count small{font-size:13px;line-height:1.7;max-width:65em;text-align:center;opacity:.85}.client-count strong{font-size:clamp(42px,4vw,58px);font-weight:500;line-height:1.1;letter-spacing:-.035em;font-variant-numeric:tabular-nums}.client-count strong span{font-size:.65em;vertical-align:top;margin-left:5px}@media(max-width:600px){.client-count>div{padding-block:18px;gap:8px}.client-count>div>span{font-size:18px}}
</style>
