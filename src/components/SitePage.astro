---
import HeroCarousel from './HeroCarousel.astro';
import { content, localePaths, type Locale } from '../data/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = content[locale];
const languageNames: Record<Locale, string> = { 'zh-CN': '简体', 'zh-Hant': '繁體', en: 'EN', ja: '日本語' };
const imageRoot = 'https://raw.githubusercontent.com/jiusongvip/saipan/main/public/images/';
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={t.metaDescription} />
  <title>{t.metaTitle}</title>
  {Object.entries(localePaths).map(([code, path]) => <link rel="alternate" hreflang={code} href={path} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip-link" href="#main">{t.skip}</a>
  <section class="hero" id="home">
    <header class="header">
      <a class="brand" href="#home">Saipan IVF<small>FERTILITY INFORMATION & FIRST CONTACT</small></a>
      <button class="menu-button" type="button" aria-controls="main-nav" aria-expanded="false" data-menu>{t.menu} ☰</button>
      <nav class="nav" id="main-nav" aria-label={t.navLabel}>
        <a href="#identity">{t.nav.identity}</a><a href="#services">{t.nav.services}</a><a href="#process">{t.nav.process}</a><a href="#cost">{t.nav.cost}</a><a href="#team">{t.nav.team}</a><a href="#faq">{t.nav.faq}</a><a class="nav-contact" href="#contact">{t.nav.contact}</a>
        <div class="language-links">{Object.entries(localePaths).map(([code, path]) => <a href={path} aria-current={code === locale ? 'page' : undefined}>{languageNames[code as Locale]}</a>)}</div>
      </nav>
    </header>
    <HeroCarousel slides={t.slides} labels={t.heroLabels} aria={t.heroAria} previous={t.previous} next={t.next} pause={t.pause} play={t.play} />
  </section>

  <main id="main">
    <section class="section wrap" id="identity">
      <div class="section-heading"><div class="eyebrow">{t.identity.eyebrow}</div><h2>{t.identity.title}</h2><p class="lead">{t.identity.intro}</p></div>
      <div class="identity-grid">{t.identity.points.map(point => <article><span>{point.label}</span><h3>{point.title}</h3><p>{point.text}</p></article>)}</div>
      <aside class="fact-strip"><strong>{t.identity.factTitle}</strong><ul>{t.identity.facts.map(fact => <li>{fact}</li>)}</ul></aside>
    </section>

    <section class="section soft" id="services"><div class="wrap">
      <div class="section-heading"><div class="eyebrow">{t.services.eyebrow}</div><h2>{t.services.title}</h2><p class="lead">{t.services.lead}</p></div>
      <div class="service-grid">{t.services.cards.map(card => <article class="service-card"><img src={`${imageRoot}${card.image}`} alt="" loading="lazy" /><div><span>{card.number}</span><h3>{card.title}</h3><p>{card.text}</p><a href="#contact">{t.nav.contact} ↗</a></div></article>)}</div>
      <div class="terms"><h3>{t.services.termsTitle}</h3><div class="term-grid">{t.services.terms.map(item => <article><strong>{item.term}</strong><p>{item.text}</p></article>)}</div></div>
    </div></section>

    <section class="section wrap" id="fit">
      <div class="split-heading"><div><div class="eyebrow">{t.fit.eyebrow}</div><h2>{t.fit.title}</h2></div><p class="lead">{t.fit.lead}</p></div>
      <div class="decision-grid">{t.fit.items.map((item, index) => <article><span>0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div>
    </section>

    <section class="section soft" id="process"><div class="wrap">
      <div class="section-heading"><div class="eyebrow">{t.process.eyebrow}</div><h2>{t.process.title}</h2><p class="lead">{t.process.lead}</p></div>
      <div class="steps">{t.process.steps.map(step => <article><strong>{step.number}</strong><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
      <div class="trip-box"><h3>{t.process.tripTitle}</h3><div><article><span>01</span><h4>{t.process.tripOne}</h4><p>{t.process.tripOneText}</p></article><article><span>02</span><h4>{t.process.tripTwo}</h4><p>{t.process.tripTwoText}</p></article></div></div>
    </div></section>

    <section class="section cost-section" id="cost"><div class="wrap">
      <div class="section-heading"><div class="eyebrow">{t.cost.eyebrow}</div><h2>{t.cost.title}</h2><p class="lead">{t.cost.lead}</p></div>
      <div class="cost-layout">
        <div class="checker" data-cost-checker data-start={t.cost.statusStart} data-progress={t.cost.statusProgress} data-done={t.cost.statusDone} data-copy-intro={t.cost.copyIntro} data-all-checked={t.cost.allChecked} data-copied={t.cost.copied}>
          <h3>{t.cost.checkerTitle}</h3><p>{t.cost.checkerHint}</p>
          <div class="check-list">{t.cost.items.map(item => <label><input type="checkbox" /><span>{item}</span></label>)}</div>
          <div class="checker-footer"><strong data-cost-status aria-live="polite">{t.cost.statusStart}</strong><button type="button" data-cost-copy>{t.cost.copy}</button></div>
        </div>
        <aside class="must-ask"><h3>{t.cost.questionsTitle}</h3><ol>{t.cost.questions.map(question => <li>{question}</li>)}</ol><a class="button" href="#contact">{t.nav.contact}</a></aside>
      </div>
    </div></section>

    <section class="section soft" id="team"><div class="wrap">
      <div class="section-heading"><div class="eyebrow">{t.team.eyebrow}</div><h2>{t.team.title}</h2><p class="lead">{t.team.lead}</p></div>
      <div class="team-grid">{t.team.members.map(member => <article><span>{member.role}</span><h3>{member.name}</h3><p>{member.text}</p></article>)}</div>
      <a class="text-link" href="https://www.saipan-ivf.com/Resources/" target="_blank" rel="noopener">{t.team.source} ↗</a>
    </div></section>

    <section class="section wrap" id="faq">
      <div class="section-heading"><div class="eyebrow">{t.faq.eyebrow}</div><h2>{t.faq.title}</h2></div>
      <div class="faq">{t.faq.items.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div>
    </section>

    <section class="section contact-section" id="contact"><div class="wrap contact-layout">
      <div><div class="eyebrow">{t.contact.eyebrow}</div><h2>{t.contact.title}</h2><p>{t.contact.lead}</p><div class="contact-direct"><span>{t.emailLabel}</span><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></div></div>
      <div class="form-card">
        <form data-contact-form data-labels={JSON.stringify(t.contact.labels)} data-default-subject={t.contact.defaultSubject} data-default-message={t.contact.defaultMessage}>
          <div class="fields"><label>{t.contact.subject}<input name="subject" maxlength="80" placeholder={t.contact.subjectPlaceholder} /></label><label>{t.contact.timing}<select name="timing">{t.contact.timingOptions.map(option => <option>{option}</option>)}</select></label><label class="full">{t.contact.topic}<select name="topic" required><option value="">—</option>{t.contact.topicOptions.map(option => <option>{option}</option>)}</select></label><label class="full">{t.contact.message}<textarea name="message" maxlength="600" placeholder={t.contact.messagePlaceholder}></textarea></label></div>
          <button class="button submit" type="submit">{t.contact.submit}</button>
        </form>
        <div class="email-preview" data-email-preview role="status" aria-live="polite"></div>
        <button class="button outline copy-email" type="button" data-copy-email hidden data-default={t.contact.copy} data-copied={t.contact.copied}>{t.contact.copy}</button>
        <p class="privacy">{t.contact.privacy}</p>
      </div>
    </div></section>
  </main>

  <footer class="footer"><div><a class="brand" href="#home">Saipan IVF<small>FERTILITY INFORMATION & FIRST CONTACT</small></a><p>{t.footer}</p></div><div class="footer-links"><a href="mailto:info@saipan-ivf.com">{t.emailLabel}: info@saipan-ivf.com</a><a href="https://www.saipan-ivf.com/" target="_blank" rel="noopener">{t.sourceLabel} ↗</a></div><small>© 2026 Saipan IVF Center</small></footer>
  <a class="floating" href="#contact">{t.nav.contact} ↗</a>

  <script>
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  menu?.addEventListener('click', () => { const open = nav?.classList.toggle('open') ?? false; menu.setAttribute('aria-expanded', String(open)); });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { nav.classList.remove('open'); menu?.setAttribute('aria-expanded', 'false'); }));
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && nav?.classList.contains('open')) { nav.classList.remove('open'); menu?.setAttribute('aria-expanded', 'false'); menu?.focus(); } });

  document.querySelectorAll<HTMLElement>('[data-cost-checker]').forEach(checker => {
    const inputs = Array.from(checker.querySelectorAll<HTMLInputElement>('input[type="checkbox"]'));
    const status = checker.querySelector<HTMLElement>('[data-cost-status]')!;
    const copy = checker.querySelector<HTMLButtonElement>('[data-cost-copy]')!;
    const update = () => {
      const done = inputs.filter(input => input.checked).length;
      status.textContent = done === 0 ? checker.dataset.start! : done === inputs.length ? checker.dataset.done! : checker.dataset.progress!.replace('{done}', String(done)).replace('{total}', String(inputs.length));
    };
    inputs.forEach(input => input.addEventListener('change', update));
    copy.addEventListener('click', async () => {
      const pending = inputs.filter(input => !input.checked).map(input => input.nextElementSibling?.textContent?.trim()).filter(Boolean);
      const text = pending.length ? `${checker.dataset.copyIntro}\n- ${pending.join('\n- ')}` : checker.dataset.allChecked!;
      try { await navigator.clipboard.writeText(text); copy.textContent = checker.dataset.copied!; } catch { copy.textContent = text; }
    });
  });

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(form => {
    const preview = document.querySelector<HTMLElement>('[data-email-preview]')!;
    const copy = document.querySelector<HTMLButtonElement>('[data-copy-email]')!;
    let emailText = '';
    form.addEventListener('submit', event => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const labels = JSON.parse(form.dataset.labels!) as string[];
      const subject = String(data.get('subject') || '').trim() || form.dataset.defaultSubject!;
      const values = [subject, String(data.get('topic') || ''), String(data.get('timing') || ''), String(data.get('message') || '').trim() || form.dataset.defaultMessage!];
      emailText = labels.map((label, index) => `${label}: ${values[index]}`).join('\n');
      preview.textContent = emailText;
      preview.classList.add('visible');
      copy.hidden = false;
      copy.textContent = copy.dataset.default!;
      window.location.href = `mailto:info@saipan-ivf.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(emailText)}`;
    });
    copy.addEventListener('click', async () => { try { await navigator.clipboard.writeText(emailText); copy.textContent = copy.dataset.copied!; } catch { preview.focus(); } });
  });
  </script>
</body>
</html>

<style is:global>
:root{--ink:#133b4b;--blue:#397f96;--deep:#0d3444;--soft:#eaf4f5;--cream:#fbfaf6;--muted:#5f7880;--line:#bfd3d8;--white:#fff;--sans:"DM Sans","Noto Sans SC","Noto Sans JP",sans-serif;--display:"Playfair Display","Noto Sans SC","Noto Sans JP",serif}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--cream);color:var(--ink);font-family:var(--sans)}a{color:inherit;text-decoration:none}[hidden]{display:none!important}button,input,select,textarea{font:inherit}button{cursor:pointer}img{display:block;max-width:100%}p{line-height:1.85}.skip-link{position:fixed;left:16px;top:12px;z-index:20;background:#fff;padding:12px;transform:translateY(-160%)}.skip-link:focus{transform:none}.wrap{max-width:1320px;margin:auto;padding-left:6%;padding-right:6%}.section{padding:100px 0}.soft{background:var(--soft)}.eyebrow{font-size:11px;letter-spacing:2.3px;font-weight:700;color:var(--blue)}h2{font:600 clamp(34px,4.2vw,60px)/1.22 var(--display);letter-spacing:-.6px;margin:20px 0}.lead{max-width:760px;color:var(--muted);font-size:15px}.section-heading{max-width:900px;margin-bottom:44px}.split-heading{display:grid;grid-template-columns:1fr .8fr;gap:9%;align-items:end;margin-bottom:48px}.button{display:inline-flex;align-items:center;justify-content:space-between;gap:28px;padding:15px 20px;background:var(--ink);color:#fff;border:1px solid var(--ink);font-size:13px;font-weight:700;min-height:50px}.button:after{content:"↗";font-size:17px}.button.outline{background:transparent;color:var(--ink);border-color:var(--line)}.text-link{display:inline-block;border-bottom:1px solid;margin-top:25px;padding-bottom:5px;font-size:13px}.hero{display:flex;flex-direction:column;min-height:100svh;background:var(--deep);color:white}.header{position:relative;z-index:5;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:20px 6%;border-bottom:1px solid #ffffff3d;background:var(--deep)}.brand{font:600 27px var(--display);white-space:nowrap}.brand small{display:block;font:700 8px var(--sans);letter-spacing:2.2px;margin-top:3px}.nav{display:flex;align-items:center;justify-content:flex-end;gap:17px;flex-wrap:wrap;font-size:11px}.nav>a:not(.nav-contact):hover{text-decoration:underline;text-underline-offset:5px}.nav-contact{border:1px solid #ffffff73;padding:10px 14px}.language-links{display:flex;gap:9px}.language-links a{border-bottom:1px solid #ffffff70;padding-bottom:2px}.language-links a[aria-current="page"]{font-weight:700;border-bottom:2px solid #fff}.menu-button{display:none;color:white;background:none;border:1px solid #ffffff70;padding:9px 11px}.identity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.identity-grid article{background:#fff;border:1px solid #d4e1e3;padding:28px}.identity-grid span,.service-card span,.decision-grid span,.trip-box span,.team-grid span{font-size:11px;letter-spacing:1.3px;color:var(--blue);font-weight:700}.identity-grid h3,.terms h3,.trip-box h3,.checker h3,.must-ask h3,.team-grid h3{font-size:22px;font-weight:600;line-height:1.35;margin:14px 0}.identity-grid p,.decision-grid p,.team-grid p{font-size:14px;color:var(--muted)}.fact-strip{display:grid;grid-template-columns:.55fr 1.45fr;gap:30px;align-items:center;margin-top:22px;padding:24px 28px;background:var(--deep);color:white}.fact-strip ul{display:grid;grid-template-columns:repeat(2,1fr);gap:9px 25px;margin:0;padding:0;list-style:none;font-size:13px}.fact-strip li:before{content:"✓";color:#a9dce5;margin-right:8px}.service-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.service-card{display:grid;grid-template-columns:40% 60%;background:#fff;min-width:0}.service-card img{width:100%;height:100%;min-height:260px;object-fit:cover}.service-card>div{padding:27px}.service-card h3{font:600 24px/1.35 var(--display);margin:12px 0}.service-card p{font-size:13px;color:var(--muted)}.service-card a{font-size:12px;border-bottom:1px solid}.terms{margin-top:40px;padding-top:32px;border-top:1px solid var(--line)}.term-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:13px}.term-grid article{background:#f8fbfb;padding:18px;border-top:3px solid #8bb9c4}.term-grid strong{font-size:18px}.term-grid p{font-size:12px;color:var(--muted);margin-bottom:0}.decision-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}.decision-grid article{border-top:1px solid var(--line);padding-top:20px}.decision-grid h3{font-size:18px;line-height:1.45}.steps{display:grid;grid-template-columns:repeat(5,1fr);gap:18px}.steps article{border-top:2px solid #8db3bd;padding-top:18px}.steps strong{font:600 31px var(--display);color:#6597a5}.steps h3{font-size:16px}.steps p{font-size:13px;color:var(--muted)}.trip-box{margin-top:45px;background:#fff;padding:30px}.trip-box>div{display:grid;grid-template-columns:1fr 1fr;gap:30px}.trip-box article{border-top:1px solid var(--line);padding-top:16px}.trip-box h4{font-size:17px;margin:10px 0}.trip-box p{font-size:13px;color:var(--muted)}.cost-section{background:#f5f0e7}.cost-layout{display:grid;grid-template-columns:1.3fr .7fr;gap:25px;align-items:start}.checker,.must-ask{background:#fff;padding:32px}.checker>p{color:var(--muted);font-size:13px}.check-list{display:grid;grid-template-columns:1fr 1fr;gap:10px 20px;margin:24px 0}.check-list label{display:flex;align-items:flex-start;gap:10px;padding:11px 0;border-bottom:1px solid #e2e8e8;font-size:13px;line-height:1.45}.check-list input{width:18px;height:18px;accent-color:var(--blue);flex:none}.checker-footer{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-top:24px}.checker-footer strong{font-size:13px}.checker-footer button{background:var(--ink);color:#fff;border:0;padding:13px 16px;font-size:12px}.must-ask ol{padding-left:22px}.must-ask li{padding:12px 0;border-bottom:1px solid var(--line);font-size:14px;line-height:1.6}.must-ask .button{margin-top:22px}.team-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.team-grid article{background:#fff;padding:28px;border-top:3px solid #7cabb7}.faq{max-width:950px}.faq details{border-bottom:1px solid var(--line);padding:20px 0}.faq summary{cursor:pointer;font-size:17px;font-weight:600;line-height:1.6}.faq p{color:var(--muted);font-size:14px;padding-right:35px}.contact-section{background:var(--deep);color:#fff}.contact-section .eyebrow{color:#9ed2dc}.contact-layout{display:grid;grid-template-columns:.8fr 1.2fr;gap:9%;align-items:start}.contact-section h2{color:#fff}.contact-section p{color:#c1d8de}.contact-direct{margin-top:30px;display:grid;gap:6px}.contact-direct span{font-size:11px;color:#9dc6d0}.contact-direct a{font-size:18px;text-decoration:underline;text-underline-offset:6px}.form-card{background:#fff;color:var(--ink);padding:34px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px}.fields label{display:grid;gap:8px;font-size:12px;font-weight:700}.fields .full{grid-column:1/-1}.fields input,.fields select,.fields textarea{width:100%;border:1px solid #b9ccd1;background:#fbfdfd;padding:13px;color:var(--ink);border-radius:0}.fields textarea{min-height:110px;resize:vertical}.submit{width:100%;margin-top:18px}.email-preview{display:none;white-space:pre-line;background:var(--soft);padding:18px;margin-top:16px;font-size:13px;line-height:1.8}.email-preview.visible{display:block}.copy-email{width:100%;margin-top:10px}.privacy{font-size:11px!important;color:var(--muted)!important;margin-bottom:0}.footer{background:#082b39;color:#eaf4f6;padding:55px 6% 28px;display:grid;grid-template-columns:1.2fr .8fr;gap:35px}.footer p{max-width:700px;color:#aec9d0;font-size:12px}.footer-links{display:grid;gap:12px;align-content:start;font-size:12px}.footer>small{grid-column:1/-1;border-top:1px solid #ffffff2c;padding-top:20px;color:#91b2bb}.floating{position:fixed;right:18px;bottom:18px;z-index:7;background:#fff;color:var(--ink);padding:13px 16px;font-size:12px;border:1px solid var(--line);box-shadow:0 10px 28px #0d344433;display:none}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible{outline:3px solid #77b8c8;outline-offset:4px}@media(max-width:1050px){.header{align-items:flex-start}.nav{gap:12px}.term-grid{grid-template-columns:repeat(3,1fr)}.steps{grid-template-columns:repeat(3,1fr)}}@media(max-width:800px){.section{padding:72px 0}.header{align-items:center;flex-wrap:nowrap}.menu-button{display:block}.nav{display:none;position:absolute;top:74px;left:5%;right:5%;background:#123f50;padding:22px;flex-direction:column;align-items:stretch;box-shadow:0 18px 30px #082c3c66;max-height:calc(100svh - 90px);overflow-y:auto}.nav.open{display:flex}.language-links{padding-top:10px}.identity-grid,.decision-grid,.team-grid,.cost-layout,.contact-layout,.split-heading{grid-template-columns:1fr}.service-grid{grid-template-columns:1fr}.fact-strip{grid-template-columns:1fr}.fact-strip ul{grid-template-columns:1fr 1fr}.term-grid{grid-template-columns:1fr 1fr}.steps{grid-template-columns:1fr 1fr 1fr}.floating{display:block}.footer{grid-template-columns:1fr}.footer>small{grid-column:1}}@media(max-width:520px){.brand{font-size:22px}.brand small{font-size:7px;letter-spacing:1.5px}.section{padding:62px 0}h2{font-size:35px}.identity-grid,.service-grid,.decision-grid,.team-grid,.steps,.term-grid,.check-list,.fields,.trip-box>div,.fact-strip ul{grid-template-columns:1fr}.service-card{grid-template-columns:1fr}.service-card img{height:210px;min-height:0}.checker,.must-ask,.form-card,.trip-box{padding:22px}.checker-footer{align-items:stretch;flex-direction:column}.checker-footer button{width:100%}.footer{padding-bottom:85px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none!important}}
</style>
