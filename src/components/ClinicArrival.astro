---
const {locale='zh-CN'}=Astro.props;
const copy={
 'zh-CN':{title:'到院地址与预约确认',label:'院方官网公开地址',steps:[['出发前','确认接诊日期、时间、医生和具体报到位置；将预约确认与地址保存在手机中。'],['安排交通','用下方英文地址查询地图，再向接诊方确认目的地。地图搜索结果不替代报到位置确认。'],['预留调整空间','按医疗日程安排交通和住宿；接送、陪同及额外费用在预约时分别确认。']],map:'按公开地址搜索地图',source:'查看院方联系方式',checked:'地址来源核对：2026-10-21'},
 en:{title:'Clinic address and appointment confirmation',label:'Address published by the care provider',steps:[['Before departure','Confirm the date, time, physician and check-in point. Save the appointment confirmation and address on your phone.'],['Arrange transport','Search the English address below, then confirm the destination with the receiving team. A map result does not confirm the check-in point.'],['Allow for changes','Arrange transport and accommodation around clinical dates. Confirm transfers, accompanying-person arrangements and additional charges separately.']],map:'Search the published address on Maps',source:'View provider contact information',checked:'Address source checked: 21 October 2026'},
 ja:{title:'所在地と来院予約の確認',label:'施設公式サイトの公開住所',steps:[['出発前','受診日、時間、担当医、受付場所を確認し、予約確認と住所をスマートフォンに保存します。'],['交通の手配','下記の英語住所で地図を検索し、受診先に目的地を確認してください。地図の結果だけでは受付場所を確認できません。'],['変更への備え','治療日程に合わせて交通・宿泊を手配し、送迎、同伴者、追加費用は予約時に個別に確認します。']],map:'公開住所を地図で検索',source:'施設の連絡先を見る',checked:'住所の出典確認：2026年10月21日'},
 ko:{title:'진료 주소와 예약 확인',label:'기관 공식 사이트에 공개된 주소',steps:[['출발 전','진료 날짜, 시간, 담당 의사와 접수 장소를 확인하고 예약 확인서와 주소를 휴대전화에 저장하세요.'],['교통편 준비','아래 영문 주소로 지도를 검색한 뒤 진료 기관에 목적지를 확인하세요. 지도 검색 결과만으로 접수 장소가 확정되지는 않습니다.'],['일정 변경 대비','의료 일정에 맞춰 교통과 숙박을 준비하고 픽업, 동반자와 추가 비용은 예약 시 별도로 확인하세요.']],map:'공개 주소로 지도 검색',source:'기관 연락처 보기',checked:'주소 출처 확인: 2026년 10월 21일'}
};
const c=copy[locale];
const map='https://www.google.com/maps/search/?api=1&query='+encodeURIComponent('Bank of Guam Garapan Saipan MP 96950');
---
<section class="arrival" id="clinic-arrival" aria-labelledby="arrival-title"><h2 id="arrival-title">{c.title}</h2><div class="arrival-layout"><div class="arrival-address"><p>{c.label}</p><address>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</address><a class="inline-link" href={map} target="_blank" rel="noopener">{c.map}</a></div><ol>{c.steps.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol></div><p class="arrival-source"><a href="https://www.saipan-ivf.com/contact/" target="_blank" rel="noopener">{c.source}</a> · {c.checked}</p></section>
<style>
.arrival{margin:40px 0;scroll-margin-top:24px}.arrival h2{font-size:clamp(26px,2.5vw,34px);line-height:1.5;margin:0 0 24px}.arrival-layout{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:34px}.arrival-address{background:var(--light);padding:28px;align-self:start}.arrival-address p{font-size:14px;margin:0 0 14px;color:var(--muted)}.arrival address{font-style:normal;font-size:23px;line-height:1.65;overflow-wrap:anywhere}.arrival-address a{display:inline-block;margin-top:20px;line-height:1.8}.arrival ol{margin:0;padding-left:24px}.arrival li{padding-left:8px;margin:0 0 20px}.arrival h3{font-size:19px;margin:0 0 7px}.arrival li p{font-size:16px;line-height:1.85;margin:0}.arrival-source{font-size:13px;line-height:1.9;color:var(--muted);margin-top:22px}.arrival-source a{text-decoration:underline;text-underline-offset:4px}@media(max-width:700px){.arrival-layout{grid-template-columns:1fr;gap:25px}.arrival-address{padding:23px}.arrival address{font-size:21px}}
</style>
