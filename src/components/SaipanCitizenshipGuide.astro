id="faq"><h2>{d.headings[4]}</h2>{d.faq.map(([a,b])=><details><summary>{a}</summary><p>{b}</p></details>)}</section><section class="sources"><h2>{d.headings[5]}</h2><p class="meta">Saipan IVF Editorial Team · {d.checked} · General information, not medical or legal advice. Rules may change.</p><ol>{sources.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ol><div class="related"><a href={l==='tw'?'/zh-hant/birth-planning/':'/birth-planning/'}>{d.related}</a><a href={l==='en'?'/en/guides/':l==='tw'?'/zh-hant/guides/':'/guides/'}>{d.back}</a></div></section></main><footer>© 2026 Saipan IVF · Evidence-first guidance, not legal or medical advice. · <a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></footer></body></html>