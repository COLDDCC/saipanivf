ont-size:18px}.tile p,.step p{margin:0;color:#546975;font-size:15px}p{max-width:780px}.document-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px}.checklist{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.checklist li{padding:15px 15px 15px 43px;background:white;border:1px solid #e0e9eb;border-radius:7px;position:relative}.checklist li:before{content:'✓';position:absolute;left:17px;color:#08779b;font-weight:800}details{border-bottom:1px solid #dce7e9;padding:17px 0}summary{cursor:pointer;font-weight:700;min-height:35px}details p{margin-bottom:0}.sources li{margin:10px 0}.meta{font-size:13px;color:#59717e}.related{display:flex;gap:12px;flex-wrap:wrap}.related a{background:#1d6b8f;color:white;padding:13px 18px;text-decoration:none;border-radius:6px}footer{padding:26px;text-align:center;border-top:1px solid #e0e9eb;color:#59717e;font-size:13px}@media(max-width:700px){main{padding:22px 18px 60px}.top-inner{padding:14px 18px}.hero{grid-template-columns:1fr;gap:12px}.hero img{height:190px;object-position:center 50%}.hero figure{order:1}.hero-copy{padding:0}h1{font-size:34px;margin:10px 0}.lead{font-size:15px}.decision,.document-steps,.checklist{grid-template-columns:1fr}section{margin:38px 0}.jump{margin:18px 0 30px}}
