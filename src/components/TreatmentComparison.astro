---
import { usd } from '../i18n/money';
import { outcomeCopy } from '../i18n/outcomes';
import { comparisonCopy } from '../i18n/comparison';
import { dictionaries,treatmentSlugs,pageHref } from '../i18n';
import { treatments } from '../data/treatments';
import { pricing } from '../data/pricing';
const {locale='zh-CN',mode='treatments'}=Astro.props;
const c=comparisonCopy[locale],items=locale==='zh-CN'?treatments:dictionaries[locale].treatments;
const fees=mode==='fees',title=fees?c.feeTitle:c.title,headers=fees?c.feeHeaders:c.headers;
const href=(key)=>locale==='zh-CN'?'/'+key+'/':pageHref(locale,key);
const rows=items.map((item,i)=>{const id=['ivf','icsi','egg','fet'][i],price=pricing.find(row=>row.id===id)!;return {title:item.title,price:usd(price.min,locale),cells:fees?[item.included,item.excluded]:[c.purpose[i],c.relationship[i],c.cost[i]],url:href('treatments/'+treatmentSlugs[i])+(fees?'#costs':''),next:fees?c.feeHeaders[3]:c.next[i]}});
const sectionId=fees?'fee-comparison':'treatment-comparison';
---
<section class="comparison" id={sectionId} aria-labelledby={sectionId+'-title'}>
 <h2 id={sectionId+'-title'}>{title}</h2><p class="comparison-intro">{fees?c.feeIntro:c.intro}</p>
 <div class="comparison-desktop"><table><caption class="sr-only">{title}</caption><thead><tr>{headers.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row.title}{fees&&<strong class="base-price">{row.price}</strong>}</th>{row.cells.map(cell=><td>{cell}</td>)}<td><a href={row.url}>{row.next}</a></td></tr>)}</tbody></table></div>
 <div class="comparison-mobile">{rows.map(row=><article><h3>{row.title}</h3>{fees&&<strong class="base-price">{row.price}{!['de','fr'].includes(locale)&&' USD'}</strong>}<dl>{row.cells.map((cell,i)=><div><dt>{headers[i+1]}</dt><dd>{cell}</dd></div>)}</dl><a class="inline-link" href={row.url}>{row.next}</a></article>)}</div>
 {fees&&<p class="comparison-note">{c.note}</p>}
 <nav class="comparison-links" aria-label={title}><a class="inline-link" href={fees?'#budget-planner':href('fees')}>{c.budget}</a><a class="inline-link" href={href('service-scope')}>{c.scope}</a>{!fees&&<a class="inline-link" href="#outcomes">{outcomeCopy[locale].link}</a>}</nav>
</section>
<style>.comparison{margin:36px 0 60px;scroll-margin-top:28px}.comparison h2{font-size:clamp(27px,2.7vw,36px);margin:0 0 16px}.comparison-intro{max-width:62em;margin:0 0 24px}.comparison table{border-collapse:collapse;table-layout:fixed;width:100%;font-size:15px;line-height:1.8}.comparison th,.comparison td{text-align:left;vertical-align:top;padding:22px 18px;border-bottom:1px solid #c3d2d4;overflow-wrap:anywhere}.comparison thead{background:var(--deep);color:white}.comparison thead th{font-weight:500}.comparison tbody th{background:var(--light);font-size:17px;font-weight:500;width:20%}.comparison tbody tr:nth-child(even) td{background:#f0f5f3}.comparison a:not(.inline-link){text-decoration:underline;text-underline-offset:5px}.base-price{display:block;font-size:23px;font-weight:500;margin-top:12px;white-space:nowrap}.comparison-note{font-size:14px;color:var(--muted);max-width:65em}.comparison-links{display:flex;flex-wrap:wrap;gap:10px 28px;margin-top:12px}.comparison-mobile{display:none}.comparison .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}@media(max-width:800px){.comparison-desktop{display:none}.comparison-mobile{display:grid;gap:20px}.comparison-mobile article{padding:24px;background:var(--light);min-width:0}.comparison-mobile h3{font-size:24px;margin:0 0 16px}.comparison-mobile dl{margin:20px 0 10px}.comparison-mobile dl>div{padding:14px 0;border-top:1px solid #c3d2d4}.comparison-mobile dt{font-size:14px;color:var(--muted);margin-bottom:6px}.comparison-mobile dd{font-size:16px;line-height:1.85;margin:0}.comparison-links{display:grid;gap:0}.comparison-mobile .base-price{margin-top:0}}</style>
