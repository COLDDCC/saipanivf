---
import HomeDecisions from "./HomeDecisions.astro";
import HomeBirthLink from "./HomeBirthLink.astro";
import HomeClientCount from "./HomeClientCount.astro";
import HeroCarousel from './HeroCarousel.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import { dictionaries,pageHref,treatmentSlugs,pageInfo } from '../i18n';
import { hero } from '../i18n/hero';
import { homeCopy } from '../i18n/home';
import { faqs } from '../data/faq';
const {locale}=Astro.props;const d=dictionaries[locale],c=homeCopy[locale];const href=(key='')=>pageHref(locale,key);const asset=(name)=>'/images/stock/'+name+'.webp';
const guideSlugs=['first-visit','ivf-steps','quotation','egg-freezing','travel-checklist','family-planning'];
const profileIds=['gary-ramsey','irena-lalic','rose-wang'],names=['Gary G. Ramsey, M.D.','Irena Lalic','Rose Wang'];
---
<section class="hero"><HeroCarousel locale={locale} {...hero(locale)}/></section>
<HomeDecisions locale={locale}/>

<section class="section wrap home-budget"><div class="budget-photo"><ResponsiveImage src={asset('calculator-open')} alt={c.budget} width="640" height="480" loading="lazy"/></div><div><h2>{c.budget}</h2><p>{c.budgetText}</p><a class="button" href={href('fees')}>{c.budgetLink}</a><a class="inline-link budget-guide" href={href('guides/quotation')}>{c.quotation}</a></div></section>
<section class="section wrap home-section"><div class="section-head"><div><h2>{d.nav[1]}</h2><p class="section-intro">{c.treatmentIntro}</p></div><a class="inline-link" href={href('treatments')}>{c.allTreatments}</a></div><div class="photo-cards">{[0,2,3].map((i,n)=><a class="photo-card" href={href('treatments/'+treatmentSlugs[i])}><div class="image-frame"><ResponsiveImage src={asset(['microscope-white','ultrasound-probe','parent-hands'][n])} alt={d.treatments[i].title} width="640" height="420" loading="lazy"/></div><div class="card-copy"><h3>{d.treatments[i].title}</h3><p>{d.treatments[i].summary}</p><span class="read-more">{d.details}</span></div></a>)}</div></section>
<section class="home-center soft"><div class="section wrap"><div class="center-layout"><figure class="center-photo"><ResponsiveImage src="/images/official/center.webp" alt={c.centre} width="870" height="550" loading="lazy"/><figcaption>{c.imageSource} · Bank of Guam</figcaption></figure><div class="center-copy"><h2>{c.centre}</h2><p>{c.centreText}</p><dl class="address-facts"><div><dt>{c.address}</dt><dd>3rd Floor, Bank of Guam<br/>Garapan, Saipan, MP 96950</dd></div><div><dt>{c.email}</dt><dd><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></dd></div></dl><a class="button" href={href('about')}>{c.about}</a></div></div></div></section>
<section class="section wrap home-section"><div class="section-head"><div><h2>{c.team}</h2><p class="section-intro">{c.teamIntro}</p></div><a class="inline-link" href={href('team')}>{c.teamLink}</a></div><div class="people-grid">{['gary','irena','rose'].map((image,i)=><a class="person-card" href={href('team')+'#'+profileIds[i]}><div class="portrait"><ResponsiveImage src={'/images/official/'+image+'.webp'} alt={names[i]} width={i===0?480:250} height={i===0?720:347} loading="lazy"/></div><div class="person-copy"><span class="category">{d.pages.team.sections[i][0].split(' — ')[1]}</span><h3>{names[i]}</h3><p>{d.pages.team.sections[i][1]}</p><span class="read-more">{d.read}</span></div></a>)}</div><p class="photo-source"><a href="https://www.saipan-ivf.com/Resources/" target="_blank" rel="noopener">{c.imageSource}</a></p></section>

<HomeClientCount locale={locale}/>
<section class="visit-finder wrap" aria-label={c.finder}><h2>{c.finder}</h2><form action={href('treatments')} id="visit-finder"><label for="visit-topic">{c.choose}</label><select id="visit-topic" name="topic">{['treatments','guides/egg-freezing','fees','process','birth-planning'].map(key=><option value={href(key)}>{pageInfo(locale,key).title}</option>)}</select><button class="button" type="submit">{c.go}</button></form><noscript><a href={href('guides')}>{c.allGuides}</a></noscript></section>
<section class="journey-panel"><div class="section wrap"><div class="section-head"><h2>{c.journey}</h2><a class="inline-link" href={href('process')}>{c.process}</a></div><div class="visit-grid">{['guides/first-visit','guides/travel-checklist','process'].map((key,i)=><a href={href(key)} class="visit-card"><ResponsiveImage src={asset(['stethoscope-white','luggage-packed','calendar-open'][i])} alt={c.visitTags[i]} width="640" height="420" loading="lazy"/><div><span>{c.visitTags[i]}</span><h3>{c.visitTitles[i]}</h3><p>{c.visitTexts[i]}</p></div></a>)}</div></div></section>
<section class="soft"><div class="section wrap home-section"><div class="section-head"><h2>{d.nav[5]}</h2><a class="inline-link" href={href('guides')}>{c.allGuides}</a></div><div class="guide-grid">{guideSlugs.map((slug,i)=><a class="guide-card" href={href('guides/'+slug)}><ResponsiveImage src={asset(['notebook-wood','microscope-focus','budget-documents','fern-light','wing-clouds','baby-shoes'][i])} alt={pageInfo(locale,'guides/'+slug).title} width="640" height="400" loading="lazy"/><div class="guide-copy"><h3>{pageInfo(locale,'guides/'+slug).title}</h3><p>{pageInfo(locale,'guides/'+slug).description}</p><span class="read-more">{d.read}</span></div></a>)}</div></div></section>
<section class="section wrap home-faq"><div class="section-head"><div><h2>{d.nav[8]}</h2><p class="section-intro">{c.faqIntro}</p></div><a class="inline-link" href={href('faq')}>{c.allFaq}</a></div><div class="faq">{[6,8,10,11].map(i=><details><summary>{d.faq[i][0]}</summary><p><strong>{d.faq[i][1]}</strong></p><a class="inline-link" href={href('faq')+'#'+faqs[i].id}>{d.source}</a></details>)}</div></section>
<HomeBirthLink locale={locale}/>
<script>document.querySelector<HTMLFormElement>('#visit-finder')?.addEventListener('submit',event=>{event.preventDefault();const select=document.querySelector<HTMLSelectElement>('#visit-topic');if(select)window.location.assign(select.value)});</script>
