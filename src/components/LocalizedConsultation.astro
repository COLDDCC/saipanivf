---
import { dictionaries,treatmentSlugs } from '../i18n';
const {locale}=Astro.props;const d=dictionaries[locale],f=d.form;
const extra=locale==='ja'?['精子凍結','提供資源・第三者が関わる家族計画','海外受診と費用']:['Sperm freezing','Donor and third-party family-building','Cross-border care and costs'];
---
<section class="section contact-section" data-consult data-config={JSON.stringify(f)}><div class="wrap contact-layout"><div><h2>{d.footerTitle}</h2><p>{d.footerText}</p><p><a class="inline-link" href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></p><p>{f.note}</p><a class="inline-link" href={'/'+locale+'/guides/first-visit/'}>{d.prepare}</a></div><div class="form-card"><h2>{f.title}</h2><p>{f.intro}</p><noscript><style>#consult-form{display:none}</style><p><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></p></noscript><form id="consult-form"><div class="fields"><label class="field">{f.subject}<input name="name" maxlength="60" autocomplete="off"/></label><label class="field">{f.timing}<select name="contact">{f.times.map((label,i)=><option value={i===0?'':label}>{label}</option>)}</select></label><label class="field full">{f.topic}<select name="topic" required><option value="">{f.choose}</option>{d.treatments.map((item,i)=><option value={item.title} data-slug={treatmentSlugs[i]}>{item.title}</option>)}{extra.map(label=><option>{label}</option>)}<option>{f.unknown}</option></select></label><label class="field full">{f.message}<textarea name="message" maxlength="800"></textarea></label></div><button class="template" type="button" id="question-template">{f.template}</button><button class="button" type="submit">{f.generate}</button></form><div class="success" id="form-success" role="status" aria-live="polite" style="white-space:pre-line"></div><a class="button" id="email-summary" hidden style="display:none" href="mailto:info@saipan-ivf.com">{f.open}</a><button type="button" id="copy-summary" class="button" hidden style="display:none">{f.copy}</button><p class="caption"><a class="inline-link" href={'/'+locale+'/privacy/'}>{d.nav[11]}</a></p></div></div></section>
<script>
const root=document.querySelector<HTMLElement>('[data-consult]');if(root){const f=JSON.parse(root.dataset.config!);const form=root.querySelector<HTMLFormElement>('#consult-form')!;const topic=form.querySelector<HTMLSelectElement>('[name=topic]')!,message=form.querySelector<HTMLTextAreaElement>('[name=message]')!;const status=root.querySelector<HTMLElement>('#form-success')!,email=root.querySelector<HTMLAnchorElement>('#email-summary')!,copy=root.querySelector<HTMLButtonElement>('#copy-summary')!,template=root.querySelector<HTMLButtonElement>('#question-template')!;const requested=new URLSearchParams(location.search).get('topic');if(requested){const option=[...topic.options].find(o=>o.dataset.slug===requested||o.value===requested);if(option)topic.value=option.value}function invalidate(){if(status.textContent){status.textContent=f.changed;status.style.display='block'}email.hidden=true;email.style.display='none';email.href='mailto:info@saipan-ivf.com';copy.hidden=true;copy.style.display='none';template.hidden=Boolean(message.value.trim())}form.addEventListener('input',invalidate);form.addEventListener('change',invalidate);template.addEventListener('click',()=>{if(!message.value.trim()){message.value=f.templateText;invalidate();message.focus()}});form.addEventListener('submit',event=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form),subject=String(data.get('name')||f.title).trim()||f.title;const body=f.unsent+'\n\n'+f.subject+': '+subject+'\n'+f.topic+': '+data.get('topic')+'\n'+f.timing+': '+(data.get('contact')||f.times[0])+'\n'+f.message+': '+(data.get('message')||f.templateText);status.textContent=body;status.style.display='block';email.href='mailto:info@saipan-ivf.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);email.hidden=false;email.style.display='inline-flex';copy.hidden=false;copy.style.display='inline-flex';copy.textContent=f.copy;status.scrollIntoView({block:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'})});copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(status.textContent!);copy.textContent=f.copied}catch{copy.textContent=f.failed}})}
</script>
<style>.template{background:none;border:0;color:var(--blue);min-height:44px;margin-top:15px;padding:10px 0;font-size:15px;text-decoration:underline;text-underline-offset:5px}.template[hidden]{display:none}.form-card h2{font-size:28px}.success{overflow-wrap:anywhere}.form-card>a.button,.form-card>button.button{width:100%;margin-top:18px}.contact-section>.wrap>div>p{color:#e0ecec}</style>
