---
import { dictionaries,treatmentSlugs } from '../i18n';
import { consultationCopy,chineseForm } from '../data/consultation';
const {locale='zh-CN'}=Astro.props;
const chinese=locale==='zh-CN';const d=chinese?null:dictionaries[locale];
const f=chinese?chineseForm:d.form;const c=consultationCopy[locale];
const prefix=chinese?'':'/'+locale;
const titles=chinese?['试管婴儿 IVF','单精子注射 ICSI','冻卵与生育力保存','冻胚移植 FET']:d.treatments.map(item=>item.title);
const extra=chinese?['冻精 / 精子保存','第三方辅助生殖相关咨询','跨境就诊与费用']:locale==='ko'?['정자 동결','기증·제3자 참여 가족 계획','해외 진료 및 비용']:locale==='ja'?['精子凍結','第三者が関わる家族計画','海外受診と費用']:['Sperm freezing','Donor and third-party family-building','Cross-border care and costs'];
const channels=['email','wechat','phone','whatsapp','line','telegram'];
---
<section class="section contact-section" id="contact" data-consult data-config={JSON.stringify({f,c,locale})}><div class="wrap contact-layout"><div class="consult-intro"><span class="consult-eyebrow">Saipan IVF</span><h2>{c.title}</h2><p>{c.intro}</p><h3>{c.next}</h3><ol class="consult-next">{c.steps.map(step=><li>{step}</li>)}</ol><a class="inline-link" href={prefix+'/guides/first-visit/'}>{c.guide}</a><div class="consult-direct"><h3>{c.direct}</h3><a class="inline-link" href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a><p>{f.note}</p></div></div><div class="form-card"><h2>{f.title}</h2><p>{f.intro}</p><noscript><style>#consult-form{display:none}</style><p><a href="mailto:info@saipan-ivf.com">info@saipan-ivf.com</a></p></noscript><form id="consult-form"><div class="fields"><label class="field">{c.channel}<select name="contactMethod" id="contact-method">{channels.map((value,i)=><option value={value}>{c.channels[i]}</option>)}</select></label><label class="field">{c.value} · {c.required}<input id="contact-value" name="contactValue" type="email" autocomplete="email" inputmode="email" required maxlength="150" placeholder={c.placeholder} aria-describedby="contact-privacy"/></label></div><p id="contact-privacy" class="caption">{c.privacy}</p><details class="consult-options"><summary>{c.more}</summary><div class="fields"><label class="field">{c.name} · {c.optional}<input name="name" maxlength="60" autocomplete="given-name"/></label><label class="field">{f.timing}<select name="contact">{f.times.map((label,i)=><option value={i===0?'':label}>{label}</option>)}</select></label><label class="field full">{f.topic}<select name="topic"><option value="">{f.unknown}</option>{titles.map((title,i)=><option value={title} data-slug={treatmentSlugs[i]}>{title}</option>)}{extra.map(label=><option>{label}</option>)}</select></label><label class="field full">{f.message}<textarea name="message" maxlength="800"></textarea></label></div><button class="template" type="button" id="question-template">{f.template}</button></details><button class="button" type="submit">{f.generate}</button></form><div class="success" id="form-success" role="status" aria-live="polite" style="white-space:pre-line"></div><a class="button" id="email-summary" hidden style="display:none" href="mailto:info@saipan-ivf.com">{f.open}</a><button type="button" id="copy-summary" class="button outline" hidden style="display:none">{f.copy}</button><p class="caption"><a class="inline-link" href={prefix+'/privacy/'}>{c.policy}</a></p></div></div></section>
<script>
const root=document.querySelector<HTMLElement>('[data-consult]');
if(root){
 const {f,c}=JSON.parse(root.dataset.config!);const locale=document.documentElement.lang;
 const form=root.querySelector<HTMLFormElement>('#consult-form')!;
 const topic=form.querySelector<HTMLSelectElement>('[name=topic]')!,message=form.querySelector<HTMLTextAreaElement>('[name=message]')!;
 const method=form.querySelector<HTMLSelectElement>('[name=contactMethod]')!,value=form.querySelector<HTMLInputElement>('[name=contactValue]')!;
 const status=root.querySelector<HTMLElement>('#form-success')!,email=root.querySelector<HTMLAnchorElement>('#email-summary')!,copy=root.querySelector<HTMLButtonElement>('#copy-summary')!,template=root.querySelector<HTMLButtonElement>('#question-template')!;
 const requested=new URLSearchParams(location.search).get('topic');
 if(requested){const option=[...topic.options].find(o=>o.dataset.slug===requested||o.value===requested);if(option){topic.value=option.value;form.querySelector<HTMLDetailsElement>('.consult-options')!.open=true}}
 function invalidate(){if(status.textContent){status.textContent=f.changed;status.style.display='block'}email.hidden=true;email.style.display='none';email.href='mailto:info@saipan-ivf.com';copy.hidden=true;copy.style.display='none';template.hidden=Boolean(message.value.trim());value.setCustomValidity('')}
 function updateMethod(){const isEmail=method.value==='email',isPhone=['phone','whatsapp'].includes(method.value);value.type=isEmail?'email':'text';value.inputMode=isEmail?'email':isPhone?'tel':'text';value.autocomplete=isEmail?'email':isPhone?'tel':'off';value.placeholder=c.placeholders[method.selectedIndex];invalidate()}
 form.addEventListener('input',invalidate);form.addEventListener('change',invalidate);method.addEventListener('change',updateMethod);
 template.addEventListener('click',()=>{if(!message.value.trim()){message.value=f.templateText;invalidate();message.focus()}});
 form.addEventListener('submit',event=>{
  event.preventDefault();value.value=value.value.trim();value.setCustomValidity('');
  if(['phone','whatsapp'].includes(method.value)&&!/^\+?[\d\s().-]{7,30}$/.test(value.value))value.setCustomValidity(c.invalidPhone);
  if(!form.reportValidity())return;
  // Stable fields for a future same-origin server endpoint. No data is sent or stored here.
  const payload={schemaVersion:1,locale,sourcePath:location.pathname,contactMethod:method.value,contactValue:value.value,name:String(new FormData(form).get('name')||'').trim(),treatment:topic.selectedOptions[0]?.dataset.slug||'',topic:topic.value,timing:String(new FormData(form).get('contact')||''),message:message.value.trim()};
  const subject=f.title+(payload.topic?' · '+payload.topic:'');
  const body=f.unsent+'\n\n'+c.channel+': '+c.channels[method.selectedIndex]+'\n'+c.value+': '+payload.contactValue+'\n'+c.name+': '+(payload.name||'—')+'\n'+f.topic+': '+(payload.topic||f.unknown)+'\n'+f.timing+': '+(payload.timing||f.times[0])+'\n'+f.message+': '+(payload.message||f.templateText);
  status.textContent=body;status.style.display='block';email.href='mailto:info@saipan-ivf.com?subject='+encodeURIComponent(subject)+'&body='+encodeURIComponent(body);email.hidden=false;email.style.display='inline-flex';copy.hidden=false;copy.style.display='inline-flex';copy.textContent=f.copy;status.scrollIntoView({block:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'});
 });
 copy.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(status.textContent!);copy.textContent=f.copied;document.dispatchEvent?.(new CustomEvent('sivf:metric',{detail:'consult_copy'}))}catch{copy.textContent=f.failed}});
}
</script>
<style>.consult-eyebrow{display:block;font-size:14px;letter-spacing:.14em;margin-bottom:18px;color:#c6e1e5}.consult-intro>h2{max-width:12em}.consult-intro>h3{margin-top:38px;font-size:22px}.consult-next{padding-left:22px;margin:20px 0}.consult-next li{font-size:16px;line-height:1.85;margin:12px 0;color:#e0ecec}.consult-direct{margin-top:38px;padding-top:24px;border-top:1px solid #61838a}.consult-direct h3{font-size:20px;margin:0}.consult-direct p{font-size:14px;color:#d5e6e9}.consult-options{margin-top:26px;border-top:1px solid #c7d7d9;border-bottom:1px solid #c7d7d9}.consult-options>summary{min-height:52px;padding:15px 0;font-size:15px}.consult-options .fields{padding-top:15px}.template{background:none;border:0;color:var(--blue);min-height:44px;margin:15px 0;padding:10px 0;font-size:15px;text-decoration:underline;text-underline-offset:5px}.template[hidden]{display:none}.form-card h2{font-size:28px}.success{overflow-wrap:anywhere}.form-card>a.button,.form-card>button.button{width:100%;margin-top:18px}.contact-section>.wrap>.consult-intro>p{color:#e0ecec}.form-card>p{color:var(--ink)}.form-card>p.caption{color:var(--muted)}@media(max-width:600px){.fields{grid-template-columns:1fr}.form-card{padding:24px}.consult-intro>h2{max-width:100%}}</style>
