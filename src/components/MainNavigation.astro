---
import { dictionaries } from '../i18n';
const { locale = 'zh-CN', current = '' } = Astro.props;
const d = locale === 'en' || locale === 'ja' ? dictionaries[locale] : null;
const labels = d?.nav ?? ['关于中心','治疗项目','医疗团队','IVF流程','费用预算','就诊指南','赴美生育','联系咨询','常见问题','预约与服务范围'];
const href = (path: string) => (d ? '/' + locale : '') + '/' + path + '/';
const guides = [
  ['guides', labels[5]], ['process', labels[3]], ['fees', labels[4]],
  ['faq', labels[8]],
  ['guides/travel-checklist', locale === 'en' ? 'Travel preparation' : locale === 'ja' ? '渡航の準備' : '出行准备'],
  ['service-scope', labels[9]], ['birth-planning', labels[6]]
];
const active = (path: string) => current === path ? 'page' : undefined;
---
<nav class="nav" id="main-nav" aria-label={locale === 'en' ? 'Main navigation' : locale === 'ja' ? 'メインナビゲーション' : '主要导航'}>
  {['about','treatments','team'].map((path,i) => <a href={href(path)} aria-current={active(path)}>{labels[i]}</a>)}
  <details class="nav-group">
    <summary>{labels[5]}</summary>
    <div>{guides.map(([path,label]) => <a href={href(path)} aria-current={active(path)}>{label}</a>)}</div>
  </details>
  <a class="nav-contact" href={href('contact')} aria-current={active('contact')}>{labels[7]}</a>
</nav>
<script>
document.querySelectorAll<HTMLDetailsElement>('.nav-group').forEach(group => {
  document.addEventListener('click',event => { if (!group.contains(event.target as Node)) group.open = false; });
  group.addEventListener('keydown',event => { if (event.key === 'Escape') { group.open = false; group.querySelector('summary')?.focus(); } });
});
</script>
