---
import { pricing } from '../data/pricing';
import { site } from '../data/site';
const { traditional=false }=Astro.props;
const t=(cn:string,tw:string)=>traditional?tw:cn;
const pick=(id:string)=>pricing.find(p=>p.id===id)!;
const core=pick('ivf'),med=pick('medication'),ana=pick('anesthesia'),fet=pick('fet');
const low=core.min+med.min+ana.min;
const high=core.max+med.max+ana.max;
const money=(n:number)=>'US$'+n.toLocaleString('en-US');
const path=traditional?'/zh-hant/guides/ivf-cost/':'/guides/ivf-cost/';
const title=t('塞班试管婴儿费用 2026：IVF预算与额外项目','塞班試管嬰兒費用 2026：IVF預算與額外項目');
const description=t('塞班 IVF 要多少钱？按取卵培养、促排药物、麻醉、移植等项目拆分规划预算，说明不包含的费用与如何核对书面报价。','塞班 IVF 需要多少費用？拆解取卵培養、促排藥物、麻醉、植入等規劃預算，並列出額外費用與書面報價核對事項。');
const canonical=new URL(path,site.origin).href;
const rows=[
{label:t('IVF 取卵及胚胎培养','IVF 取卵及胚胎培養'),data:core},
{label:t('促排药物','促排藥物'),data:med},
{label:t('取卵麻醉','取卵麻醉'),data:ana},
];
const extras=[
{label:t('ICSI 单精子注射','ICSI 單精子注射'),data:pick('icsi')},
{label:t('胚胎冷冻操作','胚胎冷凍操作'),data:pick('freeze')},
{label:t('冻胚移植 FET','冷凍胚胎植入 FET'),data:fet},
{label:t('PGT-A 规划预算','PGT-A 規劃預算'),data:pick('pgt')},
{label:t('年度冷冻保存','年度冷凍保存'),data:pick('storage')},
];
const range=(x:{min:number,max:number})=>money(x.min)+(x.min===x.max?'':'–'+money(x.max));
const qas=[
[t('基础预算包括移植吗？','基本預算包含胚胎植入嗎？'),t('不包括。本站 IVF 基础预算为取卵与培养、药物、麻醉三项，移植可能单独收费。','不包含。本站 IVF 基本規劃預算涵蓋取卵培養、藥物與麻醉，植入可能另外計費。')],
[t('需要做 ICSI 或 PGT-A 吗？','需要做 ICSI 或 PGT-A 嗎？'),t('不一定。是否适用应根据医生评估决定，不能把这些项目默认算成人人必选。','不一定。是否適用須由醫師評估，不能把這些項目當作所有人都必須選擇。')],
[t('预算可以当作诊所公开报价吗？','規劃預算能當作診所公開報價嗎？'),t('不能。本站数字为内部规划假设，不是诊所确认收费。','不能。本站數字屬規劃假設，並非診所確認收費。')],
];
---
<!doctype html><html lang={traditional?'zh-Hant':'zh-CN'}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} · Saipan IVF</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="zh-CN" href={new URL('/guides/ivf-cost/',site.origin).href}/><link rel="alternate" hreflang="zh-Hant" href={new URL('/zh-hant/guides/ivf-cost/',site.origin).href}/><link rel="alternate" hreflang="x-default" href={new URL('/guides/ivf-cost/',site.origin).href}/><meta property="og:type" content="article"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><style>
*{box-sizing:border-box}body{margin:0;background:#fcfdfd;color:#223e51;font:16px/1.75 system-ui,-apple-system,"Noto Sans SC","Noto Sans TC",sans-serif}a{color:#126b9a}.top{border-bottom:1px solid #e0e9ec;background:#fff}.nav{max-width:960px;margin:auto;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 22px}.brand{text-decoration:none;color:#17465e;font-weight:750}main{max-width:950px;margin:auto;padding:38px 22px 76px}h1{font-size:clamp(30px,5vw,44px);line-height:1.25;margin:8px 0 20px}h2{font-size:clamp(22px,3vw,28px);margin:40px 0 14px}p{max-width:760px}.muted{color:#506b7d}.hero{border-bottom:1px solid #d8e3e8;padding-bottom:22px}.numbers{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:24px 0}.number{background:#eaf3f6;padding:20px;border-radius:12px}.number strong{display:block;font-size:clamp(21px,3vw,30px);line-height:1.3}.number small{display:block}.alert{background:#f0f6f9;border-left:3px solid #357ca4;padding:13px 18px}.tablebox{overflow-x:auto}table{width:100%;border-collapse:collapse}td,th{padding:13px 12px;border-bottom:1px solid #dce6ea;text-align:left}th{background:#edf4f7}td:last-child,th:last-child{text-align:right;white-space:nowrap}li{margin:8px 0}details{border-bottom:1px solid #dde6e9;padding:15px 0}summary{cursor:pointer;font-weight:650}.button{display:inline-block;background:#176b98;border-radius:8px;color:#fff;text-decoration:none;padding:12px 20px;font-weight:650;margin-top:12px}footer{border-top:1px solid #dce6ea;padding:20px;text-align:center;color:#5d7380;font-size:13px}@media(max-width:600px){.numbers{grid-template-columns:1fr}main{padding:26px 18px 60px}td,th{font-size:14px;padding:11px 7px}}
</style></head><body><span aria-current="page" class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)">{traditional?'繁體中文':'简体中文'}</span><header class="top"><nav class="nav"><a href="/" class="brand">Saipan IVF</a><span><a href="/guides/">{t('指南中心','指南中心')}</a> · <a href={traditional?'/guides/ivf-cost/':'/zh-hant/guides/ivf-cost/'}>{traditional?'简体中文':'繁體中文'}</a></span></nav></header><main><div class="hero"><span class="muted">{t('2026 费用规划指南','2026 費用規劃指南')}</span><h1>{title}</h1><p class="muted">{description}</p><div class="numbers"><div class="number"><small>{t('IVF 取卵培养 + 药物 + 麻醉','IVF 取卵培養 + 藥物 + 麻醉')}</small><strong>{money(low)}–{money(high)}</strong><small>{t('规划假设，非诊所报价','規劃假設，非診所報價')}</small></div><div class="number"><small>{t('冷冻胚胎移植（另计）','冷凍胚胎植入（另計）')}</small><strong>{range(fet)}</strong><small>{t('不含相关移植药物','未含相關植入藥物')}</small></div></div><p class="alert"><strong>{t('重要说明：','重要說明：')}</strong> {t('本站仅展示规划预算，不是塞班接诊机构正式报价；也不是一次治疗到成功妊娠的总费用。','本站僅提供規劃預算，不是塞班接診機構正式報價，也不是治療至成功懷孕的總費用。')}</p></div>
<section><h2>{t('一、基础预算如何组成？','一、基本預算如何組成？')}</h2><div class="tablebox"><table><thead><tr><th>{t('费用项目','費用項目')}</th><th>USD</th></tr></thead><tbody>{rows.map(r=><tr><td>{r.label}</td><td>{range(r.data)}</td></tr>)}</tbody></table></div><p class="muted">{t('此表反映现有站内预算模型；不能用一次取卵与培养的数字代替完整试管治疗费用。','此表反映本站既有規劃模型；不可用一次取卵與培養費用代替完整試管療程總額。')}</p></section>
<section><h2>{t('二、还可能需要哪些费用？','二、還可能需要哪些費用？')}</h2><div class="tablebox"><table><thead><tr><th>{t('可能的额外项目','可能的額外項目')}</th><th>{t('规划金额 · USD','規劃金額 · USD')}</th></tr></thead><tbody>{extras.map(r=><tr><td>{r.label}</td><td>{range(r.data)}</td></tr>)}</tbody></table></div><p>{t('以上项目并非人人适用；是否需要 ICSI、遗传学检测、冷冻或移植，由医疗团队和个人情况决定。交通、住宿、取消周期、额外检查及再次取卵也可能造成支出。','以上項目並非人人適用；是否需要 ICSI、遺傳學檢測、冷凍或植入，須由醫療團隊依個人情況決定。交通、住宿、取消週期、額外檢查及再次取卵也可能產生費用。')}</p></section>
<section><h2>{t('三、拿到书面报价后核对什么？','三、取得書面報價後核對什麼？')}</h2><ol><li>{t('确认治疗机构、收款主体、报价币种、有效期。','確認治療機構、收款單位、報價幣別與有效期限。')}</li><li>{t('逐项确认药物、麻醉、取卵、培养与移植是否包含。','逐項確認藥物、麻醉、取卵、培養及植入是否包含。')}</li><li>{t('确认取消、无卵可取、没有可用胚胎、延期的结算规则。','確認取消、未取得卵子、沒有可用胚胎或延期時的收費規則。')}</li><li>{t('确定就诊次数、随访方式和返程计划后，再核算旅费。','確認就診次數、追蹤方式與返程規劃後，再估算旅費。')}</li></ol></section>
<section><h2>{t('常见问题','常見問題')}</h2>{qas.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section><h2>{t('来源与下一步','來源與下一步')}</h2><p>{t('本站预算模型核对日期：2026-10-26。真实诊所收费需单独确认。','本站規劃模型核對日期：2026-10-26。實際診所收費仍須另行確認。')}</p><p><a href="https://www.nhs.uk/tests-and-treatments/ivf/">{t('英国 NHS：IVF 治疗基本过程','英國 NHS：IVF 療程基本流程')}</a> · <a href="/guides/quotation/">{t('报价核对清单','報價核對清單')}</a> · <a href="/guides/ivf-steps/">{t('IVF 阶段准备','IVF 階段準備')}</a> · <a href="/fees/">{t('交互费用工具','互動費用工具')}</a></p><a href="/contact/" class="button">{t('咨询个人治疗方案及报价','諮詢個人療程與報價')}</a></section><aside class="contact-direct" style="max-width:950px;margin:0 auto 24px;padding:0 22px"><a href="mailto:info@saipan-ivf.com">{t('直接邮件联系：info@saipan-ivf.com','直接電郵聯絡：info@saipan-ivf.com')}</a></aside></main><footer>© 2026 Saipan IVF · {t('本页不是医疗建议或正式报价。','本頁不構成醫療建議或正式報價。')}</footer></body></html>