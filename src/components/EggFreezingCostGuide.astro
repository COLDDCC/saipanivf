---
import {pricing} from '../data/pricing';
import {site} from '../data/site';
import '../styles/site.css';
import '../styles/typography.css';
const {traditional=false}=Astro.props;
const t=(cn:string,tw:string)=>traditional?tw:cn;
const p=(id:string)=>pricing.find(x=>x.id===id)!;
const egg=p('egg'),drug=p('medication'),anesthesia=p('anesthesia'),storage=p('storage');
const lower=egg.min+drug.min+anesthesia.min+storage.min;
const upper=egg.max+drug.max+anesthesia.max+storage.max;
const midpoint=Math.round((lower+upper)/2/100)*100;
const money=(n:number)=>'US$'+n.toLocaleString('en-US');
const num=(n:number)=>n.toLocaleString('en-US');
// Labelled travel estimates (USD): public fare and hotel comparison ranges checked 2026-10-26.
// Hotel = about 14 nights; misc = meals, local transport and phone for about 14 days.
const checked='2026-10-26';
const usdCny=6.68;
const cny=(n:number)=>'¥'+(n*usdCny/10000).toFixed(1)+t(' 万',' 萬');
const tiers=[
 {name:t('节约型','節約型'),drug:drug.min,flight:450,hotel:1050,misc:500},
 {name:t('常规型','一般型'),drug:Math.round((drug.min+drug.max)/2/100)*100,flight:700,hotel:1600,misc:600},
 {name:t('宽裕型','寬裕型'),drug:drug.max,flight:1000,hotel:2300,misc:700}
].map(x=>({...x,travel:x.flight+x.hotel+x.misc,total:egg.min+x.drug+anesthesia.min+storage.min+x.flight+x.hotel+x.misc}));
const travelLow=tiers[0].travel,travelHigh=tiers[2].travel;
const totalLow=lower+travelLow,totalHigh=upper+travelHigh;
const path=traditional?'/zh-hant/guides/egg-freezing-cost/':'/guides/egg-freezing-cost/';
const title=traditional?'塞班凍卵費用 2026：全部下來要多少錢？':'塞班冻卵费用 2026：全部下来要多少钱？';
const summary=traditional
 ?`去塞班凍卵，醫療費單週期約 ${money(lower)}–${num(upper)}（含首年保存），加上約兩週的機票住宿，全程約 ${money(totalLow)}–${num(totalHigh)}。附三檔預算、在島天數、多年保存費與付款前核對清單。`
 :`去塞班冻卵，医疗费单周期约 ${money(lower)}–${num(upper)}（含首年保存），加上约两周的机票住宿，全程约 ${money(totalLow)}–${num(totalHigh)}（约 ¥${Math.round(totalLow*usdCny/10000)}–${Math.round(totalHigh*usdCny/10000)} 万）。附三档预算、在岛天数、多年保存费与付款前核对清单。`;
const canonical=new URL(path,site.origin).href;
const rows: Array<[string,{min:number,max:number},string,string]>=[
 [t('冻卵周期','凍卵週期'),egg,t('每个周期一次','每個週期一次'),t('含监测、取卵和冷冻','含監測、取卵與冷凍')],
 [t('促排药物','促排藥物'),drug,t('按处方','依處方'),t('方案和用量因人而异，差别很大','療程與用量因人而異，差異很大')],
 [t('取卵麻醉','取卵麻醉'),anesthesia,t('每次取卵','每次取卵'),t('方式由医生决定','方式由醫師決定')],
 [t('首年冷冻保存','首年冷凍保存'),storage,t('每年续交','每年續繳'),t('计费周期以合同为准','計費週期依合約為準')]
];
const range=(x:{min:number,max:number})=>x.min===x.max?num(x.min):num(x.min)+'–'+num(x.max);
const days=[
 [t('促排与监测','促排與監測'),'9–12',t('每天注射，期间约 5–7 次 B 超和抽血','每天注射，期間約 5–7 次超音波與抽血')],
 [t('夜针到取卵','破卵針到取卵'),'1.5',t('打夜针后约 34–36 小时取卵','施打破卵針後約 34–36 小時取卵')],
 [t('取卵后观察','取卵後觀察'),'1–2',t('多数人隔天可正常活动；乘机前先问医生','多數人隔天可恢復日常活動；搭機前先問醫師')]
];
const years=[1,5,10];
const faq=[
 [t('去塞班冻卵，全部下来大概多少钱？','去塞班凍卵，全部下來大概多少錢？'),traditional?`全程規劃預算約 ${money(totalLow)}–${num(totalHigh)}，包含醫療費、首年保存與約兩週的機票住宿；最終以診所書面報價為準。`:`全程规划预算约 ${money(totalLow)}–${num(totalHigh)}（约 ${cny(totalLow)}–${cny(totalHigh)}），包含医疗费、首年保存和约两周的机票住宿；最终以诊所书面报价为准。`],
 [t('要在塞班待多久？','要在塞班待多久？'),t('一般约 12–16 天；如果诊所接受你先在当地完成前几次监测，在岛时间约 7–10 天，需要医生看过报告后确认。','一般約 12–16 天；如果診所接受你先在居住地完成前幾次監測，在島時間約 7–10 天，須由醫師看過報告後確認。')],
 [t('可以分两次去塞班吗？','可以分兩次去塞班嗎？'),t('有的人先到诊所面诊、制定方案，回去后再按约定时间开始促排。是否可行、要去几次，由诊所根据你的报告安排；两次往返的机票要算进预算。','有些人先到診所面診、擬定療程，回去後再依約定時間開始促排。是否可行、要去幾次，由診所依你的報告安排；兩次往返機票要算進預算。')],
 [t('单身可以在塞班冻卵吗？','單身可以在塞班凍卵嗎？'),t('美国（含北马里亚纳群岛）没有联邦层面禁止单身女性冻卵的规定，具体以诊所政策为准，咨询时直接问即可。','美國（含北馬利安納群島）沒有聯邦層級禁止單身女性凍卵的規定，具體依診所政策為準，諮詢時直接詢問即可。')],
 [t('一次能冻多少颗卵？','一次能凍幾顆卵？'),t('因人而异，取决于年龄、卵巢储备和这一周期的反应，取卵后才能确定。医生会告知取卵数、成熟卵数和实际冷冻数。','因人而異，取決於年齡、卵巢庫存與這次週期的反應，取卵後才能確定。醫師會告知取卵數、成熟卵數與實際冷凍數。')],
 [t('冻好的卵以后能带回国使用吗？','凍好的卵子以後能帶回台灣使用嗎？'),t('需要同时确认保存诊所的转出流程、接收机构的要求，以及两地的相关法规，建议签约前就问清楚。','需要同時確認保存診所的轉出流程、接收機構的要求，以及兩地相關法規，建議簽約前就問清楚。')]
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
const hfea='https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/';
const asrm='https://www.asrm.org/practice-guidance/practice-committee-documents/evidence-based-outcomes-after-oocyte-cryopreservation-for-donor-oocyte-in-vitro-fertilization-and-planned-oocyte-cryopreservation-a-guideline-2021/';
const timeline='https://fertilityinstitute.com/egg-freezing-timeline/';
---
<!doctype html>
<html lang={traditional?'zh-Hant':'zh-CN'}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} · Saipan IVF</title><meta name="description" content={summary}/>
<link rel="canonical" href={canonical}/>
<link rel="alternate" hreflang="zh-CN" href={new URL('/guides/egg-freezing-cost/',site.origin).href}/>
<link rel="alternate" hreflang="zh-Hant" href={new URL('/zh-hant/guides/egg-freezing-cost/',site.origin).href}/>
<link rel="alternate" hreflang="x-default" href={new URL('/guides/egg-freezing-cost/',site.origin).href}/>
<meta property="og:title" content={title}/><meta property="og:description" content={summary}/><meta property="og:type" content="article"/><meta property="og:url" content={canonical}/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
<style>
*{box-sizing:border-box}body{margin:0;color:#203b4d;background:#fbfcfc;font-family:system-ui,-apple-system,"Noto Sans TC","Noto Sans SC",sans-serif;line-height:1.75}a{color:#1169a0}header{border-bottom:1px solid #e2ebee;background:#fff}.bar{max-width:1000px;margin:auto;padding:15px 24px;display:flex;justify-content:space-between;gap:18px;align-items:center}.brand{font-weight:750;text-decoration:none;color:#153f58}.switch{font-size:14px}main{max-width:960px;padding:38px 24px 80px;margin:auto}.eyebrow{color:#527286;font-size:13px;letter-spacing:.08em}.hero{padding-bottom:25px;border-bottom:1px solid #dce7ea}h1{font-size:clamp(30px,4vw,46px);line-height:1.22;letter-spacing:-.03em;margin:12px 0 16px}h2{font-size:clamp(22px,3vw,30px);line-height:1.3;margin:42px 0 16px}h3{font-size:18px}p{max-width:750px}.lead{font-size:17px;color:#476475}.notice{border-left:3px solid #498aab;padding:14px 18px;background:#edf5f8;margin:22px 0}table{width:100%;border-collapse:collapse;font-size:15px}th,td{text-align:left;padding:14px;border-bottom:1px solid #dce7ea}th{background:#eef4f5}.tablewrap{overflow:auto}td:last-child,th:last-child{text-align:right;white-space:nowrap}ul,ol{padding-left:25px}li{margin:8px 0}details{border-bottom:1px solid #dce7ea;padding:14px 0}summary{cursor:pointer;font-weight:650}details p{margin-bottom:0}.cta{display:inline-block;background:#146b98;color:#fff;text-decoration:none;padding:13px 20px;border-radius:8px;font-weight:650}footer{padding:30px 24px;text-align:center;border-top:1px solid #dce7ea;color:#587080;font-size:13px}@media(max-width:780px){th,td{padding:10px 7px;font-size:13px}main{padding:28px 18px 60px}}
.article-toc{display:flex;flex-wrap:wrap;gap:9px;padding:12px 0 19px;margin:0 0 16px;border-bottom:1px solid #e2e9ed}.article-toc a{padding:6px 12px;border:1px solid #d6e4e8;border-radius:99px;text-decoration:none;font-size:13px;background:white;color:#2d536b}.article-toc a:hover,.article-toc a:focus-visible{background:#e9f3f7}section{scroll-margin-top:20px}.kicker{display:block;color:#397794;text-transform:uppercase;letter-spacing:.1em;font-size:12px;font-weight:700}.steps{display:grid;gap:0;margin:20px 0}.steps article{display:grid;grid-template-columns:52px 1fr;gap:16px;border-top:1px solid #dce7ea;padding:17px 0}.steps article span{font-size:18px;font-weight:750;color:#287795}.steps h3{margin:0 0 4px}.steps p{margin:0;color:#506a78}.hero{padding-top:12px}@media(min-width:800px){.hero{max-width:880px}.article-toc{position:sticky;top:0;z-index:2;background:#fbfcfc}}.source-ref{font-size:12px;white-space:nowrap;text-decoration:none;padding:1px 4px;font-weight:750;color:#146a95;background:#e7f3f7;border-radius:4px}.source-ref:hover,.source-ref:focus-visible{text-decoration:underline}.source-caption{font-size:13px;color:#536e7d;margin:12px 0 20px}.reference-list li{margin:10px 0;overflow-wrap:anywhere}.reference-list a{font-weight:600}.byline{display:flex;flex-wrap:wrap;gap:8px 18px;color:#537187;font-size:13px;padding:0 0 6px}.byline a{font-weight:600}
.answer{margin:24px 0 8px;padding:22px 24px;border:1px solid #cfe1e8;border-radius:14px;background:#f2f8fa}.answer h2{margin:0 0 4px;font-size:15px;letter-spacing:.06em;color:#397794}.answer .total{display:block;font-size:clamp(26px,4vw,38px);font-weight:750;line-height:1.3;color:#153f58;margin:4px 0 14px}.answer .total small{display:block;font-size:15px;font-weight:600;color:#476475}.answer table{background:#fff;border-radius:8px}.answer p{margin:12px 0 0;font-size:14px;color:#476475}.answer .cta{margin-top:14px}.total-row td{font-weight:750;background:#f6fafb}.text-table td:last-child,.text-table th:last-child{text-align:left;white-space:normal}.ready{margin:22px 0;padding:16px 20px;border-left:3px solid #146b98;background:#eef6f9}.ready p{margin:0 0 10px}.tip-list li{margin:6px 0}.num{white-space:nowrap}@media(max-width:700px){.answer{padding:16px}}
</style>
</head>
<body>
<header><nav class="bar" aria-label={t('页面导航','頁面導覽')}><a class="brand" href="/">Saipan IVF</a><div class="switch"><a href="/guides/">{t('全部指南','全部指南')}</a> · <a href={traditional?'/guides/egg-freezing-cost/':'/zh-hant/guides/egg-freezing-cost/'}>{traditional?'简体中文':'繁體中文'}</a></div></nav></header>
<main>
<nav class="article-toc" aria-label={t('文章目录','文章目錄')}><a href="#tiers">{t('三档预算','三檔預算')}</a><a href="#cost-breakdown">{t('医疗费','醫療費')}</a><a href="#travel">{t('行程费用','行程費用')}</a><a href="#days">{t('在岛天数','在島天數')}</a><a href="#storage-years">{t('多年保存','多年保存')}</a><a href="#compare">{t('付款前核对','付款前核對')}</a><a href="#reference">{t('其他地区','其他地區')}</a><a href="#questions">FAQ</a><a href="#sources">{t('来源','來源')}</a></nav>
<div class="hero"><div class="eyebrow">{t('费用指南 · 2026 · 美元','費用指南 · 2026 · 美元')}</div><h1>{title}</h1>
<div class="byline"><span>{t('撰写：Saipan IVF 网站内容团队','撰寫：Saipan IVF 網站內容團隊')}</span><span>{t('页面更新：2026 年 10 月 26 日','頁面更新：2026 年 10 月 26 日')}</span><a href="/editorial-policy/">{t('编辑与资料来源政策','編輯與資料來源政策')}</a></div>
<section class="answer" aria-labelledby="answer-title"><h2 id="answer-title">{t('30 秒答案','30 秒答案')}</h2>
<strong class="total">{t('全程预算约','全程預算約')} {money(totalLow)}–{num(totalHigh)}{!traditional&&<small>{t('约','约')} {cny(totalLow)}–{cny(totalHigh)}</small>}</strong>
<div class="tablewrap"><table><thead><tr><th>{t('项目','項目')}</th><th>USD</th>{!traditional&&<th>{t('约合人民币','约合人民币')}</th>}</tr></thead><tbody>
<tr><td>{t('医疗费（周期 + 药 + 麻醉 + 首年保存）','醫療費（週期 + 藥物 + 麻醉 + 首年保存）')}</td><td class="num">{num(lower)}–{num(upper)}</td>{!traditional&&<td class="num">{cny(lower)}–{cny(upper)}</td>}</tr>
<tr><td>{t('行程（机票 + 约 14 晚住宿 + 当地生活）','行程（機票 + 約 14 晚住宿 + 當地生活）')}</td><td class="num">{num(travelLow)}–{num(travelHigh)}</td>{!traditional&&<td class="num">{cny(travelLow)}–{cny(travelHigh)}</td>}</tr>
<tr class="total-row"><td>{t('合计','合計')}</td><td class="num">{num(totalLow)}–{num(totalHigh)}</td>{!traditional&&<td class="num">{cny(totalLow)}–{cny(totalHigh)}</td>}</tr>
</tbody></table></div>
<p>{t('差距最大的是促排药费（按个人处方）和住宿档次。医疗费来自本站规划模型，行程费按 2026 年 10 月公开比价区间估算，都不是诊所报价；最终以书面报价为准。','差距最大的是促排藥費（依個人處方）與住宿等級。醫療費來自本站規劃模型，行程費依 2026 年 10 月公開比價區間估算，皆非診所報價；最終以書面報價為準。')}{!traditional&&<> {t(`人民币按 1 美元 ≈ ${usdCny} 元粗算。`,'')}</>}{traditional&&<> 以新台幣付款時，請依付款當日匯率換算。</>}</p>
<a class="cta" href="/contact/?topic=egg-freezing">{t('发报告，估我的个人预算','傳報告，估我的個人預算')}</a>
</section></div>

<section id="tiers"><h2>{t('三档预算：你大概属于哪一档？','三檔預算：你大概屬於哪一檔？')}</h2><div class="tablewrap"><table><thead><tr><th>{t('项目 · USD','項目 · USD')}</th>{tiers.map(x=><th>{x.name}</th>)}</tr></thead><tbody>
<tr><td>{t('冻卵周期','凍卵週期')}</td>{tiers.map(()=><td class="num">{num(egg.min)}</td>)}</tr>
<tr><td>{t('促排药物','促排藥物')}</td>{tiers.map(x=><td class="num">{num(x.drug)}</td>)}</tr>
<tr><td>{t('取卵麻醉','取卵麻醉')}</td>{tiers.map(()=><td class="num">{num(anesthesia.min)}</td>)}</tr>
<tr><td>{t('首年保存','首年保存')}</td>{tiers.map(()=><td class="num">{num(storage.min)}</td>)}</tr>
<tr><td>{t('往返机票（1 人）','往返機票（1 人）')}</td>{tiers.map(x=><td class="num">{num(x.flight)}</td>)}</tr>
<tr><td>{t('住宿（约 14 晚）','住宿（約 14 晚）')}</td>{tiers.map(x=><td class="num">{num(x.hotel)}</td>)}</tr>
<tr><td>{t('当地吃饭交通杂费','當地餐飲交通雜費')}</td>{tiers.map(x=><td class="num">{num(x.misc)}</td>)}</tr>
<tr class="total-row"><td>{t('合计','合計')}</td>{tiers.map(x=><td class="num">{num(x.total)}</td>)}</tr>
{!traditional&&<tr><td>{t('约合人民币','约合人民币')}</td>{tiers.map(x=><td class="num">{cny(x.total)}</td>)}</tr>}
</tbody></table></div>
<ul><li>{t('药费档位不是自己选的，由医生根据检查和监测结果决定；这张表只是帮你提前准备资金。','藥費等級不是自己選的，由醫師依檢查與監測結果決定；這張表只是幫你提前準備資金。')}</li><li>{t('有家人陪同时，机票和杂费再加一份，住宿通常不用翻倍。','有家人陪同時，機票與雜費再加一份，住宿通常不必加倍。')}</li><li>{t('想按自己的情况增减项目，用','想依自己的情況增減項目，可使用')} <a href="/fees/">{t('预算工具','預算工具')}</a>{t('。','。')}</li></ul>
<div class="ready"><p><strong>{t('不确定自己在哪一档？','不確定自己在哪一檔？')}</strong>{t('把年龄和最近一次 AMH 或 B 超报告发给我们，我们按你的情况估一个更窄的预算区间，并整理成可以拿去比较的报价清单。','把年齡與最近一次 AMH 或超音波報告傳給我們，我們依你的情況估一個更窄的預算區間，並整理成可拿去比較的報價清單。')}</p><a class="cta" href="/contact/?topic=egg-freezing">{t('发送报告','傳送報告')}</a></div>
</section>

<section id="cost-breakdown"><h2>{t('医疗费分成哪几项？','醫療費分成哪些項目？')}</h2><div class="tablewrap"><table class="text-table"><thead><tr><th>{t('项目','項目')}</th><th>{t('规划价 · USD','規劃價 · USD')}</th><th>{t('收费性质','收費性質')}</th><th>{t('说明','說明')}</th></tr></thead><tbody>{rows.map(([label,row,kind,note])=><tr><td>{label}</td><td class="num">{range(row)}</td><td>{kind}</td><td>{note}</td></tr>)}<tr class="total-row"><td>{t('合计','合計')}</td><td class="num">{num(lower)}–{num(upper)}</td><td></td><td></td></tr></tbody></table></div>
<p><strong>{t('药费为什么差这么多？','藥費為什麼差這麼多？')}</strong>{t('促排药按每天剂量和用药天数计费。医生根据你的检查结果定方案，中途还会根据 B 超和抽血结果加减药，费用随之变化，所以别人花了多少对你参考意义不大。','促排藥依每日劑量與用藥天數計費。醫師依你的檢查結果擬定療程，過程中還會依超音波與抽血結果調整藥量，費用隨之變動，因此別人花多少對你參考價值不大。')}</p>
<p class="source-caption">{t(`单周期中间参考值 ${money(midpoint)} 只是方便心算，不是统计平均。费用表来源：本站 src/data/pricing.ts 规划假设（${checked} 核对），并非第三方研究或诊所确认报价。`,`單週期中間參考值 ${money(midpoint)} 只是方便心算，不是統計平均。費用表來源：本站 src/data/pricing.ts 規劃假設（${checked} 核對），並非第三方研究或診所確認報價。`)}</p></section>

<section id="travel"><h2>{t('行程费用怎么估？','行程費用怎麼估？')}</h2><div class="tablewrap"><table class="text-table"><thead><tr><th>{t('项目','項目')}</th><th>{t('参考范围','參考範圍')}</th><th>{t('估算依据','估算依據')}</th></tr></thead><tbody>
<tr><td>{t('往返机票','往返機票')}</td><td class="num">{t('¥3,000–6,500（约 US$450–1,000）','約 US$450–1,000')}</td><td>{t('上海出发经停 1 次的公开比价区间；淡季（如 11 月）较便宜，春节前后较贵','以中國大陸出發經停 1 次的公開比價區間估算；從台灣出發請依實際票價調整')}</td></tr>
<tr><td>{t('住宿','住宿')}</td><td class="num">{t('每晚 US$70–180','每晚 US$70–180')}</td><td>{t('加拉潘一带：经济型约 US$50–70，三星约 US$70–120，四星及以上约 US$120 起','加拉班一帶：經濟型約 US$50–70，三星約 US$70–120，四星以上約 US$120 起')}</td></tr>
<tr><td>{t('当地杂费','當地雜費')}</td><td class="num">{t('每天 US$30–60','每天 US$30–60')}</td><td>{t('吃饭、打车或租车、电话卡；编辑按住宿档次推算','餐飲、計程車或租車、電話卡；編輯依住宿等級推算')}</td></tr>
</tbody></table></div>
<ul class="tip-list"><li>{t('住两周以上，可以问酒店或公寓有没有长住价。','住兩週以上，可詢問飯店或公寓是否有長住價。')}</li><li>{t('选离诊所近的住处：监测期间几乎隔天就要去一次。','選離診所近的住處：監測期間幾乎隔天就要回診一次。')}</li><li>{t('回程机票买可改签的，取卵日可能比预计提前或推后 1–3 天。','回程機票選可改期的，取卵日可能比預計提前或延後 1–3 天。')}</li><li>{t('出发前按最新官方要求确认入境手续，见','出發前依最新官方規定確認入境手續，見')} <a href="/guides/travel-checklist/">{t('跨境就诊清单','跨境就診清單')}</a>{t('。','。')}</li></ul>
<p class="source-caption">{t(`行程费为 ${checked} 公开机票与酒店比价页面区间的估算，实际以预订当日价格为准。`,`行程費為 ${checked} 公開機票與飯店比價頁面區間的估算，實際以預訂當日價格為準。`)}</p></section>

<section id="days"><h2>{t('要在塞班待几天？','要在塞班待幾天？')}</h2><div class="tablewrap"><table class="text-table"><thead><tr><th>{t('阶段','階段')}</th><th>{t('大约天数','大約天數')}</th><th>{t('在做什么','在做什麼')}</th></tr></thead><tbody>{days.map(([stage,d,what])=><tr><td>{stage}</td><td class="num">{d} {t('天','天')}</td><td>{what}</td></tr>)}<tr class="total-row"><td>{t('合计','合計')}</td><td class="num">{t('约 12–16 天','約 12–16 天')}</td><td></td></tr></tbody></table></div>
<p>{t('如果诊所接受你先在当地完成前几次监测，在岛时间可以缩短到约 7–10 天。能否这样安排，要医生看过你的报告后确认。','如果診所接受你先在居住地完成前幾次監測，在島時間可縮短到約 7–10 天。能否這樣安排，須由醫師看過你的報告後確認。')} <a class="source-ref" href={timeline} target="_blank" rel="noopener noreferrer" aria-label={t('来源 4：冻卵典型时间线','來源 4：凍卵典型時間線')}>[4]</a></p>
<p class="notice">{t('这是一般流程的典型天数，不是你个人的日程。不要按这张表购买不可退的机票。','這是一般流程的典型天數，不是你個人的行程。請勿依這張表購買不可退票的機票。')}</p></section>

<section id="storage-years"><h2>{t('保存 5 年、10 年要多少？','保存 5 年、10 年要多少？')}</h2><p>{t(`保存费每年续交。假设年费维持 ${money(storage.min)}（以合同为准）：`,`保存費每年續繳。假設年費維持 ${money(storage.min)}（依合約為準）：`)}</p><div class="tablewrap"><table><thead><tr><th>{t('保存年限','保存年限')}</th><th>{t('保存费累计 · USD','保存費累計 · USD')}</th><th>{t('医疗费合计 · USD','醫療費合計 · USD')}</th></tr></thead><tbody>{years.map(y=><tr><td>{y} {t('年','年')}</td><td class="num">{num(storage.min*y)}</td><td class="num">{num(lower+storage.min*(y-1))}–{num(upper+storage.min*(y-1))}</td></tr>)}</tbody></table></div>
<p>{t('签约前问清：续费会不会涨价、忘了续费怎么处理、以后转到别的诊所使用的流程和费用。','簽約前問清楚：續費會不會調漲、忘記續費如何處理、日後轉到其他診所使用的流程與費用。')}</p></section>

<section id="cost-surprises"><h2>{t('为什么两个人最后花的钱差很多？','為什麼兩個人最後花的錢差很多？')}</h2><ol><li><strong>{t('药量不同。','藥量不同。')}</strong>{t('这是最大的变量。','這是最大的變數。')}</li><li><strong>{t('需要再做一个周期。','需要再做一個週期。')}</strong>{t('第二个周期要重新报价，药费和行程也要再算一次；不要把单周期预算直接乘二。','第二個週期須重新報價，藥費與行程也要再算一次；不要把單週期預算直接乘以二。')}</li><li><strong>{t('周期延期或取消。','週期延期或取消。')}</strong>{t('卵泡反应太差或太强时，医生可能建议取消或改方案。先问清楚这种情况怎么收费。','卵泡反應過差或過強時，醫師可能建議取消或調整療程。先問清楚這種情況如何收費。')}</li><li><strong>{t('将来使用另外收费。','未來使用另外收費。')}</strong>{t('解冻、ICSI 受精、胚胎培养、移植和跨诊所转运，都不在冻卵费里。','解凍、ICSI 受精、胚胎培養、植入與跨診所運送，都不在凍卵費內。')}</li></ol><p class="source-caption">{t('以上为预算情境，不是治疗建议，不代表每个人都需要多次取卵，也没有推算未来怀孕的成功概率。','以上是預算情境，不是治療建議，也不代表每個人都需要多次取卵，亦未推估未來懷孕機率。')}</p></section>

<section id="compare"><h2>{t('付款前必须确认的 6 件事','付款前必須確認的 6 件事')}</h2><ol><li>{t('实际接诊机构、收款方、报价日期和有效期。','實際接診機構、收款方、報價日期與有效期限。')}</li><li>{t('监测、取卵、麻醉、冷冻、药物各包含什么，哪些另收。','監測、取卵、麻醉、冷凍、藥物各包含什麼，哪些另計。')}</li><li>{t('这份价格是否适用外籍、跨境患者——有的公开套餐只限本国居民。','這份價格是否適用外籍、跨境患者——有些公開方案只限本國居民。')}</li><li>{t('保存地点、每年续费、终止或转出的规则。','保存地點、每年續費、終止或轉出的規則。')}</li><li>{t('取不到卵、周期取消或延期时的收费和退款规则。','未取得卵子、週期取消或延期時的收費與退款規則。')}</li><li>{t('由诊所医生确认抵达日期后再订机票。','由診所醫師確認抵達日期後再訂機票。')}</li></ol><p>{t('拿到报价后，用','拿到報價後，可用')} <a href="/guides/quotation/">{t('书面报价核对清单','書面報價核對清單')}</a> {t('逐条对照。','逐項對照。')}</p></section>

<section id="medical"><span class="kicker">{t('医学证据','醫學證據')}</span><h2>{t('冻卵能保证未来怀孕吗？','凍卵能保證未來懷孕嗎？')}</h2><p>{t('不能。冻卵保存的是生育选择，不是未来活产的保证；结果取决于取卵时年龄、成熟卵子数量，以及解冻、受精和后续治疗等多种因素。','不能。凍卵保留的是生育選擇，不是未來活產的保證；結果取決於取卵時年齡、成熟卵子數量，以及解凍、受精與後續療程等多種因素。')} <a class="source-ref" href={hfea} target="_blank" rel="noopener noreferrer" aria-label={t('来源 1：HFEA 冻卵说明','來源 1：HFEA 凍卵說明')}>[1]</a></p><p>{t('美国生殖医学学会（ASRM）指出，较年轻时冷冻卵子的结果总体可能更好，但现有证据不足以对个人做可靠的绝对活产率预测，也不存在普遍适用的最佳冻卵年龄。','美國生殖醫學學會（ASRM）指出，較年輕時冷凍卵子的結果整體可能較佳，但目前證據不足以可靠預測個人的絕對活產率，也沒有所有人通用的最佳凍卵年齡。')} <a class="source-ref" href={asrm} target="_blank" rel="noopener noreferrer" aria-label={t('来源 2：ASRM 循证指南','來源 2：ASRM 實證指引')}>[2]</a> {t('还在犹豫的话，可以先和医生讨论做卵巢储备评估（如 AMH、窦卵泡计数），这也有助于提前估算药量和预算。','還在猶豫的話，可以先和醫師討論卵巢庫存評估（如 AMH、竇卵泡數），也有助於提前估算藥量與預算。')}</p><p>{t('如有卵巢功能或既往取卵问题、正在接受其他治疗，或对麻醉、药物有特殊顾虑，请先由医疗团队评估；不要根据本文自行选择促排药物或剂量。','如有卵巢功能或先前取卵問題、正在接受其他療程，或對麻醉、藥物有特殊顧慮，請先由醫療團隊評估；請勿依本文自行選用促排藥物或劑量。')} <a class="source-ref" href={hfea} target="_blank" rel="noopener noreferrer">[1]</a></p></section>

