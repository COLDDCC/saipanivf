---
import {pricing} from '../data/pricing';
import {site} from '../data/site';
import '../styles/site.css';
import '../styles/typography.css';
const {traditional=false}=Astro.props;
const p=(id:string)=>pricing.find(x=>x.id===id)!;
const egg=p('egg'),drug=p('medication'),anesthesia=p('anesthesia'),storage=p('storage');
const lower=egg.min+drug.min+anesthesia.min+storage.min;
const upper=egg.max+drug.max+anesthesia.max+storage.max;
const money=(n:number)=>'US$'+n.toLocaleString('en-US');
const path=traditional?'/zh-hant/guides/egg-freezing-cost/':'/guides/egg-freezing-cost/';
const title=traditional?'塞班凍卵費用 2026：療程、藥物與保存費怎麼算？':'塞班冻卵费用 2026：周期、药费、保存费如何计算？';
const summary=traditional?'了解塞班凍卵費用的估算方式、藥物與麻醉另計、年度保存費，以及赴塞班前應核對的報價項目。':'了解塞班冻卵费用的估算方式、促排药物、麻醉及年度保存费，出发前核对书面报价。';
const t=(cn,tw)=>traditional?tw:cn;
const canonical=new URL(path,site.origin).href;
const faq=[
[t('预算就是诊所报价吗？','估算等於診所報價嗎？'),t('不是。下表使用本站规划假设，实际项目、费用和付款条件以诊所正式书面报价为准。','不是。下表使用本站規劃假設，實際項目、費用與付款條件以診所正式書面報價為準。')],
[t('每个人都需要相同的促排药量吗？','每個人都需要相同的促排藥量嗎？'),t('不一定。医生根据个人评估和监测调整方案，药费应按实际处方核算。','不一定。醫師根據個人評估與監測調整方案，藥費應依實際處方核算。')],
[t('保存费用只交一次吗？','保存費用只繳一次嗎？'),t('通常应特别核对年度续费、续存授权、停止保存和后续使用费用；具体看合同。','應特別核對年度續費、續存授權、停止保存及未來使用費用；具體依合約為準。')],
[t('冻卵能保证未来生育吗？','凍卵能保證未來生育嗎？'),t('不能。结果取决于年龄、卵子数量与质量、未来解冻受精等多种因素。','不能。結果取決於年齡、卵子數量與品質，以及未來解凍、受精等多種因素。')]
];
const rows: Array<[string,{min:number,max:number}]>=[
[t('冻卵周期：监测、取卵、冷冻','凍卵週期：監測、取卵、冷凍'),egg],
[t('促排药物','促排藥物'),drug],
[t('取卵麻醉','取卵麻醉'),anesthesia],
[t('首年保存预算（需确认计费周期）','首年保存預算（須確認計費週期）'),storage]
];
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))};
---
<!doctype html>
<html lang={traditional?'zh-Hant':'zh-CN'}>
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} · Saipan IVF</title><meta name="description" content={summary}/>
<link rel="canonical" href={canonical}/>
<link rel="alternate" hreflang="zh-CN" href={new URL('/guides/egg-freezing-cost/',site.origin).href}/>
<link rel="alternate" hreflang="zh-Hant" href={new URL('/zh-hant/guides/egg-freezing-cost/',site.origin).href}/>
<link rel="alternate" hreflang="x-default" href={new URL('/guides/egg-freezing-cost/',site.origin).href}/>
<meta property="og:title" content={title}/><meta property="og:description" content={summary}/><meta property="og:type" content="article"/><meta property="og:url" content={canonical}/>
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}/>
<style>
*{box-sizing:border-box}body{margin:0;color:#203b4d;background:#fbfcfc;font-family:system-ui,-apple-system,"Noto Sans TC","Noto Sans SC",sans-serif;line-height:1.75}a{color:#1169a0}header{border-bottom:1px solid #e2ebee;background:#fff}.bar{max-width:1000px;margin:auto;padding:15px 24px;display:flex;justify-content:space-between;gap:18px;align-items:center}.brand{font-weight:750;text-decoration:none;color:#153f58}.switch{font-size:14px}main{max-width:960px;padding:38px 24px 80px;margin:auto}.eyebrow{color:#527286;font-size:13px;letter-spacing:.08em}.hero{padding-bottom:25px;border-bottom:1px solid #dce7ea}h1{font-size:clamp(30px,4vw,46px);line-height:1.22;letter-spacing:-.03em;margin:12px 0 16px}h2{font-size:clamp(22px,3vw,30px);line-height:1.3;margin:42px 0 16px}h3{font-size:18px}p{max-width:750px}.lead{font-size:17px;color:#476475}.notice{border-left:3px solid #498aab;padding:14px 18px;background:#edf5f8;margin:22px 0}.metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin:25px 0}.metric{background:#eaf3f5;border-radius:12px;padding:21px}.metric strong{font-size:clamp(22px,3vw,32px);display:block;line-height:1.4}.metric small{display:block;color:#476475}table{width:100%;border-collapse:collapse;font-size:15px}th,td{text-align:left;padding:14px;border-bottom:1px solid #dce7ea}th{background:#eef4f5}.tablewrap{overflow:auto}td:last-child,th:last-child{text-align:right;white-space:nowrap}ul{padding-left:25px}li{margin:8px 0}details{border-bottom:1px solid #dce7ea;padding:14px 0}summary{cursor:pointer;font-weight:650}details p{margin-bottom:0}.cta{display:inline-block;background:#146b98;color:#fff;text-decoration:none;padding:13px 20px;border-radius:8px;font-weight:650}footer{padding:30px 24px;text-align:center;border-top:1px solid #dce7ea;color:#587080;font-size:13px}@media(max-width:600px){.metrics{grid-template-columns:1fr}th,td{padding:10px 7px;font-size:13px}main{padding:28px 18px 60px}}
 .article-toc{display:flex;flex-wrap:wrap;gap:9px;padding:12px 0 19px;margin:0 0 16px;border-bottom:1px solid #e2e9ed}.article-toc a{padding:6px 12px;border:1px solid #d6e4e8;border-radius:99px;text-decoration:none;font-size:13px;background:white;color:#2d536b}.article-toc a:hover,.article-toc a:focus-visible{background:#e9f3f7}section{scroll-margin-top:20px}.kicker{display:block;color:#397794;text-transform:uppercase;letter-spacing:.1em;font-size:12px;font-weight:700}.steps{display:grid;gap:0;margin:20px 0}.steps article{display:grid;grid-template-columns:52px 1fr;gap:16px;border-top:1px solid #dce7ea;padding:17px 0}.steps article span{font-size:18px;font-weight:750;color:#287795}.steps h3{margin:0 0 4px}.steps p{margin:0;color:#506a78}.journey,.decision{margin-top:36px}.decision{border-top:1px solid #dce7ea} .hero{padding-top:12px} @media(min-width:800px){.hero{max-width:880px}.article-toc{position:sticky;top:0;z-index:2;background:#fbfcfc}} .source-ref{font-size:12px;white-space:nowrap;text-decoration:none;padding:1px 4px;font-weight:750;color:#146a95;background:#e7f3f7;border-radius:4px}.source-ref:hover,.source-ref:focus-visible{text-decoration:underline}.evidence-intro,.clinical-evidence{border-top:1px solid #dce7ea}.source-caption{font-size:13px;color:#536e7d;margin:12px 0 20px}.reference-list li{margin:10px 0;overflow-wrap:anywhere}.reference-list a{font-weight:600}  .byline{display:flex;flex-wrap:wrap;gap:8px 18px;color:#537187;font-size:13px;padding:0 0 6px}.byline a{font-weight:600}.scenario-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:20px 0}.scenario-grid article{padding:20px;background:#f1f6f7;border:1px solid #e1eaec;border-radius:12px}.scenario-grid h3{font-size:17px;line-height:1.4;margin:0 0 10px}.scenario-grid p{font-size:14px;line-height:1.75;margin:0}.risk-note{border-top:1px solid #dce7ea}.budget-scope{border-top:1px solid #dce7ea}@media(max-width:700px){.scenario-grid{grid-template-columns:1fr}.scenario-grid article{padding:16px}} </style>
</head>
<body>
<header><nav class="bar" aria-label={t('页面导航','頁面導覽')}><a class="brand" href="/">Saipan IVF</a><div class="switch"><a href="/guides/">{t('全部指南','全部指南')}</a> · <a href={traditional?'/guides/egg-freezing-cost/':'/zh-hant/guides/egg-freezing-cost/'}>{traditional?'简体中文':'繁體中文'}</a></div></nav></header>
<main>
<nav class="article-toc" aria-label={t('文章目录','文章目錄')}><a href="#cost-breakdown">{t('费用明细','費用明細')}</a><a href="#cost-surprises">{t('额外开支','額外開支')}</a><a href="#journey">{t('赴塞班安排','赴塞班安排')}</a><a href="#compare">{t('决策清单','決策清單')}</a><a href="#questions">FAQ</a><a href="#sources">{t('来源','來源')}</a></nav>
<div class="hero"><div class="eyebrow">{t('费用指南 · 2026 · 美元','費用指南 · 2026 · 美元')}</div><h1>{title}</h1><p class="lead">{summary}</p>
<div class="byline"><span>{t('撰写：Saipan IVF 网站内容团队','撰寫：Saipan IVF 網站內容團隊')}</span><span>{t('页面更新：2026 年 10 月 26 日','頁面更新：2026 年 10 月 26 日')}</span><a href="/editorial-policy/">{t('编辑与资料来源政策','編輯與資料來源政策')}</a></div><div class="metrics"><div class="metric"><small>{t('单周期规划预算（含首年保存假设）','單週期規劃預算（含首年保存假設）')}</small><strong>{money(lower)}–{money(upper)}</strong><small>{t('不是机构报价，不含机票住宿等','非機構報價，不含機票住宿等')}</small></div><div class="metric"><small>{t('单独核对','請另外核對')}</small><strong>{t('药物 / 麻醉 / 保存','藥物 / 麻醉 / 保存')}</strong><small>{t('未来使用冷冻卵子费用另计','未來使用冷凍卵子的費用另計')}</small></div></div>
<div class="notice"><strong>{t('先看结论：','先看結論：')}</strong>{t('本站当前使用规划预算模型，并非塞班接诊机构确认的收费表。正式预约前，应向实际接诊及收款主体取得包含项目、排除项目和退费条件的书面报价。','本站目前使用規劃預算模型，並非塞班接診機構確認的收費表。正式預約前，請向實際接診及收款單位取得包含項目、排除項目與退費條件的書面報價。')}</div></div>
<section class="evidence-intro"><h2>{t('这份指南的证据如何使用？','這份指南的證據如何使用？')}</h2><p>{t('医学结论使用监管机构和专业医学组织的公开资料，并在相关段落就地标注。费用数字来自本站预算模型，不是引用文献中的治疗价格，也不是塞班诊所正式报价。','醫學結論依據監管機構與專業醫學組織公開資料，並在相關段落直接標註。費用數字來自本站規劃模型，不是文獻中的療程價格，也不是塞班診所正式報價。')}</p></section>
<section id="cost-breakdown"><h2>{t('冻卵费用分成哪几项？','凍卵費用分成哪些項目？')}</h2><div class="tablewrap"><table><thead><tr><th>{t('项目','項目')}</th><th>{t('本站规划假设 · USD','本站規劃假設 · USD')}</th></tr></thead><tbody>{rows.map(([label,row])=><tr><td>{label}</td><td>{row.min===row.max?money(row.min):money(row.min)+'–'+money(row.max)}</td></tr>)}</tbody></table></div><p><small>{t('模型来源：本站费用预算数据；含一次周期及首年保存的假设，不代表临床收费，也不保证所有项目适用于每个人。','模型來源：本站費用預算資料；假設一次週期與首年保存，不代表實際臨床收費，也不表示所有項目均適用。')}</small></p></section>
<p class="source-caption">{t('费用表数据来源：本站 src/data/pricing.ts 规划假设（2026-10-26 核对），并非第三方研究或诊所确认报价。','費用表資料來源：本站 src/data/pricing.ts 規劃假設（2026-10-26 核對），並非第三方研究或診所確認報價。')}</p>
<section id="budget-scope" class="budget-scope"><span class="kicker">{t('预算怎么使用','如何使用預算')}</span><h2>{t('为什么两位患者的最终费用可能差很多？','為什麼兩位患者的最終費用可能差很多？')}</h2><div class="scenario-grid"><article><h3>{t('仅完成一次冻卵周期','只完成一次凍卵週期')}</h3><p>{t('先核对基础取卵冷冻、药物、麻醉和第一年保存费，重点确认报价里每项是否已包含，避免重复加总。','先核對基本取卵冷凍、藥物、麻醉及第一年保存費，確認報價是否已包含每項，避免重複加總。')}</p></article><article><h3>{t('需要再次取卵','需要再次取卵')}</h3><p>{t('如果医生讨论第二次取卵，应索取新的周期报价。不要把一次治疗预算当成多次周期总额。','若醫師討論第二次取卵，請索取新的週期報價。切勿將一次療程預算當成多次週期總額。')}</p></article><article><h3>{t('未来计划使用冻卵','未來計劃使用凍卵')}</h3><p>{t('未来还可能涉及解冻、ICSI、胚胎培养、移植及跨机构转运；请单独询价并核实保存合同。','未來還可能涉及解凍、ICSI、胚胎培養、植入與跨機構運送；請另外詢價並確認保存合約。')}</p></article></div><p class="source-caption">{t('以上为预算场景，不是治疗建议，不代表每个人都需要多次取卵，也没有计算未来怀孕的成功概率。','以上是預算情境，不是治療建議，也不代表每個人都需要多次取卵，亦未推估未來懷孕機率。')}</p></section>
<section id="cost-surprises"><h2>{t('哪些费用容易漏算？','哪些費用容易漏算？')}</h2><ul><li>{t('额外检查、促排方案调整和药量变化','額外檢查、促排療程調整及藥量變化')}</li><li>{t('取卵前检查、麻醉及延期或取消','取卵前檢查、麻醉及延期或取消')}</li><li>{t('冷冻样本的年度续费、未来解冻及后续生育治疗','冷凍樣本的年度續費、未來解凍及後續生育療程')}</li><li>{t('航班、住宿、陪同、交通、返程及意外延长停留','航班、住宿、陪同、交通、返程及意外延長停留')}</li></ul></section>
<section class="clinical-evidence"><span class="kicker">{t('医学证据','醫學證據')}</span><h2>{t('冻卵能保证未来怀孕吗？','凍卵能保證未來懷孕嗎？')}</h2><p>{t('不能。冻卵只是保存生育选择，并不是未来活产的保证；未来是否成功还涉及取卵年龄、成熟卵子数量、解冻、受精和后续治疗等多种因素。','不能。凍卵是保留未來生育選擇，不是未來活產的保證；結果仍與取卵時年齡、成熟卵子數量、解凍、受精及後續療程等因素有關。')} <a class="source-ref" href="https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/" target="_blank" rel="noopener noreferrer" aria-label={t('来源 1：HFEA 冻卵说明','來源 1：HFEA 凍卵說明')}>[1]</a></p><p>{t('美国生殖医学学会（ASRM）指出，较年轻时冷冻卵子的治疗结果总体可能更好，但现有证据尚不足以给不同个体提供可靠的绝对活产率预测，也不足以确定普遍适用的最佳冻卵年龄。','美國生殖醫學學會（ASRM）指出，較年輕時冷凍卵子的結果整體可能較佳，但目前證據仍不足以可靠預測個人的絕對活產率，也無法訂出所有人通用的最佳凍卵年齡。')} <a class="source-ref" href="https://www.asrm.org/practice-guidance/practice-committee-documents/evidence-based-outcomes-after-oocyte-cryopreservation-for-donor-oocyte-in-vitro-fertilization-and-planned-oocyte-cryopreservation-a-guideline-2021/" target="_blank" rel="noopener noreferrer" aria-label={t('来源 2：ASRM 循证指南','來源 2：ASRM 實證指引')}>[2]</a></p><p>{t('未来使用冻卵时，可能还需要解冻、ICSI 受精、胚胎培养和移植，这些通常不属于本次取卵冷冻费用。','未來使用冷凍卵子時，還可能需要解凍、ICSI 受精、胚胎培養與植入，這些通常不屬於本次取卵冷凍費用。')} <a class="source-ref" href="https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/" target="_blank" rel="noopener noreferrer" aria-label={t('来源 1：HFEA 冻卵说明','來源 1：HFEA 凍卵說明')}>[1]</a></p></section>
<section id="journey" class="journey"><span class="kicker">{t('赴塞班实用安排','赴塞班實用安排')}</span><h2>{t('从咨询到保存，应该如何安排？','從諮詢到保存，應該如何安排？')}</h2><p class="lead">{t('不要把一个通用的促排周期天数当作返程承诺。下面是用于问诊沟通的阶段顺序，而不是固定行程表。','請勿將一般療程天數當作返程保證。以下是用於與醫師溝通的階段順序，而不是固定行程表。')}</p><div class="steps"><article><span>01</span><div><h3>{t('行前：报告与方案','出發前：報告與方案')}</h3><p>{t('提供既往检查与用药史，确认是否接受当地监测报告；提前询问院方要求的入境材料和就诊文件。','提供既往檢查與用藥史，確認是否接受居住地監測報告；事先詢問院方要求的入境與就診文件。')}</p></div></article><article><span>02</span><div><h3>{t('治疗期：按医嘱监测','療程期間：依醫囑監測')}</h3><p>{t('促排监测、调整药物和取卵安排会随个体反应改变。取卵后留出观察与必要复诊的弹性时间。','促排監測、調整藥物與取卵安排會依個人反應改變。取卵後應保留觀察與必要回診的彈性時間。')}</p></div></article><article><span>03</span><div><h3>{t('离院前：报告与续存','離院前：報告與續存')}</h3><p>{t('索取取卵数、成熟卵子数、实际冷冻数及保存合同；确认以后解冻、受精和转运的处理流程。','索取取卵數、成熟卵子數、實際冷凍數及保存合約；確認未來解凍、受精和轉運的處理方式。')}</p></div></article></div></section>
<section class="decision"><span class="kicker">{t('比最低价更重要','比最低價更重要')}</span><h2>{t('如何比较两份冻卵报价？','如何比較兩份凍卵報價？')}</h2><div class="tablewrap"><table><thead><tr><th>{t('需要核对','需要核對')}</th><th>{t('为什么重要','為何重要')}</th></tr></thead><tbody><tr><td>{t('一次周期的覆盖范围','一次週期的涵蓋範圍')}</td><td>{t('监测、取卵、麻醉与冷冻可能分开计价','監測、取卵、麻醉與冷凍可能分開計價')}</td></tr><tr><td>{t('药物及延期政策','藥物與延期規則')}</td><td>{t('药物用量和复诊次数可发生变化','藥物用量與回診次數可能變動')}</td></tr><tr><td>{t('保存与未来使用','保存與未來使用')}</td><td>{t('年度保存不等于未来解冻、受精和移植','年度保存不等於未來解凍、受精與植入')}</td></tr><tr><td>{t('旅程与签证条件','行程與入境條件')}</td><td>{t('医疗计划与实际入境许可需要分别确认','醫療安排與實際入境資格須分別確認')}</td></tr></tbody></table></div></section>
<section id="compare"><h2>{t('付款前必须确认的 5 件事','付款前必須確認的 5 件事')}</h2><ol><li>{t('实际接诊机构、收款方及报价日期。','實際接診機構、收款方及報價日期。')}</li><li>{t('药物、麻醉、监测、取卵、冷冻分别包含什么。','藥物、麻醉、監測、取卵、冷凍分別包含什麼。')}</li><li>{t('存储机构、年度续费与合同终止规则。','保存機構、年度續費與合約終止規則。')}</li><li>{t('未取到卵子、取消或延期时的收费规则。','未取得卵子、取消或延期時的收費規則。')}</li><li>{t('到院时间是否由医生确认，不能仅凭通用日程订不可退机票。','到院時間是否已由醫師確認；勿僅憑通用時程購買不可退機票。')}</li></ol></section>
<section class="risk-note"><h2>{t('谁应该先与医生讨论风险？','哪些人應先與醫師討論風險？')}</h2><p>{t('如有卵巢功能或既往取卵相关问题、正在接受其他治疗，或对麻醉、药物有特殊顾虑，先由医疗团队评估是否适合冻卵以及监测安排；不应自行按照本文选择促排药物。','如有卵巢功能或先前取卵相關問題、正在接受其他療程，或對麻醉、藥物有特殊顧慮，應先由醫療團隊評估是否適合凍卵及監測安排；不應自行依本文選用促排藥物。')}</p><p>{t('需要具体讨论促排治疗和取卵潜在风险时，请参考 HFEA 的冻卵介绍并向医生确认个人风险。','需要討論促排療程與取卵潛在風險時，請參考 HFEA 的凍卵介紹，並向醫師確認個人風險。')} <a class="source-ref" href="https://www.hfea.gov.uk/treatments/fertility-preservation/egg-freezing/" target="_blank" rel="noopener noreferrer">[1]</a></p></section>
