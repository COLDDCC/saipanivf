---
import SiteLayout from '../layouts/SiteLayout.astro';
import SourceNote from './SourceNote.astro';
import ClinicArrival from './ClinicArrival.astro';
import { servicePages } from '../data/provider-services';
const { slug, active = 'treatments' } = Astro.props;
const p = servicePages[slug];
const scroll = (id: string) => `${id}-table`;
---
<SiteLayout title={p.title} description={p.description} active={active} plainHead={true} zhOnlyAlternates={true}>
<article class="section wrap service-page" aria-label={p.title}>
<div class="service-answer"><span class="service-eyebrow">资料核对 {p.checked}</span><h2>先看结论</h2>{p.answer.map(text=><p set:html={text}/>)}<p class="service-caveat">{p.caveat}</p></div>
<nav class="service-jump" aria-label="本页导航">{p.nav.map(([href,label])=><a href={href}>{label}</a>)}</nav>
{slug==='facility'&&<ClinicArrival/>}
{p.steps&&<section id={p.steps.id}><h2>{p.steps.title}</h2>{p.steps.intro&&<p>{p.steps.intro}</p>}<ol class="service-steps">{p.steps.items.map(([title,text])=><li><h3>{title}</h3><p>{text}</p></li>)}</ol></section>}
{p.table&&<section id={p.table.id}><h2>{p.table.title}</h2>{p.table.intro&&<p>{p.table.intro}</p>}<p class="service-table-hint">表格可左右滑动查看完整内容。</p><div class="service-table" id={scroll(p.table.id)} role="region" aria-label={p.table.caption} tabindex="0"><table><caption class="sr-only">{p.table.caption}</caption><thead><tr>{p.table.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{p.table.rows.map(row=><tr><th scope="row">{row[0]}</th>{row.slice(1).map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></div></section>}
{p.cards&&<section id={p.cards.id}><h2>{p.cards.title}</h2>{p.cards.intro&&<p>{p.cards.intro}</p>}<div class="service-cards">{p.cards.items.map(([title,text])=><article><h3>{title}</h3><p>{text}</p></article>)}</div></section>}
<section id={p.checklist.id}><h2>{p.checklist.title}</h2>{p.checklist.intro&&<p>{p.checklist.intro}</p>}<ul class="service-checklist">{p.checklist.items.map(item=><li>{item}</li>)}</ul></section>
<section id="faq"><h2>常见问题</h2>{p.faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</section>
<section class="service-related" aria-labelledby={slug+'-related'}><h2 id={slug+'-related'}>继续了解</h2><div class="hub-grid">{p.related.map(([href,title,text])=><a class="hub-card" href={href}><h3>{title}</h3><p>{text}</p></a>)}</div></section>
<div class="service-next"><h2>{p.contact.title}</h2><p>{p.contact.text}</p><a class="button" href={p.contact.href}>{p.contact.label}</a></div>
<SourceNote checked={p.checked} sources={p.sources}/>
</article>
</SiteLayout>
<style>
.service-page{max-width:1000px;padding-top:22px;padding-bottom:65px}
.service-page section{scroll-margin-top:24px;margin-top:48px}
.service-page h2{font-size:clamp(23px,3vw,32px);line-height:1.45;margin:0 0 14px}
.service-page p,.service-page li{line-height:1.85}
.service-answer{padding:24px;border:1px solid #d9e7eb;border-radius:16px;background:#f5fafb}
.service-answer h2{margin-top:6px}
.service-eyebrow{font-size:13px;color:var(--muted)}
.service-caveat{font-size:14px;color:var(--muted);margin-bottom:0}
.service-jump{display:flex;flex-wrap:wrap;gap:10px 22px;margin:22px 0 8px}
.service-jump a{display:inline-flex;align-items:center;min-height:44px;font-size:15px;text-decoration:underline;text-underline-offset:5px}
.service-steps{counter-reset:step;list-style:none;padding:0;margin:20px 0 0;display:grid;gap:14px}
.service-steps li{counter-increment:step;position:relative;padding:18px 20px 18px 64px;background:var(--light)}
.service-steps li::before{content:counter(step,decimal-leading-zero);position:absolute;left:20px;top:18px;font-size:15px;font-weight:600;color:var(--muted)}
.service-steps h3{font-size:18px;margin:0 0 4px}
.service-steps p{margin:0;font-size:16px}
.service-table{overflow-x:auto;margin-top:12px}
.service-table table{border-collapse:collapse;width:100%;min-width:640px;font-size:15px;line-height:1.75}
.service-table th,.service-table td{border-bottom:1px solid #dde7ea;padding:12px 14px;text-align:left;vertical-align:top}
.service-table thead th{background:var(--light);font-size:14px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.service-table-hint{display:none;color:#385e73;font-size:13px;margin:4px 0 8px}
.service-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:16px}
.service-cards article{padding:22px;background:var(--light);min-width:0}
.service-cards h3{font-size:19px;margin:0 0 8px}
.service-cards p{margin:0;font-size:16px}
.service-checklist{padding-left:22px}
.service-checklist li{margin-bottom:8px}
.service-page details{border-bottom:1px solid #dde7ea;padding:12px 0}
.service-page summary{cursor:pointer;font-weight:600;min-height:44px;display:flex;align-items:center}
.service-related .hub-card{min-width:0}
.service-related .hub-card h3{font-size:21px}
.service-related .hub-card p{font-size:15px}
.service-next{margin-top:48px;padding:28px;background:var(--light)}
.service-next h2{font-size:clamp(22px,2.6vw,28px)}
@media(max-width:650px){.service-table-hint{display:block}.service-cards{grid-template-columns:1fr}.service-answer{padding:20px}.service-steps li{padding:16px 16px 16px 54px}.service-steps li::before{left:16px;top:16px}.service-next{padding:22px}.service-related .hub-grid{grid-template-columns:1fr}}
</style>
