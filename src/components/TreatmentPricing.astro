---
import ResponsiveImage from "./ResponsiveImage.astro";
import { pricing } from '../data/pricing';
const money = (n: number) => '$' + n.toLocaleString('en-US');
const explanationRows=pricing.filter(row=>['ivf','medication','anesthesia','icsi','freeze','fet'].includes(row.id));
const explanationMin=explanationRows.reduce((sum,row)=>sum+row.min,0);
const explanationMax=explanationRows.reduce((sum,row)=>sum+row.max,0);
const cards = [
 {image:'fees-planning',alt:'纸张上的计算器',caption:'初诊、基础检查和后续治疗分开核对',title:'生育评估',href:'/contact/',price:'$250',unit:'首次咨询演算金额',text:'整理已有报告，看要补哪些检查、下一步怎么走。',items:['病史和以前的治疗记录','基础检查演算 $800–1,500','查什么由医生定']},
 {image:'fees-laboratory',alt:'实验室移液操作近景',caption:'取卵培养基础费与附加实验室项目分开计算',title:'IVF治疗计划',href:'/treatments/ivf/',price:'$15,000',unit:'取卵与培养演算金额',text:'从一次取卵周期开始，按评估结果安排实验室项目和移植。',items:['常规监测、一次取卵与培养','药物、麻醉及移植等另计','可在下面组合费用项目']},
 {image:'fees-preservation',alt:'实验室移液器',caption:'取卵冷冻、年度保存及未来使用分别计费',title:'冻卵与生育力保存',href:'/treatments/egg-freezing/',price:'$9,000',unit:'冻卵周期演算金额',text:'取卵冷冻、保存和以后再用，费用分开看。',items:['常规监测、一次取卵及冷冻','药物、麻醉及保存另计','以后解冻、受精和移植另算']}
];
---
<section class="pricing-section" id="cost" aria-labelledby="pricing-title"><div class="pricing-wrap">
<div class="pricing-intro"><h2 id="pricing-title">IVF治疗费用预算</h2><nav class="fees-nav" aria-label="费用页内容"><a href="#budget-planner">预算工具</a><a href="#cost-explainer-title">费用构成</a><a href="#treatment-prices">项目参考</a><a href="#itemized-costs">费用明细</a></nav></div>
<p class="intro"><strong>先分清取卵培养、药物、保存和移植，再组合你的预算。</strong>下面的金额用于演算费用构成；取得院方书面报价后，再确认个人治疗费用。</p>

<div class="estimator" id="budget-planner"><div><h3>组合费用预算</h3><p>选想了解的治疗和费用项目，查看演算合计。默认勾选只是示例，不代表医生建议。</p><p>冻胚移植（FET）：把冻好的胚胎解冻再移植；PGT-A：查胚胎染色体数目，做不做听医生的。</p><label class="path-label">治疗路径<select id="budget-path"><option value="ivf">IVF取卵与培养</option><option value="egg">冻卵周期</option><option value="fet">仅冻胚移植</option></select></label><div class="budget-options">{pricing.filter(row=>['medication','anesthesia','icsi','freeze','fet','pgt','storage'].includes(row.id)).map(row=><label data-option={row.id}><input type="checkbox" value={row.id} checked={['medication','anesthesia','icsi','freeze','fet'].includes(row.id)}/><span>{row.label}</span></label>)}</div></div><div class="budget-result"><output id="budget-total" aria-live="polite">$26,100–31,100</output><p id="budget-description">一次取卵培养、促排药物、麻醉、ICSI、冷冻及一次冻胚移植。</p><p><strong>未包含：</strong>初诊检查、移植药物、交通住宿、额外周期、并发症处理，以及没勾选的项目。</p><p>ICSI 和 PGT 不是每个人都要做；治疗也不保证形成可移植胚胎或怀孕。</p><button id="budget-copy" type="button">复制费用明细</button><span id="budget-status" role="status"></span></div></div>
<p class="intro"><strong>为什么有两个 IVF 金额？</strong> $15,000 是取卵和胚胎培养的演算输入；$26,100–31,100 是计算器默认示例，另加了药物、麻醉、ICSI、冷冻和一次冻胚移植。示例也没含全部支出，实际以个人方案的书面报价为准。</p><section class="cost-explainer" aria-labelledby="cost-explainer-title"><h3 id="cost-explainer-title">组合预算是怎样算出的？</h3><p>以下对应计算器默认勾选的项目；ICSI等附加操作是否需要，由医生评估。</p><div class="cost-equation" aria-label="默认组合预算的费用构成">{explanationRows.map(row=>{return <div class="cost-piece"><span>{row.label}</span><strong>{money(row.min)}{row.max!==row.min?'–'+money(row.max):''}</strong></div>})}<div class="cost-piece cost-sum"><span>默认组合合计</span><strong>{money(explanationMin)}–{money(explanationMax)}</strong></div></div><p class="equation-note">初诊检查、移植药物、年度保存和交通住宿未计入此合计。</p><a class="inline-link" href="#budget-planner">调整项目，查看你的组合预算</a></section><section class="treatment-prices" id="treatment-prices"><h3 class="plans-title">按治疗项目了解预算</h3><div class="price-cards">{cards.map(card => <article><figure class="price-illustration"><ResponsiveImage src={`/images/stock/${card.image}.webp`} alt={card.alt} width="1000" height="650" loading="lazy"/><figcaption>{card.caption}</figcaption></figure><div class="plan-copy"><h3>{card.title}</h3><div class="price">{card.price}<small>{card.unit}</small></div><p>{card.text}</p><ul>{card.items.map(item=><li>{item}</li>)}</ul><div class="plan-actions"><a href={card.href}>查看项目详情</a><a href="/contact/">咨询项目费用</a></div></div></article>)}</div></section>
<details class="itemized" id="itemized-costs"><summary>查看11项费用明细与包含范围</summary><div class="table-scroll"><table><caption>方案预算假设 · 单位USD；除保存费按年外，按一次服务或周期计</caption><thead><tr><th scope="col">项目</th><th scope="col">预算</th><th scope="col">范围与另计事项</th></tr></thead><tbody>{pricing.map(row=><tr><th scope="row">{row.label}</th><td>{money(row.min)}{row.max!==row.min ? '–'+money(row.max):''}</td><td>{row.note}</td></tr>)}</tbody></table></div></details>
<div class="cost-notes"><article><h3>这里的合计包含什么？</h3><p>合计只算所选治疗的基础金额和勾选项目，初诊检查、移植药物、交通住宿和额外治疗都没算。</p></article><article><h3>取消或追加治疗</h3><p>周期取消、延期或追加治疗如何结算？付款前核对对应费用与退费条款，避免遗漏后续支出。</p></article><article><h3>第三方生育费用</h3><p>捐卵、捐精和第三方妊娠的费用不包含在示例内，要确认供应方、医疗条件和合同。</p></article></div>
<p class="source">费用量级参考 <a href="https://www.illumefertility.com/pricing-and-insurance/ivf-costs" target="_blank" rel="noopener">美国机构公开费用指南</a>；本页固定金额为编制假设，并非该机构或 SIVF 的报价。请勿把美国参考价格当成塞班当地均价。</p>
</div></section>
<script>
import { pricing } from '../data/pricing';
const path=document.querySelector<HTMLSelectElement>('#budget-path')!;
const inputs=Array.from(document.querySelectorAll<HTMLInputElement>('.budget-options input'));
const total=document.querySelector<HTMLOutputElement>('#budget-total')!;
const description=document.querySelector<HTMLElement>('#budget-description')!;
const status=document.querySelector<HTMLElement>('#budget-status')!;
function update(){
 const allowed=path.value==='ivf'?['medication','anesthesia','icsi','freeze','fet','pgt','storage']:path.value==='egg'?['medication','anesthesia','storage']:['storage'];
 inputs.forEach(input=>{input.disabled=!allowed.includes(input.value);input.closest<HTMLElement>('label')!.hidden=input.disabled;});
 const selected=pricing.filter(row=>row.id===path.value||inputs.some(input=>!input.disabled&&input.checked&&input.value===row.id));
 const min=selected.reduce((sum,row)=>sum+row.min,0),max=selected.reduce((sum,row)=>sum+row.max,0);
 total.textContent='$'+min.toLocaleString('en-US')+(max!==min?'–'+max.toLocaleString('en-US'):'');
 description.textContent=selected.map(row=>row.label).join(' + ');status.textContent='';
}
path.addEventListener('change',update);inputs.forEach(input=>input.addEventListener('change',update));update();
document.querySelector('#budget-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('非医院正式报价｜方案预算示例（USD）\n'+description.textContent+'\n'+total.textContent+'\n未含初诊检查、移植药物、交通住宿、额外治疗及未选择项目；请取得医院书面报价。');status.textContent='已复制';}catch{status.textContent='复制未成功，请选中预算文字手动复制。';}});
</script>
<style>
.pricing-section{padding:56px 0 var(--space);background:var(--cream);color:var(--ink);scroll-margin-top:25px}.pricing-wrap{max-width:1536px;margin:auto;padding-inline:var(--gutter)}h2{font-size:clamp(28px,3vw,42px);font-weight:500;line-height:1.4;margin:0}h3{font-weight:500}p,li{font-size:16px;line-height:1.85;color:var(--ink)}.pricing-intro{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-bottom:24px}.fees-nav{display:flex;gap:22px;flex-wrap:wrap;font-size:14px;line-height:1.7}.fees-nav a{padding-block:8px;text-decoration:underline;text-underline-offset:7px}.intro{max-width:62em;margin:0 0 28px}.intro strong{font-weight:600}.estimator{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:6%;margin:35px 0 55px;padding:40px;background:var(--deep);color:white;scroll-margin-top:25px}.estimator>div{min-width:0}.estimator h3{font-size:30px;line-height:1.4;margin:0 0 20px}.estimator>div>p{color:#e2ecee;font-size:15px;margin:0 0 20px}.path-label{display:grid;gap:12px;font-size:16px;margin-top:26px}select{width:100%;min-height:52px;padding:13px 15px;border:0;background:white;color:var(--ink);font:inherit}.budget-options{display:grid;grid-template-columns:1fr 1fr;gap:20px 16px;margin-top:28px}.budget-options label{display:flex;gap:12px;align-items:start;font-size:15px;line-height:1.7;min-height:40px;cursor:pointer}.budget-options input{width:20px;height:20px;flex-shrink:0;margin:2px 0 0;accent-color:#377e8c}.budget-options label[hidden]{display:none}.budget-result{background:#f7faf7;color:var(--ink);padding:32px;align-self:start;position:sticky;top:24px}.estimator .budget-result>p{font-size:15px;line-height:1.85;color:var(--ink);margin-bottom:20px}output{display:block;font-size:clamp(30px,3.5vw,50px);font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-.04em;line-height:1.25;margin:0 0 25px;overflow-wrap:anywhere}.budget-result button{width:100%;min-height:50px;border:0;background:var(--deep);color:white;padding:14px 18px;font:inherit;font-size:15px;cursor:pointer;transition:transform .2s}.budget-result button:hover{transform:translateY(-2px)}#budget-status{display:block;font-size:14px;line-height:1.6;margin-top:12px}.cost-explainer{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);column-gap:7%;margin:60px 0 80px;align-items:start}.cost-explainer h3{grid-column:1;grid-row:1;font-size:32px;line-height:1.45;margin:0 0 20px;max-width:9em}.cost-explainer>p:not(.equation-note){grid-column:1;grid-row:2;margin:0;max-width:29em}.cost-equation{grid-column:2;grid-row:1/5;display:grid;gap:20px;background:var(--light);padding:32px}.cost-piece{display:flex;justify-content:space-between;gap:25px;align-items:baseline;min-width:0}.cost-piece span{font-size:16px;line-height:1.7}.cost-piece strong{font-size:23px;line-height:1.4;font-weight:500;font-variant-numeric:tabular-nums;white-space:nowrap;letter-spacing:-.02em}.cost-piece.cost-sum{display:block;background:var(--deep);color:white;padding:24px;margin-top:5px}.cost-sum strong{display:block;margin-top:10px;font-size:34px;white-space:normal;overflow-wrap:anywhere}.cost-explainer .equation-note{grid-column:1;grid-row:3;font-size:14px;line-height:1.85;color:var(--muted);max-width:32em;margin:22px 0 0}.cost-explainer>.inline-link{grid-column:1;grid-row:4;justify-self:start;font-size:15px;margin-top:16px}.plans-title{font-size:32px;line-height:1.4;margin:0 0 35px}.price-cards{display:flex;flex-direction:column;gap:55px;margin:0 0 70px}.price-cards article{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:7%;align-items:center}.price-cards article:nth-child(2){grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}.price-cards article:nth-child(2) .price-illustration{grid-column:2;grid-row:1}.price-cards article:nth-child(2) .plan-copy{grid-column:1;grid-row:1}.price-illustration{margin:0;min-width:0}.price-illustration img{width:100%;height:280px;object-fit:cover}.price-illustration figcaption{font-size:13px;color:var(--muted);line-height:1.8;margin-top:14px}.plan-copy{min-width:0}.plan-copy h3{font-size:30px;margin:0 0 17px;line-height:1.4}.price{font-size:44px;line-height:1.2;font-variant-numeric:tabular-nums;letter-spacing:-.04em}.price small{display:block;font-size:14px;color:var(--muted);letter-spacing:0;line-height:1.7;margin-top:9px}.plan-copy p{margin:20px 0 14px}.plan-copy ul{padding-left:20px;margin:0 0 24px}.plan-copy li{margin:5px 0;font-size:15px;line-height:1.7}.plan-actions{display:flex;gap:24px;flex-wrap:wrap;font-size:15px}.plan-actions a,.source a{text-decoration:underline;text-underline-offset:6px}.itemized{padding:26px;background:var(--light);scroll-margin-top:25px}.itemized summary{cursor:pointer;font-size:20px;line-height:1.6}.table-scroll{overflow-x:auto}table{width:100%;min-width:580px;border-collapse:collapse;margin-top:20px;font-variant-numeric:tabular-nums}caption{text-align:left;font-size:14px;line-height:1.8;padding:14px 0}td,th{font-size:15px;line-height:1.85;text-align:left;padding:18px 12px;border-bottom:1px solid #bfd0d3;vertical-align:top}td:nth-child(2){white-space:nowrap}.cost-notes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:35px;margin:50px 0}.cost-notes h3{font-size:22px;margin:0 0 16px;line-height:1.5}.cost-notes p{font-size:15px;margin:0}.source{font-size:13px;line-height:1.9;max-width:85em;color:var(--muted);margin:0}.source a{color:var(--ink)}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #5c9ead;outline-offset:5px}select:focus-visible,input:focus-visible{outline:3px solid #91c5ce;outline-offset:4px}
@media(max-width:1050px){.pricing-intro{display:block}.fees-nav{margin-top:18px}.estimator{padding:30px;gap:30px}.budget-options{grid-template-columns:1fr}.budget-result{padding:26px}.price-cards{gap:45px}.cost-piece strong{font-size:21px}.cost-equation{padding:26px}.cost-explainer h3{font-size:29px}.cost-notes{grid-template-columns:1fr 1fr}}
@media(max-width:750px){.estimator{grid-template-columns:1fr;gap:25px}.budget-options{grid-template-columns:1fr 1fr}.budget-result{position:static}.cost-explainer{grid-template-columns:1fr;gap:22px;margin:45px 0 55px}.cost-explainer h3,.cost-explainer>p:not(.equation-note),.cost-equation,.cost-explainer .equation-note,.cost-explainer>.inline-link{grid-column:auto;grid-row:auto;max-width:none;margin:0}.cost-equation{order:0}.cost-explainer h3{max-width:none}.price-cards article,.price-cards article:nth-child(2){grid-template-columns:1fr;gap:25px}.price-cards article:nth-child(2) .price-illustration,.price-cards article:nth-child(2) .plan-copy{grid-column:auto;grid-row:auto}.price-illustration img{height:250px}.plan-copy h3{font-size:28px}.price{font-size:40px}.cost-notes{grid-template-columns:1fr;gap:30px}}
@media(max-width:450px){.pricing-section{padding-top:35px}.fees-nav{gap:12px 20px}.estimator{padding:23px;margin:28px 0 38px}.estimator h3{font-size:27px}.budget-options{grid-template-columns:1fr;gap:13px}.budget-options label{min-height:32px}.budget-result{padding:23px}output{font-size:34px}.cost-equation{padding:23px}.cost-piece{gap:14px}.cost-piece span{font-size:14px;max-width:55%}.cost-piece strong{font-size:18px}.cost-sum strong{font-size:30px}.cost-piece.cost-sum{padding:20px}.cost-sum span{max-width:none}.price-illustration img{height:220px}.itemized{padding:21px}.itemized summary{font-size:18px}.plans-title{font-size:28px}.price-cards{gap:40px}.cost-notes{margin-block:40px}}
@media(prefers-reduced-motion:reduce){.budget-result button{transition:none}}
</style>
