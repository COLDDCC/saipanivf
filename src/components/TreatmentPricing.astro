---
import { pricing } from '../data/pricing';
const money = (n: number) => '$' + n.toLocaleString('en-US');
const cards = [
 {title:'生育评估',tag:'01 / UNDERSTAND',price:'$250',unit:'首次医生咨询预算',text:'整理已有报告，看要补哪些检查、下一步怎么走。',items:['病史和以前的治疗记录','基础检查预算 $800–1,500','查什么由医生定']},
 {title:'IVF治疗计划',tag:'02 / IVF JOURNEY',price:'$15,000',unit:'取卵与培养基础预算',text:'从一次取卵周期开始，按评估结果安排实验室项目和移植。',items:['常规监测、一次取卵与培养','药物、麻醉及移植等另计','可在下面组合费用项目']},
 {title:'冻卵与生育力保存',tag:'03 / PRESERVE',price:'$9,000',unit:'冻卵周期基础预算',text:'取卵冷冻、保存和以后再用，费用分开看。',items:['常规监测、一次取卵及冷冻','药物、麻醉及保存另计','以后解冻、受精和移植另算']}
];
---
<section class="pricing-section" id="cost" aria-labelledby="pricing-title"><div class="pricing-wrap">
<div class="eyebrow">10 / 费用与预算</div><h2 id="pricing-title">治疗费用大概多少。</h2>
<p class="intro">先看结论：<strong>做一次较完整的试管婴儿（含药物、麻醉、ICSI、冷冻和一次冻胚移植），预算大约 $26,100–31,100。</strong>每项包含什么、怎么组合，下面都能查。金额都是演示预算，不能据此预约或付款。</p>
<aside class="draft"><strong>方案预算示例 · 非医院正式报价</strong><p>下面的美元金额是网站工作假设，还没经 SIVF 医疗和财务团队确认，不代表实际可购买的服务或报价；正式费用以评估后的书面明细为准。</p></aside>
<p class="intro"><strong>为什么有两个 IVF 金额？</strong> $15,000 只是取卵和胚胎培养的基础价；$26,100–31,100 是计算器默认示例，另加了药物、麻醉、ICSI、冷冻和一次冻胚移植。示例也没含全部支出，实际以个人方案的书面报价为准。</p><div class="price-cards">{cards.map(card => <article><span class="eyebrow">{card.tag}</span><h3>{card.title}</h3><div class="price">{card.price}<small>{card.unit}</small></div><p>{card.text}</p><ul>{card.items.map(item=><li>{item}</li>)}</ul><a href="/contact/">咨询项目费用 ↗</a></article>)}</div>
<div class="estimator" id="budget-planner"><div><div class="eyebrow">YOUR PLANNING SCENARIO</div><h3>估算治疗费用</h3><p>选想了解的治疗和费用项目，看演示合计。默认勾选只是示例，不代表医生建议。</p><p>冻胚移植（FET）：把冻好的胚胎解冻再移植；PGT-A：查胚胎染色体数目，做不做听医生的。</p><label class="path-label">治疗路径<select id="budget-path"><option value="ivf">IVF取卵与培养</option><option value="egg">冻卵周期</option><option value="fet">仅冻胚移植</option></select></label><div class="budget-options">{pricing.filter(row=>['medication','anesthesia','icsi','freeze','fet','pgt','storage'].includes(row.id)).map(row=><label data-option={row.id}><input type="checkbox" value={row.id} checked={['medication','anesthesia','icsi','freeze','fet'].includes(row.id)}/><span>{row.label}</span></label>)}</div></div><div class="budget-result"><span class="eyebrow">ESTIMATED USD / 预算示例</span><output id="budget-total" aria-live="polite">$26,100–31,100</output><p id="budget-description">一次取卵培养、促排药物、麻醉、ICSI、冷冻及一次冻胚移植。</p><p><strong>未包含：</strong>初诊检查、移植药物、交通住宿、额外周期、并发症处理，以及没勾选的项目。</p><p>ICSI 和 PGT 不是每个人都要做；治疗也不保证形成可移植胚胎或怀孕。</p><button id="budget-copy" type="button">复制费用明细 ↗</button><span id="budget-status" role="status"></span></div></div>
<details class="itemized"><summary>查看11项费用明细与包含范围</summary><div class="table-scroll"><table><caption>方案预算假设 · 单位USD；除保存费按年外，按一次服务或周期计</caption><thead><tr><th scope="col">项目</th><th scope="col">预算</th><th scope="col">范围与另计事项</th></tr></thead><tbody>{pricing.map(row=><tr><th scope="row">{row.label}</th><td>{money(row.min)}{row.max!==row.min ? '–'+money(row.max):''}</td><td>{row.note}</td></tr>)}</tbody></table></div></details>
<div class="cost-notes"><article><h3>这里的合计包含什么？</h3><p>合计只算所选治疗的基础金额和勾选项目，初诊检查、移植药物、交通住宿和额外治疗都没算。</p></article><article><h3>取消或追加治疗</h3><p>本页没有院方确认的退费标准。周期取消、没形成胚胎或追加治疗的费用，付款前要拿到书面说明。</p></article><article><h3>第三方生育费用</h3><p>捐卵、捐精和第三方妊娠的费用不包含在示例内，要确认供应方、医疗条件和合同。</p></article></div>
<p class="source">费用量级参考 <a href="https://www.illumefertility.com/pricing-and-insurance/ivf-costs" target="_blank" rel="noopener">美国机构公开费用指南 ↗</a>；本页固定金额为编制假设，并非该机构或 SIVF 的报价。请勿把美国参考价格当成塞班当地均价。</p>
</div></section>
<script>
import { pricing } from '../data/pricing';
const path=document.querySelector<HTMLSelectElement>('#budget-path')!;
const inputs=Array.from(document.querySelectorAll<HTMLInputElement>('.budget-options input'));
const total=document.querySelector<HTMLOutputElement>('#budget-total')!;
const description=document.querySelector<HTMLElement>('#budget-description')!;
const status=document.querySelector<HTMLElement>('#budget-status')!;
function update(){
 const allowed=path.value==='ivf'?['medication','anesthesia','icsi','freeze','fet','pgt','storage']:path.value==='egg'?['medication','anesthesia','storage']:['storage'];
 inputs.forEach(input=>{input.disabled=!allowed.includes(input.value);input.closest<HTMLElement>('label')!.hidden=input.disabled;});
 const selected=pricing.filter(row=>row.id===path.value||inputs.some(input=>!input.disabled&&input.checked&&input.value===row.id));
 const min=selected.reduce((sum,row)=>sum+row.min,0),max=selected.reduce((sum,row)=>sum+row.max,0);
 total.textContent='$'+min.toLocaleString('en-US')+(max!==min?'–'+max.toLocaleString('en-US'):'');
 description.textContent=selected.map(row=>row.label).join(' + ');status.textContent='';
}
path.addEventListener('change',update);inputs.forEach(input=>input.addEventListener('change',update));update();
document.querySelector('#budget-copy')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText('非医院正式报价｜方案预算示例（USD）\n'+description.textContent+'\n'+total.textContent+'\n未含初诊检查、移植药物、交通住宿、额外治疗及未选择项目；请取得医院书面报价。');status.textContent='已复制';}catch{status.textContent='复制未成功，请选中预算文字手动复制。';}});
</script>
<style>
.pricing-section{padding:100px 0;background:#fbfaf6;color:#163b4b;scroll-margin-top:30px}.pricing-wrap{max-width:1440px;margin:auto;padding:0 7%}.eyebrow{font-size:11px;letter-spacing:2px;color:#397c94;font-weight:700}h2{font:400 clamp(36px,4.3vw,66px)/1.3 'Playfair Display','Noto Sans SC',serif;margin:23px 0}p,li{color:#637d85;font-size:14px;line-height:1.9}.intro{max-width:710px}.draft{border-left:3px solid #397c94;background:#e9f3f5;padding:20px 25px;margin:30px 0}.draft p{margin:8px 0 0;font-size:13px}.price-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.price-cards article{background:white;border:1px solid #d4e1e3;padding:30px}.price-cards h3{font-size:25px;font-weight:400}.price{font:38px 'Playfair Display',serif}.price small{display:block;font:12px 'Noto Sans SC',sans-serif;color:#637d85;margin-top:8px}ul{padding-left:18px}.price-cards a,.source a{color:#397c94;text-decoration:underline;text-underline-offset:5px;font-size:13px}.estimator{display:grid;grid-template-columns:1fr 1fr;gap:45px;margin:45px 0;background:#e9f3f5;padding:35px}.estimator h3{font-size:26px;font-weight:400}.path-label{display:grid;gap:10px;font-size:14px}select{padding:14px;background:white;border:1px solid #b6cdd2;width:100%;color:#163b4b;font:inherit}.budget-options{display:grid;gap:13px;margin-top:24px}.budget-options label{display:flex;gap:10px;font-size:14px;align-items:center}.budget-options label[hidden]{display:none}.budget-options input{accent-color:#397c94;width:18px;height:18px}.budget-result{background:white;padding:30px;align-self:start;min-width:0}output{display:block;font:clamp(28px,3vw,43px) 'Playfair Display',serif;margin:20px 0;overflow-wrap:anywhere}button{background:#163b4b;color:white;padding:15px 18px;border:0;cursor:pointer;font:inherit;font-size:13px}#budget-status{display:block;font-size:12px;margin-top:10px}.itemized{border-top:1px solid #c9dbe0;border-bottom:1px solid #c9dbe0;padding:23px 0}.itemized summary{cursor:pointer;font-size:18px}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;min-width:580px;margin-top:20px}caption{text-align:left;color:#637d85;font-size:12px;padding:15px 0}td,th{font-size:13px;line-height:1.9;padding:18px 12px;text-align:left;vertical-align:top;border-bottom:1px solid #c9dbe0}td{color:#637d85}td:nth-child(2){white-space:nowrap}.cost-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;margin-top:35px}.cost-notes h3{font-weight:500;font-size:19px}.source{font-size:12px;border-top:1px solid #c9dbe0;padding-top:20px}button:focus-visible,select:focus-visible,input:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid #397c94;outline-offset:4px}@media(max-width:800px){.price-cards,.estimator,.cost-notes{grid-template-columns:1fr}.estimator{padding:22px;gap:20px}.pricing-section{padding:75px 0}.pricing-wrap{padding:0 6%}.budget-result{padding:22px}}
</style>
