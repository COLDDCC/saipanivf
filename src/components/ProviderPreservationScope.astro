---
import { preservation as spanish } from '../i18n/es-extra';
const {locale='zh-CN'}=Astro.props;
const copy={
 es:spanish,
 'zh-CN':{title:'院方公开介绍的冻卵服务环节',intro:'院方生育力保存页面列出了以下环节，可据此核对个人治疗计划：',items:['健康评估、视频咨询与个人方案','超声、激素监测与促排用药安排','一次取卵及麻醉','卵子玻璃化冷冻与保存安排','取卵后医疗随访与后续咨询'],note:'预约时核对监测地点、首年费用范围、保存续费和未来使用安排。官网服务介绍没有列出对应美元报价，不能直接视为本站基础预算的包含清单。',source:'查看院方生育力保存介绍'},
 en:{title:'Egg-freezing stages described by the provider',intro:'The provider’s fertility-preservation page lists these stages to discuss when confirming your individual plan:',items:['Health assessment, video consultation and an individual plan','Ultrasound, hormonal monitoring and stimulation medication','One egg retrieval and anaesthesia','Egg vitrification and storage arrangements','Post-retrieval medical follow-up and ongoing consultation'],note:'Confirm monitoring location, first-year fee scope, storage renewals and future use. The service page does not give a matching USD price; its scope is not the inclusion list for this website’s base budget.',source:'Read the provider’s preservation overview'},
 ja:{title:'施設が公開している卵子凍結のサービス工程',intro:'施設の生殖能力温存ページには、次の工程が紹介されています。個別計画の確認に活用してください。',items:['健康評価、ビデオ相談、個別計画','超音波・ホルモン測定と卵巣刺激薬の手配','1回の採卵と麻酔','卵子のガラス化凍結と保存の手配','採卵後の診療フォローと継続相談'],note:'検査場所、初年度の費用範囲、保存更新、将来の使用を確認しましょう。施設のページに対応する米ドル料金はなく、当サイトの基本予算の包含項目を示すものではありません。',source:'施設の生殖能力温存の紹介を見る'},
 ko:{title:'기관이 공개한 난자 동결 서비스 단계',intro:'기관의 가임력 보존 페이지는 다음 단계를 소개합니다. 개인 계획을 확인할 때 참고하세요.',items:['건강 평가, 화상 상담과 개인별 계획','초음파·호르몬 모니터링과 난소 자극 약물','한 번의 난자 채취와 마취','난자 유리화 동결과 보관 준비','채취 후 의료 추적 관리와 지속 상담'],note:'모니터링 장소, 첫해 비용 범위, 보관 갱신과 향후 사용을 확인하세요. 기관 페이지에는 대응하는 달러 요금이 없으며 이 사이트의 기본 예산 포함 항목을 뜻하지 않습니다.',source:'기관의 가임력 보존 안내 보기'}
};
const c=copy[locale];
---
<section class="provider-scope" id="provider-preservation"><h2>{c.title}</h2><p>{c.intro}</p><ul>{c.items.map(item=><li>{item}</li>)}</ul><p class="scope-note">{c.note}</p><a class="inline-link" href="https://www.saipan-ivf.com/FertilityPreservation/" target="_blank" rel="noopener">{c.source}</a></section>
<style>.provider-scope{margin:35px 0;padding:28px;border:1px solid #bfd1e2;scroll-margin-top:24px}.provider-scope h2{font-size:clamp(25px,2.3vw,32px);line-height:1.5;margin:0 0 18px}.provider-scope p,.provider-scope li{font-size:16px;line-height:1.85}.provider-scope ul{padding-left:22px;margin:18px 0}.provider-scope li{margin-bottom:8px}.provider-scope .scope-note{font-size:14px;color:var(--muted)}@media(max-width:650px){.provider-scope{padding:22px}}</style>
