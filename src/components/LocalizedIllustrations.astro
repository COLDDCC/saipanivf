---
import ResponsiveImage from './ResponsiveImage.astro';
import { dictionaries,pageHref } from '../i18n';
const {locale,page}=Astro.props;const d=dictionaries[locale],href=(key)=>pageHref(locale,key);
const fees=[{image:'fees-planning',title:d.budget.consult,text:d.pages['guides/first-visit'].description,price:'$250',href:'contact'},{image:'fees-laboratory',title:d.treatments[0].title,text:d.treatments[0].summary,price:'$15,000',href:'treatments/ivf'},{image:'fees-preservation',title:d.treatments[2].title,text:d.treatments[2].summary,price:'$9,000',href:'treatments/egg-freezing'}];
const services=[{image:'stethoscope-blue',title:d.treatments[1].title,text:d.treatments[1].summary,href:'treatments/icsi'},{image:'baby-socks',title:d.form.unknown,text:d.pages.treatments.sections[0][1],href:'contact'},{image:'family-sunlight',title:d.pages.treatments.sections[2][0],text:d.pages.treatments.sections[2][1],href:'guides/family-planning'},{image:'leaves-backlit',title:d.treatments[2].title,text:d.treatments[2].summary,href:'treatments/egg-freezing'},{image:'stethoscope-silver',title:d.pages.treatments.sections[1][0],text:d.pages.treatments.sections[1][1],href:'guides/family-planning'}];
---
{page==='fees'&&<section class="price-cards">{fees.map(item=><article><figure class="price-illustration"><ResponsiveImage src={'/images/stock/'+item.image+'.webp'} alt={item.title} width="1000" height="650" loading="lazy"/><figcaption>{d.budgetNote}</figcaption></figure><div class="plan-copy"><h3>{item.title}</h3><div class="price">{item.price}</div><p>{item.text}</p><a class="inline-link" href={href(item.href)}>{d.details}</a></div></article>)}</section>}
{page==='treatments'&&<div class="service-grid">{services.map(item=><article class="service"><ResponsiveImage src={'/images/stock/'+item.image+'.webp'} alt={item.title} width="1000" height="650" loading="lazy"/><div class="body"><h3>{item.title}</h3><p>{item.text}</p><a href={href(item.href)}>{d.read}</a></div></article>)}</div>}
{page==='process'&&<div class="gallery">{['wing-new','travel-new'].map((image,i)=><figure><ResponsiveImage src={'/images/stock/'+image+'.webp'} alt={d.pages.process.sections[7][0]} width="1000" height="650" loading="lazy"/><figcaption>{d.pages.process.sections[i===0?7:3][0]}</figcaption></figure>)}</div>}
{page==='birth-planning'&&<figure class="family-photo"><ResponsiveImage src="/images/stock/family-sandals.webp" alt={d.pages['birth-planning'].title} width="1100" height="600" loading="lazy"/></figure>}
<style>.price-cards{display:flex;flex-direction:column;gap:55px;margin:40px 0 70px}.price-cards article{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:7%;align-items:center}.price-cards article:nth-child(2){grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr)}.price-cards article:nth-child(2) .price-illustration{grid-column:2;grid-row:1}.price-cards article:nth-child(2) .plan-copy{grid-column:1;grid-row:1}.price-illustration{margin:0;min-width:0}.price-illustration img{width:100%;height:280px;object-fit:cover}.price-illustration figcaption{margin-top:14px}.plan-copy h3{font-size:30px}.price{font-size:44px;line-height:1.2}.family-photo{margin:40px 0;max-width:calc(1060px - 2 * var(--gutter))}.family-photo img{width:100%;height:auto;object-fit:cover}@media(max-width:750px){.price-cards article,.price-cards article:nth-child(2){grid-template-columns:1fr;gap:25px}.price-cards article:nth-child(2) .price-illustration,.price-cards article:nth-child(2) .plan-copy{grid-column:auto;grid-row:auto}.price-illustration img{height:250px}}@media(max-width:450px){.price-illustration img{height:220px}}</style>
