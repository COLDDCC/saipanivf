---
const {rows,columns,caption,label}=Astro.props;
const hasNotes=columns.length>2;
---
<div class="budget-items" data-budget-items>
 <div class="table-scroll" tabindex="0" role="region" aria-label={label}>
  <table><caption>{caption}</caption><thead><tr>{columns.map(column=><th scope="col">{column}</th>)}</tr></thead><tbody>{rows.map(row=><tr><th scope="row">{row.label}</th><td>{row.amount}</td>{hasNotes&&<td>{row.note}</td>}</tr>)}</tbody></table>
 </div>
 <div class="budget-items-mobile"><p class="caption">{caption}</p><dl>{rows.map(row=><div><dt>{row.label}</dt><dd><strong>{row.amount}</strong>{row.note&&<p>{row.note}</p>}</dd></div>)}</dl></div>
</div>
<style>
.table-scroll{overflow-x:auto;margin-top:20px}.table-scroll:focus-visible{outline:3px solid var(--blue);outline-offset:4px}table{width:100%;min-width:420px;border-collapse:collapse;font-variant-numeric:tabular-nums}caption{text-align:left;font-size:14px;line-height:1.8;margin-bottom:15px}td,th{padding:16px 12px;text-align:left;vertical-align:top;border-bottom:1px solid #c7d8d9;line-height:1.8;font-size:15px}td:nth-child(2){white-space:nowrap}.budget-items-mobile{display:none}
@media(max-width:600px){.table-scroll{display:none}.budget-items-mobile{display:block}.caption{margin:18px 0;font-size:14px;line-height:1.8}.budget-items-mobile dl{margin:0}.budget-items-mobile dl>div{padding:18px 0;min-width:0}.budget-items-mobile dl>div+div{margin-top:4px}.budget-items-mobile dt{font-size:16px;font-weight:500;line-height:1.6;overflow-wrap:anywhere}.budget-items-mobile dd{margin:8px 0 0;min-width:0}.budget-items-mobile strong{display:block;font-weight:500;font-size:20px;line-height:1.6;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}.budget-items-mobile dd p{margin:8px 0 0;font-size:15px;line-height:1.8;overflow-wrap:anywhere}}
</style>
