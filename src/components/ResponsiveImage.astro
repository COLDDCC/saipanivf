---
import variants from '../data/image-variants.json';
const {src,deferSource=false,sizes='(max-width: 650px) 100vw, (max-width: 1000px) 60vw, 50vw',...attrs}=Astro.props;
const srcset=(variants as Record<string,string>)[src];
---
<img {...attrs} src={deferSource?undefined:src} srcset={deferSource?undefined:srcset} data-src={deferSource?src:undefined} data-srcset={deferSource?srcset:undefined} sizes={srcset?sizes:undefined}/>
