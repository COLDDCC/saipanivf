---
interface Slide {
  tag: string;
  title: string;
  accent: string;
  subtitle: string;
  text: string;
  primary: string;
  primaryHref: string;
  secondary: string;
  secondaryHref: string;
  image: string;
}
interface Props {
  slides: readonly Slide[];
  labels: readonly string[];
  aria: string;
  previous: string;
  next: string;
  pause: string;
  play: string;
}
const { slides, labels, aria, previous, next, pause, play } = Astro.props;
---
<div class="hero-carousel" role="region" aria-roledescription="carousel" aria-label={aria} data-hero-carousel data-pause-label={pause} data-play-label={play}>
  <div class="hero-slides">
    {slides.map((slide, index) => {
      const Heading = index === 0 ? 'h1' : 'h2';
      return <article class:list={['hero-slide', { 'is-active': index === 0 }]} aria-roledescription="slide" aria-label={`${index + 1} / ${slides.length}: ${slide.subtitle}`} aria-hidden={index !== 0} inert={index !== 0} data-slide>
        <img class="hero-slide-image" src={`https://raw.githubusercontent.com/jiusongvip/saipan/main/public/images/${slide.image}`} alt="" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
        <div class="hero-shade"></div>
        <div class="hero-copy">
          <div class="hero-kicker">{slide.tag}</div>
          <Heading class="hero-title">{slide.title}<br /><em>{slide.accent}</em><span>{slide.subtitle}</span></Heading>
          <p>{slide.text}</p>
          <div class="slide-actions"><a class="button light" href={slide.primaryHref}>{slide.primary}</a><a class="slide-secondary" href={slide.secondaryHref}>{slide.secondary} ↗</a></div>
        </div>
      </article>;
    })}
  </div>
  <div class="hero-controls">
    <div class="hero-tabs" role="group" aria-label={aria}>{slides.map((slide, index) => <button type="button" class:list={['hero-tab', { 'is-active': index === 0 }]} aria-label={`${index + 1}: ${slide.subtitle}`} aria-pressed={index === 0} data-slide-to={index}><span class="hero-tab-number">0{index + 1}</span><span class="hero-tab-label">{labels[index]}</span></button>)}</div>
    <div class="hero-playback"><button type="button" data-hero-prev aria-label={previous}>←</button><button type="button" data-hero-next aria-label={next}>→</button><button type="button" data-hero-pause aria-label={pause}>Ⅱ</button></div>
  </div>
</div>
<script>
const roots = document.querySelectorAll<HTMLElement>('[data-hero-carousel]');
roots.forEach(root => {
  const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
  const pauseButton = root.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
  const pauseLabel = root.dataset.pauseLabel!;
  const playLabel = root.dataset.playLabel!;
  let current = 0;
  let manuallyPaused = false;
  let timer: ReturnType<typeof setInterval> | undefined;
  const show = (index: number) => {
    current = (index + slides.length) % slides.length;
    slides.forEach((slide, itemIndex) => {
      const active = itemIndex === current;
      slide.classList.toggle('is-active', active);
      slide.setAttribute('aria-hidden', String(!active));
      slide.inert = !active;
    });
    tabs.forEach((tab, itemIndex) => {
      tab.classList.toggle('is-active', itemIndex === current);
      tab.setAttribute('aria-pressed', String(itemIndex === current));
    });
  };
  const schedule = () => {
    if (timer) clearInterval(timer);
    timer = undefined;
    pauseButton.textContent = manuallyPaused ? '▶' : 'Ⅱ';
    pauseButton.setAttribute('aria-label', manuallyPaused ? playLabel : pauseLabel);
    if (!manuallyPaused && !root.contains(document.activeElement) && !document.hidden) timer = setInterval(() => show(current + 1), 6000);
  };
  tabs.forEach((tab, index) => tab.addEventListener('click', () => { show(index); schedule(); }));
  root.querySelector('[data-hero-prev]')!.addEventListener('click', () => { show(current - 1); schedule(); });
  root.querySelector('[data-hero-next]')!.addEventListener('click', () => { show(current + 1); schedule(); });
  pauseButton.addEventListener('click', () => { manuallyPaused = !manuallyPaused; schedule(); });
  root.addEventListener('focusin', schedule);
  root.addEventListener('focusout', () => queueMicrotask(schedule));
  root.addEventListener('keydown', event => {
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
      event.preventDefault();
      show(current + (event.key === 'ArrowRight' ? 1 : -1));
      schedule();
    }
  });
  document.addEventListener('visibilitychange', schedule);
  schedule();
});
</script>
<style>
.hero-carousel{position:relative;z-index:1;flex:1;display:flex;flex-direction:column;min-height:0}.hero-slides{position:relative;display:grid;flex:1}.hero-slide{isolation:isolate;grid-area:1/1;position:relative;min-width:0;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .65s ease,visibility .65s}.hero-slide.is-active{opacity:1;visibility:visible;pointer-events:auto}.hero-slide-image{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 55%;z-index:-2}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,39,53,.92),rgba(8,47,62,.58) 62%,rgba(8,47,62,.18));z-index:-1}.hero-copy{position:relative;padding:clamp(40px,7vh,88px) 7% 48px;max-width:1120px;color:#fff}.hero-kicker{font-size:11px;font-weight:700;letter-spacing:2.5px;color:#bfe2e9}.hero-title{font:500 clamp(43px,5.5vw,78px)/1.12 var(--display);letter-spacing:-1px;margin:23px 0 18px}.hero-title em{font-style:normal;color:#c5eaf0}.hero-title span{display:block;font:500 clamp(18px,1.9vw,28px)/1.5 var(--sans);letter-spacing:.2px;margin-top:18px}.hero-copy p{max-width:660px;color:#e9f4f6;font-size:15px;line-height:1.85;margin:16px 0 24px}.slide-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap}.slide-secondary{font-size:13px;color:white;text-decoration:underline;text-underline-offset:6px}.hero-controls{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:15px 7% 18px;background:#0d3444;color:#fff}.hero-tabs{display:flex;gap:22px;flex-wrap:wrap}.hero-tab{display:flex;align-items:center;gap:9px;padding:9px 0;border:0;border-top:2px solid #ffffff38;background:none;color:#a9c4cd;cursor:pointer;min-height:44px}.hero-tab.is-active{color:white;border-top-color:#bfeaf2}.hero-tab-number{font-size:11px;letter-spacing:1px}.hero-tab-label{font-size:12px}.hero-playback{display:flex;gap:8px}.hero-playback button{min-width:44px;min-height:44px;padding:8px 12px;background:none;border:1px solid #ffffff5e;color:white;cursor:pointer}.hero-tab:focus-visible,.hero-playback button:focus-visible,.slide-actions a:focus-visible{outline:3px solid #b5e5ed;outline-offset:4px}@media(max-width:800px){.hero-copy{padding:40px 6% 30px}.hero-title{font-size:clamp(38px,8vw,58px)}.hero-copy p{font-size:13px}.hero-controls{padding:13px 6%;flex-wrap:wrap}.hero-tabs{gap:16px}.hero-tab-label{font-size:11px}}@media(max-width:480px){.hero-title{font-size:36px}.hero-title span{font-size:19px}.hero-tabs{display:grid;grid-template-columns:repeat(2,1fr);gap:7px 18px;width:100%}.hero-playback{margin-left:auto}}@media(prefers-reduced-motion:reduce){.hero-slide{transition:none}}
</style>
