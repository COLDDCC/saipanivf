---
import { homeDecisions } from '../i18n/home-decisions';
import ResponsiveImage from "./ResponsiveImage.astro";
const defaultSlides = [
{title:'塞班试管婴儿',accent:'了解方案、费用与流程',subtitle:'IVF · ICSI · 胚胎移植',text:'从初诊评估到治疗安排，按阶段了解检查资料、预算构成与就诊时间。',image:'/images/saipan-lagoon-aerial.webp',primary:'提交初步咨询表单',href:'/contact/',secondary:'查看费用预算',secondaryHref:'/fees/'},
{title:'冻卵与冻精',accent:'了解生育力保存',subtitle:'初诊评估 · 冷冻 · 保存',text:'分别确认治疗周期、冷冻操作、年度保存和未来使用的安排。',image:'/images/stock/leaves-soft.webp',primary:'了解治疗项目',href:'/treatments/',secondary:'阅读冻卵指南',secondaryHref:'/guides/egg-freezing/'},
{title:'认识医疗团队',accent:'就诊前了解接诊方',subtitle:'医生 · 胚胎实验室 · 护理',text:'查看院方公开介绍，预约前确认主诊医生、具体医疗地点与服务范围。',image:'/images/stock/ultrasound-scanner.webp',primary:'认识团队',href:'/team/',secondary:'了解中心',secondaryHref:'/about/'},
{title:'IVF就诊安排',accent:'按治疗日程准备',subtitle:'资料 · 预约 · 治疗 · 随访',text:'先整理已有报告，取得个人日程后，再安排交通、住宿与陪同。',image:'/images/stock/wing-sky.webp',primary:'查看IVF流程',href:'/process/',secondary:'阅读就诊指南',secondaryHref:'/guides/'}
];
const {locale='zh-CN'}=Astro.props;const decision=homeDecisions[locale];const prefix=locale==='zh-CN'?'':'/'+locale;
const slides=Astro.props.slides||defaultSlides;
const labels=Astro.props.labels||{region:"塞班辅助生殖服务",carousel:"轮播",slide:"幻灯片",tabs:"切换首屏内容",show:"显示",prev:"上一张",next:"下一张",pause:"暂停自动切换",resume:"继续自动切换",names:["试管婴儿","生育力保存","医疗团队","IVF流程"]};
---
<div class="hero-carousel" role="region" aria-roledescription={labels.carousel} aria-label={labels.region} data-pause-label={labels.pause} data-resume-label={labels.resume} data-hero-carousel>
 <div class="hero-slides">
 {slides.map((slide,index)=>{const Heading=index===0?'h1':'h2';return <article class:list={['hero-slide',{'is-active':index===0}]} aria-roledescription={labels.slide} aria-label={`${index+1} / ${slides.length}：${slide.subtitle}`} aria-hidden={index!==0} inert={index!==0} data-slide>
 <ResponsiveImage class="hero-slide-image" src={slide.image} deferSource={index!==0} sizes="(max-width: 650px) 100vw, (max-width: 1000px) 45vw, 55vw" alt="" width={index===0?640:1000} height={index===0?358:650} loading="eager" fetchpriority={index===0?'high':'low'} decoding="async"/>
 <div class="hero-shade"></div>
 <div class="hero-copy"><Heading class="hero-title">{slide.title}</Heading><p class="hero-statement">{slide.accent}</p><p class="hero-description">{slide.text}</p><div class="slide-actions"><a class="button light" href={slide.href}>{slide.primary}</a><a class="slide-secondary" href={slide.secondaryHref}>{slide.secondary}</a></div></div>
 </article>})}
 </div>
 <nav class="hero-essential" aria-label={decision[0]}><a href={prefix+'/fees/'}>{decision[1]}</a><a href={prefix+'/contact/'}>{decision[10]} ↗</a></nav>
 <div class="hero-controls">
 <div class="hero-tabs" role="group" aria-label={labels.tabs}>{slides.map((slide,index)=><button type="button" class:list={['hero-tab',{'is-active':index===0}]} aria-label={`${labels.show} ${index+1}: ${slide.subtitle}`} aria-pressed={index===0} data-slide-to={index}><span class="hero-tab-label">{labels.names[index]}</span></button>)}</div>
 <div class="hero-playback"><button type="button" data-hero-prev aria-label={labels.prev}>←</button><button type="button" data-hero-next aria-label={labels.next}>→</button><button type="button" data-hero-pause aria-label={labels.pause}><span aria-hidden="true">Ⅱ</span></button></div>
 </div>
</div>
<script>
const root=document.querySelector<HTMLElement>('[data-hero-carousel]');
if(root){
 const slides=Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
 const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
 const pause=root.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
 let request=0;
 const imageLoads=new Map<number,Promise<boolean>>();
 function loadSlide(index:number):Promise<boolean>{
  if(imageLoads.has(index))return imageLoads.get(index)!;
  const image=slides[index].querySelector<HTMLImageElement>('img')!;
  const loading=new Promise<boolean>(resolve=>{
   const ready=()=>{if(image.decode)image.decode().then(()=>resolve(true),()=>resolve(image.naturalWidth>0));else resolve(true);};
   image.addEventListener('load',ready,{once:true});
   image.addEventListener('error',()=>resolve(false),{once:true});
   const source=image.dataset.src;
   if(source){if(image.dataset.srcset)image.srcset=image.dataset.srcset;image.src=source;}
   if(image.complete) {if(image.naturalWidth>0)ready();else if(!source)resolve(false);}
  });
  imageLoads.set(index,loading);return loading;
 }
 let current=0,manualPause=false,timer:ReturnType<typeof setInterval>|undefined;
 function schedule(){
  if(timer)clearInterval(timer);
  timer=undefined;
  pause.textContent=manualPause?'▶':'Ⅱ';
  pause.setAttribute('aria-label',manualPause?root!.dataset.resumeLabel!:root!.dataset.pauseLabel!);
  if(!manualPause&&!root!.contains(document.activeElement)&&!document.hidden)timer=setInterval(()=>show(current+1),5000);
 }
 function show(index:number){
  const next=(index+slides.length)%slides.length,ticket=++request;
  loadSlide(next).then(ready=>{
   if(!ready||ticket!==request)return;
   current=next;
   slides.forEach((slide,i)=>{const active=i===current;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',String(!active));slide.inert=!active;});
   tabs.forEach((tab,i)=>{tab.classList.toggle('is-active',i===current);tab.setAttribute('aria-pressed',String(i===current));});
   void loadSlide((current+1)%slides.length);
  });
 }
 tabs.forEach((tab,i)=>tab.addEventListener('click',()=>{show(i);schedule();}));
 root.querySelector('[data-hero-prev]')!.addEventListener('click',()=>{show(current-1);schedule();});
 root.querySelector('[data-hero-next]')!.addEventListener('click',()=>{show(current+1);schedule();});
 pause.addEventListener('click',()=>{manualPause=!manualPause;schedule();});
 root.addEventListener('focusin',schedule);
 root.addEventListener('focusout',()=>queueMicrotask(schedule));
 root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();show(current+(event.key==='ArrowRight'?1:-1));schedule();}});
 document.addEventListener('visibilitychange',schedule);

 // The first image remains discoverable in HTML; warm only the next slide after it is ready.
 // Do not fetch the next slide during the critical first paint.
 // Wait until the browser is idle, with a fallback for browsers without requestIdleCallback.
 // Skip speculative downloads on constrained connections and when the tab is hidden.
 const warmNext=()=>{
  const connection=(navigator as Navigator & {connection?:{saveData?:boolean;effectiveType?:string}}).connection;
  if(document.hidden||connection?.saveData||connection?.effectiveType==='slow-2g'||connection?.effectiveType==='2g')return;
  void loadSlide(1);
 };
 const idleWindow=window as Window & {requestIdleCallback?:(callback:()=>void,options?:{timeout:number})=>number};
 if(idleWindow.requestIdleCallback)idleWindow.requestIdleCallback(warmNext,{timeout:4000});
 else window.addEventListener('load',()=>window.setTimeout(warmNext,1500),{once:true});
 schedule();
}
</script>
<style>
.hero-essential{display:flex;justify-content:flex-end;gap:24px;padding:10px var(--gutter);background:var(--light);font-size:14px}.hero-essential a{text-decoration:underline;text-underline-offset:4px;min-height:32px;display:flex;align-items:center}.hero-carousel{position:relative;display:flex;flex-direction:column;background:#f1f6f5;color:#123d4a}.hero-slides{display:grid;position:relative;min-width:0}.hero-slide{grid-area:1/1;position:relative;display:grid;grid-template-columns:minmax(0,45%) minmax(0,55%);height:clamp(350px,calc(100svh - 240px),500px);min-height:0;min-width:0;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .7s,visibility .7s}.hero-slide.is-active{opacity:1;visibility:visible;pointer-events:auto}.hero-slide-image{position:absolute;top:0;right:0;width:55%;height:100%;min-height:0;max-height:100%;object-fit:cover;object-position:center}.hero-shade{display:none}.hero-copy{grid-column:1;grid-row:1;padding:32px 9% 32px 12%;align-self:center;position:relative;z-index:1;min-width:0}.hero-title{font-size:clamp(34px,3.8vw,58px);line-height:1.2;letter-spacing:-.04em;font-weight:500;margin:0 0 18px;text-wrap:balance}.hero-statement{font-size:clamp(20px,1.9vw,27px);font-weight:500;line-height:1.5;margin:0 0 15px}.hero-description{font-size:16px;line-height:1.8;max-width:28em;margin:0 0 24px}.slide-actions{display:flex;gap:18px;align-items:center;flex-wrap:wrap}.slide-actions .button{background:#174e5b;color:white;padding:14px 19px;font-size:15px;min-height:48px;display:inline-flex;align-items:center;transition:transform .2s}.slide-secondary{font-size:14px;text-decoration:underline;text-underline-offset:7px}.hero-controls{display:flex;align-items:center;justify-content:space-between;padding:10px 5.4%;background:#dcecee;gap:16px;min-height:64px}.hero-tabs{display:flex;gap:28px;flex-wrap:wrap}.hero-tab{border:0;background:transparent;padding:8px 0;font:inherit;color:#4d6972;cursor:pointer;font-size:14px;min-height:44px}.hero-tab.is-active{color:#123d4a;font-weight:700;text-decoration:underline;text-underline-offset:7px}.hero-playback{display:flex;gap:8px}.hero-playback button{border:0;background:#f3f8f7;min-width:44px;min-height:44px;font:inherit;color:#123d4a;cursor:pointer}.hero-carousel :is(a,button):focus-visible{outline:3px solid #387c8b;outline-offset:4px}.slide-actions .button:hover{transform:translateY(-2px)}
@media(min-width:651px) and (max-width:1000px){.hero-slide{grid-template-columns:minmax(0,55%) minmax(0,45%);height:clamp(420px,calc(100svh - 220px),460px)}.hero-slide-image{width:45%}.hero-copy{padding:28px 8% 28px 11%}.hero-title{font-size:38px}.hero-statement{font-size:21px}.hero-description{font-size:15px}.hero-tabs{gap:20px}}
@media(max-width:650px){.hero-slide{grid-template-columns:minmax(0,1fr);height:auto;min-height:0;padding-bottom:clamp(150px,24svh,190px)}.hero-copy{grid-column:1;grid-row:1;padding:25px 6% 24px}.hero-slide-image{top:auto;bottom:0;width:100%;height:clamp(150px,24svh,190px);min-height:0;object-position:center 45%}.hero-title{font-size:34px;margin:0 0 10px}.hero-statement{font-size:20px;margin:0 0 10px}.hero-description{font-size:15px;line-height:1.7;margin-bottom:18px}.hero-controls{padding:8px 6%;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px}.hero-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 12px}.hero-tab{font-size:13px;text-align:left;min-height:36px}.hero-playback{gap:5px}.hero-playback button{min-width:36px;min-height:44px;padding:8px}.slide-actions{gap:16px}.slide-actions .button{padding:12px 16px;font-size:14px;min-height:44px}.slide-secondary{font-size:14px}}
@media(prefers-reduced-motion:reduce){.hero-slide,.slide-actions .button{transition:none}}
</style>