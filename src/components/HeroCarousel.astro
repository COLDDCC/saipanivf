---
const slides = [
{title:'塞班试管婴儿',accent:'了解方案、费用与流程',subtitle:'IVF · ICSI · 胚胎移植',text:'从初诊评估到治疗安排，按阶段了解检查资料、预算构成与就诊时间。',image:'saipan-lagoon-aerial.jpg',primary:'提交初步咨询表单',href:'/contact/',secondary:'查看费用预算',secondaryHref:'/fees/'},
{title:'冻卵与冻精',accent:'了解生育力保存',subtitle:'初诊评估 · 冷冻 · 保存',text:'分别确认治疗周期、冷冻操作、年度保存和未来使用的安排。',image:'couple-editorial.jpg',primary:'了解治疗项目',href:'/treatments/',secondary:'阅读冻卵指南',secondaryHref:'/guides/egg-freezing/'},
{title:'认识医疗团队',accent:'就诊前了解接诊方',subtitle:'医生 · 胚胎实验室 · 护理',text:'查看院方公开介绍，预约前确认主诊医生、具体医疗地点与服务范围。',image:'american-flag.jpg',primary:'认识团队',href:'/team/',secondary:'了解中心',secondaryHref:'/about/'},
{title:'IVF就诊安排',accent:'按治疗日程准备',subtitle:'资料 · 预约 · 治疗 · 随访',text:'先整理已有报告，取得个人日程后，再安排交通、住宿与陪同。',image:'flight-wing.jpg',primary:'查看IVF流程',href:'/process/',secondary:'阅读就诊指南',secondaryHref:'/guides/'}
];
---
<div class="hero-carousel" role="region" aria-roledescription="轮播" aria-label="塞班辅助生殖服务" data-hero-carousel>
 <div class="hero-slides">
 {slides.map((slide,index)=>{const Heading=index===0?'h1':'h2';return <article class:list={['hero-slide',{'is-active':index===0}]} aria-roledescription="幻灯片" aria-label={`${index+1} / ${slides.length}：${slide.subtitle}`} aria-hidden={index!==0} inert={index!==0} data-slide>
 <img class="hero-slide-image" src={`https://raw.githubusercontent.com/jiusongvip/saipan/main/public/images/${slide.image}`} alt="" loading="eager" fetchpriority={index===0?'high':'auto'} decoding="async"/>
 <div class="hero-shade"></div>
 <div class="hero-copy"><Heading class="hero-title">{slide.title}</Heading><p class="hero-statement">{slide.accent}</p><p class="hero-description">{slide.text}</p><div class="slide-actions"><a class="button light" href={slide.href}>{slide.primary}</a><a class="slide-secondary" href={slide.secondaryHref}>{slide.secondary}</a></div></div>
 </article>})}
 </div>
 <div class="hero-controls">
 <div class="hero-tabs" role="group" aria-label="切换首屏内容">{slides.map((slide,index)=><button type="button" class:list={['hero-tab',{'is-active':index===0}]} aria-label={`显示第${index+1}张：${slide.subtitle}`} aria-pressed={index===0} data-slide-to={index}><span class="hero-tab-label">{['试管婴儿','生育力保存','医疗团队','IVF流程'][index]}</span></button>)}</div>
 <div class="hero-playback"><button type="button" data-hero-prev aria-label="上一张">←</button><button type="button" data-hero-next aria-label="下一张">→</button><button type="button" data-hero-pause aria-label="暂停自动切换"><span aria-hidden="true">Ⅱ</span></button></div>
 </div>
</div>
<script>
const root=document.querySelector<HTMLElement>('[data-hero-carousel]');
if(root){
 const slides=Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
 const tabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-slide-to]'));
 const pause=root.querySelector<HTMLButtonElement>('[data-hero-pause]')!;
 let current=0,manualPause=false,timer:ReturnType<typeof setInterval>|undefined;
 function schedule(){
  if(timer)clearInterval(timer);
  timer=undefined;
  pause.textContent=manualPause?'▶':'Ⅱ';
  pause.setAttribute('aria-label',manualPause?'继续自动切换':'暂停自动切换');
  if(!manualPause&&!root!.contains(document.activeElement)&&!document.hidden)timer=setInterval(()=>show(current+1),5000);
 }
 function show(index:number){
  current=(index+slides.length)%slides.length;
  slides.forEach((slide,i)=>{const active=i===current;slide.classList.toggle('is-active',active);slide.setAttribute('aria-hidden',String(!active));slide.inert=!active;});
  tabs.forEach((tab,i)=>{tab.classList.toggle('is-active',i===current);tab.setAttribute('aria-pressed',String(i===current));});
 }
 tabs.forEach((tab,i)=>tab.addEventListener('click',()=>{show(i);schedule();}));
 root.querySelector('[data-hero-prev]')!.addEventListener('click',()=>{show(current-1);schedule();});
 root.querySelector('[data-hero-next]')!.addEventListener('click',()=>{show(current+1);schedule();});
 pause.addEventListener('click',()=>{manualPause=!manualPause;schedule();});
 root.addEventListener('focusin',schedule);
 root.addEventListener('focusout',()=>queueMicrotask(schedule));
 root.addEventListener('keydown',event=>{if(event.key==='ArrowRight'||event.key==='ArrowLeft'){event.preventDefault();show(current+(event.key==='ArrowRight'?1:-1));schedule();}});
 document.addEventListener('visibilitychange',schedule);

 schedule();
}
</script>
<style>
.hero-carousel{position:relative;display:flex;flex-direction:column;background:#f1f6f5;color:#123d4a}.hero-slides{display:grid;position:relative}.hero-slide{grid-area:1/1;display:grid;grid-template-columns:45% 55%;min-height:570px;opacity:0;visibility:hidden;pointer-events:none;transition:opacity .7s,visibility .7s}.hero-slide.is-active{opacity:1;visibility:visible;pointer-events:auto}.hero-slide-image{grid-column:2;grid-row:1;width:100%;height:100%;min-height:570px;object-fit:cover;object-position:center}.hero-shade{display:none}.hero-copy{grid-column:1;grid-row:1;padding:70px 10% 70px 12%;align-self:center;position:relative;z-index:1}.hero-title{font-size:clamp(38px,4.3vw,68px);line-height:1.18;letter-spacing:-.04em;font-weight:500;margin:0 0 25px;text-wrap:balance}.hero-statement{font-size:clamp(22px,2.1vw,30px);font-weight:500;line-height:1.6;margin:0 0 20px}.hero-description{font-size:17px;line-height:1.85;max-width:28em;margin:0 0 32px}.slide-actions{display:flex;gap:24px;align-items:center;flex-wrap:wrap}.slide-actions .button{background:#174e5b;color:white;padding:16px 22px;font-size:15px;min-height:52px;display:inline-flex;align-items:center;transition:transform .2s}.slide-secondary{font-size:15px;text-decoration:underline;text-underline-offset:7px}.hero-controls{display:flex;align-items:center;justify-content:space-between;padding:22px 5.4%;background:#dcecee;gap:20px}.hero-tabs{display:flex;gap:32px;flex-wrap:wrap}.hero-tab{border:0;background:transparent;padding:8px 0;font:inherit;color:#4d6972;cursor:pointer;font-size:15px;min-height:44px}.hero-tab.is-active{color:#123d4a;font-weight:700;text-decoration:underline;text-underline-offset:8px}.hero-playback{display:flex;gap:8px}.hero-playback button{border:0;background:#f3f8f7;min-width:44px;min-height:44px;font:inherit;color:#123d4a;cursor:pointer}.hero-carousel :is(a,button):focus-visible{outline:3px solid #387c8b;outline-offset:5px}.slide-actions .button:hover{transform:translateY(-3px)}
@media(max-width:1000px){.hero-slide{grid-template-columns:48% 52%;min-height:510px}.hero-slide-image{min-height:510px}.hero-copy{padding:50px 8% 50px 11%}.hero-title{font-size:42px}.hero-statement{font-size:23px}.hero-description{font-size:16px}.hero-tabs{gap:20px}}
@media(max-width:650px){.hero-slide{grid-template-columns:1fr;grid-template-rows:auto 255px;min-height:0}.hero-copy{grid-column:1;grid-row:1;padding:32px 6%}.hero-slide-image{grid-column:1;grid-row:2;min-height:0;height:255px;object-position:center 45%}.hero-title{font-size:38px;margin:0 0 12px}.hero-statement{font-size:21px;margin:0 0 12px}.hero-description{font-size:15px;line-height:1.8;margin-bottom:22px}.hero-controls{padding:12px 6%;gap:10px;flex-wrap:wrap}.hero-tabs{gap:17px}.hero-tab{font-size:13px}.hero-playback{margin-left:auto}.slide-actions{gap:18px}.slide-actions .button{padding:13px 17px;font-size:14px;min-height:46px}.slide-secondary{font-size:14px}}
@media(prefers-reduced-motion:reduce){.hero-slide,.slide-actions .button{transition:none}}
</style>