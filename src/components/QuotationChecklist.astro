---
import { quotationGuide } from '../data/quotation-guide';
const {locale='zh-CN'}=Astro.props;
const c=quotationGuide[locale];
---
<section class="quote-checklist" aria-labelledby="quote-checklist-title"><h2 id="quote-checklist-title">{c.title}</h2><p>{c.intro}</p><div class="quote-table-scroll" role="region" aria-label={c.title} tabindex="0"><table><caption>{c.title}</caption><thead><tr>{c.headers.map(h=><th scope="col">{h}</th>)}</tr></thead><tbody>{c.rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div><h2>{c.payment}</h2><ol class="quote-payment">{c.checks.map(text=><li>{text}</li>)}</ol><h2>{c.extra}</h2><p>{c.extraText}</p><p class="quote-note">{c.note}</p><aside class="quote-sources"><h3>{c.sources}</h3><p>{c.scope}</p><ul><li><a href="https://www.hfea.gov.uk/treatments/explore-all-treatments/costs-and-funding/" target="_blank" rel="noopener">{c.costSource}</a></li><li><a href="https://www.hfea.gov.uk/treatments/explore-all-treatments/fertility-treatment-abroad/" target="_blank" rel="noopener">{c.travelSource}</a></li></ul><p>{c.checked}：<time datetime="2026-10-21">2026-10-21</time></p></aside></section>
<style>
.quote-checklist{margin-top:44px;max-width:1100px}.quote-checklist h2{font-size:clamp(25px,2.5vw,34px);margin:40px 0 18px}.quote-table-scroll{overflow-x:auto;margin:24px 0 36px}.quote-table-scroll:focus-visible{outline:3px solid var(--blue);outline-offset:4px}table{width:100%;min-width:650px;border-collapse:collapse;text-align:left;font-size:16px;line-height:1.7}caption{text-align:left;font-weight:600;padding-bottom:12px}th,td{padding:18px 20px;vertical-align:top;border-bottom:1px solid #d5e1eb}thead th{background:#1767a6;color:white}tbody th{width:23%;background:#edf5fc;font-weight:600}td{width:38.5%}.quote-payment{padding-left:25px}.quote-payment li{padding:8px 0;line-height:1.9}.quote-note{padding:20px;background:#edf5fc;font-size:15px!important}.quote-sources{margin-top:32px;padding-top:20px;border-top:1px solid #d5e1eb}.quote-sources h3{font-size:20px}.quote-sources p,.quote-sources li{font-size:14px!important;line-height:1.8}.quote-sources a{text-decoration:underline;text-underline-offset:4px}@media(max-width:650px){th,td{padding:14px}table{font-size:15px}.quote-checklist{margin-top:30px}}
</style>
