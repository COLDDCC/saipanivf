---
import { outcomeCopy } from '../i18n/outcomes';
const {locale='zh-CN'}=Astro.props;
const c=outcomeCopy[locale];
const contact=(locale==='zh-CN'?'':'/'+locale)+'/contact/?topic=ivf';
---
<section class="outcome-evidence" id="outcomes" aria-labelledby="outcome-title">
 <header><h2 id="outcome-title">{c.title}</h2><p>{c.intro}</p></header>
 <div class="outcome-table" role="region" aria-label={c.title} tabindex="0"><table><caption class="sr-only">{c.title}</caption><thead><tr>{c.headers.map(label=><th scope="col">{label}</th>)}</tr></thead><tbody>{c.rows.map(row=><tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody></table></div>
 <dl class="outcome-checks">{c.checks.map(([title,text])=><div><dt>{title}</dt><dd>{text}</dd></div>)}</dl>
 <p class="outcome-note">{c.note}</p>
 <footer><a class="inline-link" href={contact}>{c.cta}</a><nav aria-label={c.sources}><a href="https://www.cdc.gov/art/success-rates/interpret.html" target="_blank" rel="noopener">{c.cdc}</a><a href="https://www.sart.org/patients/a-patients-guide-to-assisted-reproductive-technology/general-information/success-rates/" target="_blank" rel="noopener">{c.sart}</a></nav></footer>
</section>
<style>
.outcome-evidence{margin:56px 0;scroll-margin-top:28px;border-top:1px solid #bfd1e2;padding-top:38px}.outcome-evidence header{max-width:58em;margin-bottom:26px}.outcome-evidence h2{font-size:clamp(27px,2.7vw,36px);line-height:1.5;margin:0 0 16px}.outcome-evidence p{line-height:1.9}.outcome-table{overflow-x:auto}.outcome-table table{width:100%;min-width:620px;border-collapse:collapse;table-layout:fixed;font-size:16px;line-height:1.85}.outcome-table th,.outcome-table td{padding:20px 22px;text-align:left;vertical-align:top;border-bottom:1px solid #bfd1e2;overflow-wrap:anywhere}.outcome-table thead{background:var(--deep);color:white}.outcome-table thead th{font-weight:500}.outcome-table th:first-child{width:24%}.outcome-table tbody th{background:var(--light);font-weight:500}.outcome-checks{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;margin:30px 0}.outcome-checks>div{border-top:3px solid var(--blue);padding-top:18px;min-width:0}.outcome-checks dt{font-size:21px;margin-bottom:10px}.outcome-checks dd{margin:0;font-size:16px;line-height:1.9}.outcome-note{font-size:14px;color:var(--muted);max-width:65em}.outcome-evidence footer{display:flex;justify-content:space-between;gap:22px;flex-wrap:wrap;margin-top:24px}.outcome-evidence footer nav{display:flex;gap:15px 24px;flex-wrap:wrap;font-size:14px;line-height:1.9}.outcome-evidence footer nav a{text-decoration:underline;text-underline-offset:5px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.outcome-table:focus-visible{outline:3px solid var(--blue);outline-offset:4px}@media(max-width:750px){.outcome-checks{grid-template-columns:1fr;gap:22px}.outcome-table th,.outcome-table td{padding:16px}.outcome-evidence{margin:40px 0;padding-top:28px}.outcome-evidence footer{display:grid}.outcome-evidence footer nav{display:grid;gap:12px}}
</style>
