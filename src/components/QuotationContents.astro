---
import { quotationGuide } from '../data/quotation-guide';
const {locale='zh-CN'}=Astro.props;
const c=quotationGuide[locale];
const labels={
 es:['En esta página','Conceptos incluidos y adicionales'],
 'zh-CN':['本页快速查看','包含与另计项目'],
 en:['On this page','Included and additional items'],
 ja:['このページの目次','含まれる項目と追加費用'],
 ko:['이 페이지 목차','포함 항목과 추가 비용']
}[locale];
const links=[
 [locale==='zh-CN'?'quote-scope':'section-1',labels[1]],
 ['quote-checklist-title',c.title],
 ['quote-payment-title',c.payment],
 ['quote-extra-title',c.extra],
 ['quote-sources-title',c.sources]
];
---
<nav class="quotation-contents" aria-labelledby="quotation-contents-label"><p id="quotation-contents-label">{labels[0]}</p><ul>{links.map(([id,label])=><li><a href={'#'+id}>{label}<span aria-hidden="true">↓</span></a></li>)}</ul></nav>
<style>
.quotation-contents{margin:0 0 38px;padding:24px 28px;background:#edf5fc;border-left:3px solid #1767a6;max-width:1100px}.quotation-contents p{font-size:17px!important;font-weight:600;margin:0 0 12px}.quotation-contents ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 32px;list-style:none;padding:0;margin:0}.quotation-contents li{margin:0;padding:0;min-width:0}.quotation-contents a{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:9px 0;min-height:44px;color:var(--blue);font-size:15px;line-height:1.6;text-decoration:underline;text-underline-offset:4px}.quotation-contents a:hover{color:var(--ink)}.quotation-contents a:focus-visible{outline:3px solid #1767a6;outline-offset:3px}.quotation-contents span{flex-shrink:0;text-decoration:none}@media(max-width:650px){.quotation-contents{padding:20px;margin-bottom:30px}.quotation-contents ul{grid-template-columns:1fr;gap:2px}.quotation-contents a{font-size:15px}}
</style>
