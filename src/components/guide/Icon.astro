---
// Inline Health Icon (CC0) that inherits the surrounding text color.
// Add icons with: python3 scripts/visuals/icon.py outline/devices/microscope
const icons = import.meta.glob('../../assets/icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
interface Props { name: string; size?: number; class?: string }
const { name, size = 28, class: cls } = Astro.props;
const svg = icons[`../../assets/icons/${name}.svg`];
if (!svg) throw new Error(`Icon not found: ${name}. Run scripts/visuals/icon.py`);
---
<span class:list={['g-icon', cls]} style={`width:${size}px;height:${size}px`} set:html={svg} />
<style>.g-icon{display:inline-flex;flex:none}.g-icon :global(svg){width:100%;height:100%}</style>
