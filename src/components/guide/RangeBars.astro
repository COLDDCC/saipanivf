---
// Horizontal bar / range chart in pure HTML+CSS. Values are always printed as text,
// so the chart never relies on color or bar length alone. Use for budgets, counts, rates.
interface Item { label: string; min: number; max?: number; note?: string; emphasis?: boolean }
interface Props { title: string; items: Item[]; unit?: string; prefix?: string; scaleMax?: number; caption?: string }
const { title, items, unit = '', prefix = '', scaleMax, caption } = Astro.props;
const top = scaleMax ?? Math.max(...items.map(i => i.max ?? i.min));
const pct = (n: number) => Math.max(0, Math.min(100, n / top * 100));
const fmt = (n: number) => prefix + n.toLocaleString('en-US') + unit;
---
<figure class="g-bars">
 <figcaption class="g-title">{title}</figcaption>
 <ul>
  {items.map(i => {
   const lo = i.max === undefined ? 0 : pct(i.min), hi = pct(i.max ?? i.min);
   return <li class:list={{ em: i.emphasis }}>
    <span class="g-label">{i.label}{i.note && <small>{i.note}</small>}</span>
    <span class="g-track" aria-hidden="true"><span class="g-fill" style={`left:${lo}%;width:${Math.max(hi - lo, 1.5)}%`}></span>{i.max !== undefined && i.min !== i.max && <span class="g-floor" style={`width:${lo}%`}></span>}</span>
    <span class="g-value">{i.max !== undefined && i.max !== i.min ? `${fmt(i.min)}–${fmt(i.max).replace(prefix, '')}` : fmt(i.min)}</span>
   </li>;
  })}
 </ul>
 {caption && <p class="g-caption">{caption}</p>}
</figure>
<style>
.g-bars{margin:20px 0;padding:18px 20px;border:1px solid #dce6ec;border-radius:12px;background:#fff}.g-title{font-weight:700;color:#1f2d36;margin-bottom:12px;font-size:15px}
ul{list-style:none;margin:0;padding:0;display:grid;gap:12px}li{display:grid;grid-template-columns:minmax(120px,26%) 1fr auto;gap:14px;align-items:center;margin:0}
.g-label{font-size:14px;color:#2b3a44;line-height:1.45}.g-label small{display:block;font-size:12px;color:#55697a}
.g-track{position:relative;height:14px;border-radius:7px;background:#eef3f6}.g-fill{position:absolute;top:0;bottom:0;border-radius:7px;background:#7fa8c9}.g-floor{position:absolute;left:0;top:6px;height:2px;background:#cfdbe4}
li.em .g-fill{background:#1767a6}li.em .g-label{font-weight:700;color:#1f2d36}
.g-value{font-size:14px;font-weight:650;color:#1f2d36;white-space:nowrap;font-variant-numeric:tabular-nums}.g-caption{font-size:13px;color:#476478;margin:12px 0 0;line-height:1.6}
@media(max-width:640px){.g-bars{padding:14px}li{grid-template-columns:1fr auto;gap:4px 10px}.g-track{grid-column:1 / -1;grid-row:2}}
</style>
